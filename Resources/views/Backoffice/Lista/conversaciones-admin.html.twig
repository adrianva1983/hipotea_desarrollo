{% extends "@App/Backoffice/base.html.twig" %}

{% block titulo %}Conversaciones WhatsApp - {{ usuarioPropietario.username }}{% endblock %}

{% block customstyles %}
    {{ parent() }}
    <style>
        .chat-container {
            background-color: #e5ddd5;
            border-radius: 4px;
            padding: 15px;
            height: 600px;
            overflow-y: auto;
        }
        .message-wrapper {
            margin-bottom: 12px;
            display: flex;
            animation: slideIn 0.3s ease-in;
        }
        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .message-sent {
            justify-content: flex-end;
        }
        .message-received {
            justify-content: flex-start;
        }
        .message-bubble {
            max-width: 70%;
            padding: 10px 14px;
            border-radius: 8px;
            word-wrap: break-word;
        }
        .message-sent .message-bubble {
            background-color: #dcf8c6;
            border-bottom-right-radius: 0;
        }
        .message-received .message-bubble {
            background-color: #ffffff;
            border-bottom-left-radius: 0;
        }
        .message-meta {
            font-size: 11px;
            color: #999;
            margin-top: 3px;
        }
        .message-role {
            font-weight: bold;
            font-size: 12px;
            color: #075e54;
            margin-bottom: 2px;
        }
        .header-info {
            border-bottom: 2px solid #075e54;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }
        .badge-custom {
            background-color: #075e54;
            color: white;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            margin-right: 5px;
        }
        .no-messages {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            background-color: #e5ddd5;
            color: #999;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="header-info">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h1>
                    <i class="fas fa-comments"></i> Conversaciones WhatsApp
                </h1>
                <p class="text-muted mb-0">
                    <i class="fas fa-mobile-alt"></i> 
                    <strong>Teléfono:</strong> 
                    <span class="badge-custom">{{ sender.telefono }}</span>
                </p>
            </div>
            <div class="text-right">
                <h5>
                    <i class="fas fa-user"></i> 
                    {% if usuarioPropietario %}
                        {{ usuarioPropietario.username }} {{ usuarioPropietario.apellidos }}
                    {% else %}
                        Usuario no encontrado
                    {% endif %}
                </h5>
                <small class="text-muted">
                    {% if usuarioPropietario %}
                        {{ usuarioPropietario.role }}
                    {% endif %}
                </small>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <i class="fas fa-history"></i> 
            Últimas 100 conversaciones
        </div>
        <div class="card-body p-0">
            <div class="chat-container">
                {% if mensajes|length > 0 %}
                    {% for mensaje in mensajes|reverse %}
                        <div class="message-wrapper {% if mensaje.direction == 'sent' %}message-sent{% else %}message-received{% endif %}">
                            <div>
                                <div class="message-role">
                                    {% if mensaje.direction == 'sent' %}
                                        ? Enviado
                                    {% else %}
                                        {% if mensaje.role == 'comercial' or mensaje.role == 'tecnico' %}
                                            {{ mensaje.role|upper }}
                                        {% else %}
                                            CLIENTE
                                        {% endif %}
                                    {% endif %}
                                </div>
                                <div class="message-bubble">
                                    {{ mensaje.message }}
                                    <div class="message-meta">
                                        {{ mensaje.timestamp|date('d/m/Y H:i:s') }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="no-messages">
                        <div class="text-center">
                            <i class="fas fa-inbox" style="font-size: 48px; color: #ccc;"></i>
                            <p class="mt-3">No hay conversaciones registradas</p>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex justify-content-between">
        <a href="{{ path('admin_conexiones_whatsapp') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Volver a Conexiones
        </a>
        <small class="text-muted align-self-center">
            Total de mensajes mostrados: {{ mensajes|length }}
        </small>
    </div>
</div>
{% endblock %}

{% block customscripts %}
    {{ parent() }}
    <script>
    // Auto-scroll al final del chat
    $(document).ready(function() {
        var chatContainer = $('.chat-container');
        chatContainer.scrollTop(chatContainer.prop('scrollHeight'));
    });
    </script>
{% endblock %}
