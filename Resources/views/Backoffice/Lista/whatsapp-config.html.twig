{% extends '@App/Backoffice/base.html.twig' %}

{% block titulo %}Configuración de WhatsApp{% endblock %}

{% block customstyles %}
    {{ parent() }}
    <style>
        .border-top-verde {
            border-top: 4px solid #075e54 !important;
        }

        .custom-switch .custom-control-label {
            padding-top: 0.25rem;
        }

        .custom-control-input:checked ~ .custom-control-label {
            color: #075e54;
        }

        .custom-control-input:checked ~ .custom-control-label::before {
            background-color: #25D366;
            border-color: #25D366;
        }

        .card {
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            transition: all 0.3s ease;
        }

        .card:hover {
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

        .badge-success {
            background-color: #25D366 !important;
        }

        .btn-success {
            background-color: #25D366;
            border-color: #25D366;
        }

        .btn-success:hover {
            background-color: #1ca152;
            border-color: #1ca152;
        }

        .bg-success {
            background-color: #25D366 !important;
        }

        .modal-header.bg-success {
            background-color: #25D366 !important;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-12">
            <h1 class="mb-4">
                <i class="fab fa-whatsapp" style="color: #25D366; font-size: 1.8em;"></i> 
                Mi Configuración de WhatsApp
            </h1>
        </div>
    </div>

    <!-- Card de Estado de Conexión -->
    <div class="row mb-4">
        <div class="col-md-8">
            <div class="card border-top-verde" id="card-estado">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h5 class="card-title mb-3">Estado de Conexión</h5>
                            
                            <!-- Badge de estado -->
                            <div class="mb-3">
                                {% if datosConexion.tieneConexion %}
                                    <span class="badge badge-success" style="font-size: 1.2em; padding: 0.5rem 1rem;">
                                        <i class="fas fa-check-circle"></i> Conectado
                                    </span>
                                {% else %}
                                    <span class="badge badge-danger" style="font-size: 1.2em; padding: 0.5rem 1rem;">
                                        <i class="fas fa-times-circle"></i> Desconectado
                                    </span>
                                {% endif %}
                            </div>

                            <!-- Información de teléfono y última conexión -->
                            {% if datosConexion.tieneConexion %}
                                <p class="mb-2">
                                    <strong>Teléfono:</strong> 
                                    <span id="telefono-whatsapp">{{ datosConexion.telefono }}</span>
                                </p>
                                <p class="mb-0">
                                    <strong>Última interacción:</strong> 
                                    <span id="ultima-interaccion">
                                        {{ datosConexion.ultimaInteraccion ? datosConexion.ultimaInteraccion|date('d/m/Y H:i') : 'N/A' }}
                                    </span>
                                </p>
                            {% else %}
                                <p class="text-muted mb-0">No tienes una sesión de WhatsApp activa. Escanea el código QR para conectarte.</p>
                            {% endif %}
                        </div>
                        
                        <div class="col-md-4 text-center">
                            <i class="fab fa-whatsapp" style="font-size: 4rem; color: #25D366; opacity: 0.3;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card de Acciones -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-body text-center">
                    <h6 class="card-title mb-3">Acciones</h6>
                    
                    {% if datosConexion.tieneConexion %}
                        <button class="btn btn-danger btn-block mb-2" id="btn-desconectar" title="Desconectar sesión">
                            <i class="fas fa-sign-out-alt"></i> Desconectar
                        </button>
                        <button class="btn btn-info btn-block" id="btn-solicitar-qr" title="Generar nuevo QR">
                            <i class="fas fa-qrcode"></i> Renovar QR
                        </button>
                    {% else %}
                        <button class="btn btn-success btn-block" id="btn-conectar" title="Conectar WhatsApp">
                            <i class="fas fa-link"></i> Conectar
                        </button>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Card de Configuración de Opciones -->
    <div class="row">
        <div class="col-md-12">
            <div class="card border-top-verde">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-sliders-h"></i> Opciones de WhatsApp
                    </h5>
                </div>
                <div class="card-body">
                    {% if datosConexion.tieneConexion %}
                        <!-- Opción 1: Sincronizar Conversaciones -->
                        <div class="row mb-4 pb-3 border-bottom">
                            <div class="col-md-8">
                                <h6 class="mb-2">Sincronizar Conversaciones</h6>
                                <small class="text-muted">
                                    Los mensajes de WhatsApp se sincronizarán automáticamente en el expediente.
                                </small>
                            </div>
                            <div class="col-md-4 text-right">
                                <div class="custom-control custom-switch">
                                    <input type="checkbox" class="custom-control-input toggle-opcion" id="sync-conversaciones" 
                                           data-opcion="SyncConversaciones" 
                                           {% if datosConexion.opciones.syncConversaciones %}checked{% endif %}>
                                    <label class="custom-control-label" for="sync-conversaciones"></label>
                                </div>
                            </div>
                        </div>

                        <!-- Opción 2: Automatizaciones WhatsApp -->
                        <div class="row mb-4 pb-3 border-bottom">
                            <div class="col-md-8">
                                <h6 class="mb-2">Automatizaciones WhatsApp</h6>
                                <small class="text-muted">
                                    Activa respuestas automáticas basadas en palabras clave y patrones.
                                </small>
                            </div>
                            <div class="col-md-4 text-right">
                                <div class="custom-control custom-switch">
                                    <input type="checkbox" class="custom-control-input toggle-opcion" id="automatizaciones-whatsapp" 
                                           data-opcion="AutomatizacionesWhatsapp" 
                                           {% if datosConexion.opciones.automatizacionesWhatsapp %}checked{% endif %}>
                                    <label class="custom-control-label" for="automatizaciones-whatsapp"></label>
                                </div>
                            </div>
                        </div>

                        <!-- Opción 3: Piloto Automático (IA) -->
                        <div class="row mb-0">
                            <div class="col-md-8">
                                <h6 class="mb-2">Piloto Automático (IA)</h6>
                                <small class="text-muted">
                                    Usa IA para generar respuestas inteligentes automáticamente.
                                </small>
                            </div>
                            <div class="col-md-4 text-right">
                                <div class="custom-control custom-switch">
                                    <input type="checkbox" class="custom-control-input toggle-opcion" id="piloto-automatico" 
                                           data-opcion="PilotoAutomatico" 
                                           {% if datosConexion.opciones.pilotoAutomatico %}checked{% endif %}>
                                    <label class="custom-control-label" for="piloto-automatico"></label>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="alert alert-info" role="alert">
                            <i class="fas fa-info-circle"></i> 
                            Primero conecta tu WhatsApp para acceder a las opciones de configuración.
                        </div>
                    {% endif %}

                    {% if datosConexion.tieneConexion %}
                        <!-- Prompt Piloto Automático -->
                        <div class="row mt-3 pt-3 border-top" id="container-piloto-prompt" style="{% if not datosConexion.opciones.pilotoAutomatico %}display: none;{% endif %}">
                            <div class="col-md-12">
                                <div class="form-group mb-2">
                                    <label for="piloto-automatico-prompt" class="font-weight-bold"><i class="fas fa-robot text-success"></i> Personalidad del Piloto Automático (Prompt)</label>
                                    <textarea class="form-control" id="piloto-automatico-prompt" rows="5" placeholder="Ej: Tu nombre es Leo. Eres un asistente sarcástico...">{{ datosConexion.opciones.pilotoAutomaticoSystemPrompt }}</textarea>
                                    <small class="form-text text-muted">Define la personalidad e instrucciones específicas para este bot. Si lo dejas vacío, usará el nombre del usuario por defecto de la base de datos.</small>
                                </div>
                                <button class="btn btn-sm btn-success" id="btn-guardar-prompt">
                                    <i class="fas fa-save"></i> Guardar Personalidad
                                </button>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Confirmación para Desconectar -->
<div class="modal fade" id="modal-confirmar-desconectar" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle"></i> Confirmar Desconexión
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p id="modal-desconectar-msg">¿Estás seguro de que deseas desconectar tu sesión de WhatsApp?</p>
                <p class="text-muted small mb-0">
                    <i class="fas fa-info-circle"></i> 
                    Deberás escanear un nuevo código QR para reconectarte.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="modal-desconectar-ok">
                    <i class="fas fa-sign-out-alt"></i> Desconectar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para mostrar QR -->
<div class="modal fade" id="modal-qr-whatsapp" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">
                    <i class="fab fa-whatsapp"></i> Conectar WhatsApp
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body text-center">
                <p id="qr-status-text" class="mb-4">Generando QR, espera un momento...</p>
                <div id="qr-container" class="mb-3">
                    <div id="qr-spinner" style="font-size: 2em; color: #25D366;">
                        <i class="fas fa-spinner fa-spin"></i> Cargando...
                    </div>
                    <img id="qr-image" src="" alt="Código QR" class="img-fluid" style="max-width: 300px; display: none;">
                </div>
                <p class="text-muted small">
                    <i class="fas fa-info-circle"></i> 
                    El código QR se actualiza automáticamente. Si no aparece, espera unos segundos.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-success" id="btn-solicitar-qr-modal">
                    <i class="fas fa-sync-alt"></i> Solicitar Nuevo QR
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block customscripts %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
$(document).ready(function() {
    // Desconectar WhatsApp - Abrir modal de confirmación
    $('#btn-desconectar').on('click', function() {
        $('#modal-confirmar-desconectar').modal('show');
    });

    // Ejecutar desconexión cuando se confirma en el modal
    $('#modal-desconectar-ok').on('click', function() {
        $(this).prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Desconectando...');
        
        $.ajax({
            url: '{{ path('api_desconectar_whatsapp') }}',
            type: 'POST',
            headers: {
                'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
            },
            success: function(response) {
                if (response.success) {
                    $('#modal-confirmar-desconectar').modal('hide');
                    toastr.success('Sesión desconectada. Recargando página...');
                    // Esperar 3 segundos para asegurar que BD esté actualizada
                    setTimeout(function() {
                        location.reload();
                    }, 3000);
                } else {
                    toastr.error(response.error || 'Error al desconectar');
                    $('#modal-desconectar-ok').prop('disabled', false).html('<i class="fas fa-sign-out-alt"></i> Desconectar');
                }
            },
            error: function() {
                toastr.error('Error de comunicación con el servidor');
                $('#modal-desconectar-ok').prop('disabled', false).html('<i class="fas fa-sign-out-alt"></i> Desconectar');
            }
        });
    });

    // Conectar WhatsApp (flujo: solicitar-crear sesión-polling QR)
    $('#btn-conectar, #btn-solicitar-qr, #btn-solicitar-qr-modal').on('click', function() {
        // 1. Solicitar sessionName al backend
        $.ajax({
            url: '{{ path('api_solicitar_qr_whatsapp') }}',
            type: 'POST',
            headers: {
                'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
            },
            success: function(response) {
                console.log('solicitarQR response:', response);
                if (response.success && response.sessionName) {
                    var sessionName = response.sessionName;
                    console.log('sessionName obtenido:', sessionName);
                    
                    // 2. Crear sesión en Node.js
                    crearSesionYPolling(sessionName);
                } else {
                    console.error('Error en respuesta:', response);
                    toastr.error(response.error || 'Error al generar QR');
                }
            },
            error: function(xhr, status, error) {
                console.error('Error AJAX solicitar-qr:', status, error, xhr.responseText);
                toastr.error('Error de comunicación con el servidor');
            }
        });
    });

    /**
     * Crea la sesión en Node.js y inicia polling para obtener el QR
     */
    function crearSesionYPolling(sessionName) {
        // POST /whatsapp/session/create
        $.ajax({
            url: '/whatsapp/session/create',
            type: 'POST',
            contentType: 'application/json',
            headers: {
                'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
            },
            data: JSON.stringify({ sessionName: sessionName }),
            success: function(response) {
                if (response.success) {
                    // Sesión creada, abrir modal y empezar polling
                    $('#modal-qr-whatsapp').modal('show');
                    $('#qr-image').hide();
                    $('#qr-spinner').show();
                    $('#qr-status-text').text('Generando QR, espera un momento...');
                    
                    iniciarPollingQR(sessionName);
                } else if (response.error && response.error.includes('ya existe')) {
                    // Sesión ya existe, solo hacer polling
                    $('#modal-qr-whatsapp').modal('show');
                    $('#qr-image').hide();
                    $('#qr-spinner').show();
                    $('#qr-status-text').text('Generando QR, espera un momento...');
                    
                    iniciarPollingQR(sessionName);
                } else {
                    toastr.error(response.error || 'Error al crear sesión');
                }
            },
            error: function(xhr) {
                if (xhr.status === 400) {
                    // Sesión ya existe, hacer polling de todas formas
                    $('#modal-qr-whatsapp').modal('show');
                    $('#qr-image').hide();
                    $('#qr-spinner').show();
                    $('#qr-status-text').text('Generando QR, espera un momento...');
                    
                    iniciarPollingQR(sessionName);
                } else {
                    toastr.error('Error de comunicación con el servidor');
                }
            }
        });
    }

    /**
     * Polling continuo para obtener el estado del QR
     */
    function iniciarPollingQR(sessionName) {
        var pollingInterval = null;
        var intentos = 0;
        var maxIntentos = 40; // 40 × 3s = 2 minutos máximo
        var intentos404 = 0; // Contar 404 consecutivos

        pollingInterval = setInterval(function() {
            intentos++;

            if (intentos > maxIntentos) {
                clearInterval(pollingInterval);
                $('#qr-status-text').text('Tiempo de espera agotado. Inténtalo de nuevo.');
                toastr.warning('El QR expiró. Solicita uno nuevo.');
                return;
            }

            // GET /whatsapp/session/qr/{sessionName}
            $.ajax({
                url: '/whatsapp/session/qr/' + encodeURIComponent(sessionName),
                type: 'GET',
                headers: {
                    'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
                },
                success: function(data) {
                    intentos404 = 0; // Reset contador de 404
                    
                    if (data.status === 'qr_ready' && data.qr) {
                        // Mostrar QR
                        $('#qr-spinner').hide();
                        $('#qr-image').attr('src', data.qr).show();
                        $('#qr-status-text').text('Escanea con tu WhatsApp');
                    } else if (data.status === 'waiting') {
                        // Aún cargando
                        $('#qr-spinner').show();
                        $('#qr-image').hide();
                        $('#qr-status-text').text('Generando QR, espera un momento...');
                    } else if (data.status === 'connected') {
                        // Usuario escaneó exitosamente
                        clearInterval(pollingInterval);
                        $('#qr-status-text').text('¡Conectado correctamente!');
                        toastr.success('WhatsApp conectado. Recargando...');
                        
                        // Esperar 2 segundos y recargar
                        setTimeout(function() {
                            location.reload();
                        }, 2000);
                    }
                },
                error: function(xhr) {
                    if (xhr.status === 404) {
                        intentos404++;
                        // Si hay 3 o más 404 consecutivos, significa que la sesión no existe
                        if (intentos404 >= 3) {
                            clearInterval(pollingInterval);
                            $('#qr-status-text').text('Sesión no encontrada. Inténtalo de nuevo.');
                            toastr.error('Sesión no encontrada');
                        } else {
                            // Continuar reintentando (la sesión puede estar creándose)
                            $('#qr-status-text').text('Generando QR, espera un momento...');
                        }
                    } else {
                        intentos404 = 0; // Reset en otros errores
                        // En otros errores, continuar reintentando
                    }
                }
            });

        }, 3000); // Polling cada 3 segundos
    }

    // Cambiar opciones (toggles)
    $('.toggle-opcion').on('change', function() {
        console.log('Toggle cambiado: ', $(this).data('opcion'), $(this).is(':checked'));
        var opcion = $(this).data('opcion');
        var estado = $(this).is(':checked');
        
        $.ajax({
            url: '{{ path('api_toggle_opcion_whatsapp') }}',
            type: 'POST',
            contentType: 'application/json',
            headers: {
                'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
            },
            data: JSON.stringify({
                opcion: opcion,
                estado: estado
            }),
            success: function(response) {
                if (response.success) {
                    toastr.success('Opción actualizada: ' + opcion);
                } else {
                    toastr.error(response.error || 'Error al actualizar opción');
                }
            },
            error: function() {
                toastr.error('Error de comunicación con el servidor');
                // Revertir el toggle en caso de error
                $(this).prop('checked', !estado);
            }
        });
    });
    // Mostrar/ocultar el editor del prompt cuando se hace toggle del Piloto Automático
    $('#piloto-automatico').on('change', function() {
        if ($(this).is(':checked')) {
            $('#container-piloto-prompt').slideDown();
        } else {
            $('#container-piloto-prompt').slideUp();
        }
    });

    // Guardar el prompt
    $('#btn-guardar-prompt').on('click', function() {
        var btn = $(this);
        var prompt = $('#piloto-automatico-prompt').val();
        
        btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Guardando...');
        
        $.ajax({
            url: '{{ path('api_guardar_prompt_whatsapp') }}',
            type: 'POST',
            contentType: 'application/json',
            headers: {
                'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
            },
            data: JSON.stringify({
                prompt: prompt
            }),
            success: function(response) {
                if (response.success) {
                    toastr.success('Personalidad guardada correctamente');
                } else {
                    toastr.error(response.error || 'Error al guardar la personalidad');
                }
            },
            error: function() {
                toastr.error('Error de comunicación con el servidor');
            },
            complete: function() {
                btn.prop('disabled', false).html('<i class="fas fa-save"></i> Guardar Personalidad');
            }
        });
    });

});
    </script>
{% endblock %}
