		#tabla-entidades tbody tr td:nth-child(2),
		#tabla-entidades tbody tr td:nth-child(3),
		#tabla-entidades tbody tr td:nth-child(4),
		#tabla-entidades tbody tr td:nth-child(5),
		#tabla-entidades tbody tr td:nth-child(6),
		#tabla-entidades tbody tr td:nth-child(7),
		#tabla-entidades tbody tr td:nth-child(8),
		#tabla-entidades tbody tr td:nth-child(9),
		#tabla-entidades tbody tr td:nth-child(10),
		#tabla-entidades tbody tr td:nth-child(11),
		#tabla-entidades tbody tr td:nth-child(12),
		#tabla-entidades tbody tr td:nth-child(13),
		#tabla-entidades tbody tr td:nth-child(14),
		#tabla-entidades tbody tr td:nth-child(15) {
