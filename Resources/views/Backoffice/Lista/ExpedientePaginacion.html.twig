												<span>Pendiente</span>
											</a>
											<a class="mr-2 registro" href="{{ path('obtener_registro_expediente',{'id':expediente.idExpediente}) }}" data-toggle="popover" data-content="Registro" data-trigger="hover">
												<i class="fas fa-book"></i>
												<span>Registro</span>
											</a>
											<a class="mr-2 duplicar" data-enlace-duplicar-expediente="{{ expediente.idExpediente }}" href="{{ path('duplicar_expediente',{'id':expediente.idExpediente}) }}" data-toggle="popover" data-content="Duplicar" data-trigger="hover">
												<i class="far fa-copy"></i>
												<span>Duplicar</span>
											</a>
											{% if (expediente.idComercial and expediente.idComercial.idUsuario == usuarioLogueado.idUsuario) or (expediente.idTecnico and expediente.idTecnico.idUsuario == usuarioLogueado.idUsuario) %}
												{% set wa_no_messages = (
													(usuarioTieneConexion|default(false))
													and
													(expediente.messages_count|default(messagesCountByExp[expediente.idExpediente]|default(0)) == 0)
												) %}
												<a class="mr-2 whatsapp {% if wa_no_messages %}wa-session-no-messages{% endif %}"
												   href="javascript:void(0)"
												   onclick="abrirModalWhatsApp({{ expediente.idExpediente }}, '{{ nombreCompleto|default('Cliente')|e('js') }}')"
												   {% if wa_no_messages %}title="Sesión activa — sin mensajes" aria-label="Sesión activa — sin mensajes"{% endif %}>
													<i class="fab fa-whatsapp"></i>
													<span>WhatsApp</span>
												</a>
											{% endif %}
											<a class="mr-2 cancelar" data-cancelar-expediente="{{ expediente.idExpediente }}" {% if expediente.idCliente is null %} data-sin-cliente {% endif %} href="javascript:void(0)" data-toggle="popover" data-content="Cancelar" data-trigger="hover">
												<i class="far fa-trash-alt"></i>
												<span>Cancelar</span>
											</a>
										{% endif %}
									</td>
									<td>{{ expediente.vivienda }}</td>
									<td>
										{% set id = expediente.idFaseActual.idFase %}
										{% set numeroFase =
											id in [1,3] ? 1 :
											(id in [2,4,8] ? 2 :
												(id == 5 ? 3 :
												(id in [6,9] ? 4 :
													(id in [7,10] ? 5 : 'N/A')
												)
												)
											)
										%}
										<div class="fase-popover" data-toggle="popover" data-trigger="hover" data-content="Fase {{ numeroFase }}: {{ expediente.idFaseActual.nombre }}">
											<span class="expediente-color" style="background:{{ expediente.idFaseActual.color }}"></span>
											<span>Fase {{ numeroFase }}</span>
										</div>
									</td>
									{% if not is_granted('ROLE_CLIENTE')and not is_granted('ROLE_COLABORADOR')  %}
										{% if expediente.estado is same as(0) %}
											<td>
												Cancelado
												{% if expediente.motivoCancelacion is same as(1) %}
													por: Honorarios
												{% elseif expediente.motivoCancelacion is same as(2) %}
													por: No le mejoramos la oferta
												{% elseif expediente.motivoCancelacion is same as(3) %}
													por: Operación no viable por perfil del cliente
												{% elseif expediente.motivoCancelacion is same as(4) %}
													por: Operación no viable por tasación
												{% elseif expediente.motivoCancelacion is same as(5) %}
													por: No tienen vivienda
												{% elseif expediente.motivoCancelacion is same as(6) %}
													por: Compran después de 3 meses
												{% elseif expediente.motivoCancelacion is same as(7) %}
													por: Importe hipoteca inferior a 100.000 €
												{% elseif expediente.motivoCancelacion is same as(8) %}
													por: Lo hacen con su banco
												{% elseif expediente.motivoCancelacion is same as(9) %}
													por: Lo hacen con otra empresa intermediaria
												{% elseif expediente.motivoCancelacion is same as(10) %}
													por: Duplicado
												{% elseif expediente.motivoCancelacion is same as(11) %}
													por:
												{% endif %}
												{{ expediente.texto }}
											</td>
										{% elseif expediente.estado is same as(1) %}
											<td>Activo</td>
										{% elseif expediente.estado is same as(2) %}
											<td>Firmado</td>
										{% else %}
											<td></td>
										{% endif %}
									{% endif %}
								</tr>
							{% endfor %}
						</tbody>
					</table>
					</div>
					
					<!-- Mensaje y botón en la misma línea -->
					<div class="row align-items-center mt-3 mb-3">
						<div class="col-md-6">
							<p class="text-muted mb-0">
								Mostrando registros del {{ ((currentPage - 1) * limit) + 1 }} al {{ min(currentPage * limit, totalExpedientes) }} de un total de {{ totalExpedientes }} registros (filtrado de un total de {{ totalExpedientes }} registros)
							</p>
						</div>
						<div class="col-md-6 text-right">
                            <!-- Paginación -->
                            {% if totalPages > 1 %}
                            <nav aria-label="Paginación de expedientes" class="mt-3">
                                <ul class="pagination justify-content-end">
                                    <li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
                                        <a class="page-link" href="{{ path('lista_expedientes_paginacion', app.request.query.all|merge({'page': 1})) }}">
                                            <i class="fas fa-angle-double-left"></i>
                                        </a>
                                    </li>
                                    <li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
                                        <a class="page-link" href="{{ path('lista_expedientes_paginacion', app.request.query.all|merge({'page': currentPage - 1})) }}">
                                            Anterior
                                        </a>
                                    </li>
                                    
                                    {% set startPage = max(1, currentPage - 2) %}
                                    {% set endPage = min(totalPages, currentPage + 2) %}
                                    
                                    {% if startPage > 1 %}
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    {% endif %}
                                    
                                    {% for page in startPage..endPage %}
                                        <li class="page-item {% if page == currentPage %}active{% endif %}">
                                            <a class="page-link" href="{{ path('lista_expedientes_paginacion', app.request.query.all|merge({'page': page})) }}">
                                                {{ page }}
                                            </a>
                                        </li>
                                    {% endfor %}
                                    
                                    {% if endPage < totalPages %}
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    {% endif %}
                                    
                                    <li class="page-item {% if currentPage == totalPages %}disabled{% endif %}">
                                        <a class="page-link" href="{{ path('lista_expedientes_paginacion', app.request.query.all|merge({'page': currentPage + 1})) }}">
                                            Siguiente
                                        </a>
                                    </li>
                                    <li class="page-item {% if currentPage == totalPages %}disabled{% endif %}">
                                        <a class="page-link" href="{{ path('lista_expedientes_paginacion', app.request.query.all|merge({'page': totalPages})) }}">
                                            <i class="fas fa-angle-double-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                            {% endif %}
							
						</div>
                        <div class="col-md-22">
                            {% if not is_granted('ROLE_CLIENTE') and not is_granted('ROLE_COLABORADOR') and not is_granted('ROLE_JEFE_INMOBILIARIA') and not is_granted('ROLE_JEFE_OFICINA') and not is_granted('ROLE_RESPONSABLE_ZONA') %}
								<button class="btn btn-success waves-effect" id="boton-borrar-entidades">Borrar marcados</button>
							{% endif %}
                        </div>
					</div>
				</form>
				
				
				
			{% else %}
				<div class="alert alert-info" role="alert">
					<span>No hay expedientes pendientes.</span>
				</div>
			{% endif %}
		</div>
	</div>
{% endblock %}
{% block modals %}
	{{ parent() }}
	{% include '@App/Backoffice/Modal/ConfirmarBorrar.html' %}
	{% include '@App/Backoffice/Modal/ConfirmarDuplicar.html' %}
	{% include '@App/Backoffice/Modal/NotificacionExpediente.html.twig' %}
	{% include '@App/Backoffice/Modal/CancelarExpediente.html.twig' %}
	
	<!-- Modal WhatsApp Messages -->
	<div aria-modal="true" aria-labelledby="modal-whatsapp-titulo" class="modal fade" id="modal-whatsapp-messages" role="dialog" tabindex="-1">
		<div class="modal-dialog modal-lg" role="document" style="max-width: 600px;">
			<div class="modal-content" style="border-radius: 0; border: none; overflow: hidden; height: 80vh; display: flex; flex-direction: column;">
				<div class="modal-header" style="background: #075e54; color: white; border: none; padding: 10px 15px; height: 60px; display: flex; align-items: center; border-radius: 0; flex-shrink: 0;">
					<div style="display: flex; align-items: center; width: 100%;">
						<div style="width: 40px; height: 40px; background: #eee; border-radius: 50%; margin-right: 12px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
							<i class="fas fa-user" style="color: #bbb; font-size: 20px;"></i>
						</div>
						<div style="flex: 1;">
							<h5 class="modal-title" id="modal-whatsapp-titulo" style="margin: 0; font-size: 16px; font-weight: 500; color: white; line-height: 1.2;">
								WhatsApp Hipotea
							</h5>
						</div>
					</div>
					<button aria-label="Cerrar" class="close" data-dismiss="modal" style="color: white; opacity: 1; text-shadow: none; margin: 0; padding: 0;" type="button">
						<span aria-hidden="true" style="font-size: 24px;">&times;</span>
					</button>
				</div>
				<div class="modal-body" id="whatsapp-messages-container" style="flex: 1; overflow-y: auto; background-color: #e5ddd5; padding: 0; position: relative;">
					<div class="whatsapp-doodle-overlay" style="position: absolute; top:0; left:0; width:100%; height:100%; opacity: 0.06; pointer-events: none; background-image: url('https://user-images.githubusercontent.com/15075759/28719144-86dc0f70-73b1-11e7-911d-60d70fcded21.png');"></div>
					<div id="whatsapp-messages-inner" style="position: relative; z-index: 1; padding: 20px 7% 10px;">
						<div class="text-center text-muted mt-5">
							<i class="fas fa-spinner fa-spin"></i> Cargando...
						</div>
					</div>
				</div>
				<div class="modal-footer" style="background: #fff; border: none; padding: 10px 15px; height: auto; flex-shrink: 0; display: flex; gap: 10px; align-items: flex-end;">
					<input type="hidden" id="whatsapp-expediente-id" value="0">
					<input type="text" id="whatsapp-message-input" class="form-control" placeholder="Escribe un mensaje..." style="border-radius: 20px; padding: 8px 15px; font-size: 14px; flex: 1;">
					<button id="whatsapp-send-btn" type="button" class="btn btn-sm" style="background: #075e54; color: white; border: none; border-radius: 50%; width: 36px; height: 36px; padding: 0; display: flex; align-items: center; justify-content: center;">
						<i class="fas fa-paper-plane"></i>
					</button>
				</div>
			</div>
		</div>
	</div>
	
	<style>
		#whatsapp-messages-container {
			font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
			scrollbar-width: thin;
			scrollbar-color: rgba(0,0,0,.2) transparent;
		}

		/* Scroll personalizado Chrome/Safari */
		#whatsapp-messages-container::-webkit-scrollbar {
			width: 6px;
		}
		#whatsapp-messages-container::-webkit-scrollbar-thumb {
			background: rgba(0,0,0,.2);
		}
		
		.whatsapp-message-row {
			display: flex;
			margin-bottom: 2px;
			width: 100%;
			position: relative;
		}
		
		.whatsapp-message-row.enviado {
			justify-content: flex-end;
		}
		
		.whatsapp-message-row.recibido {
			justify-content: flex-start;
		}
		
		.whatsapp-bubble {
			padding: 6px 7px 8px 9px;
			border-radius: 7.5px;
			position: relative;
			max-width: 85%;
			min-width: 80px;
			box-shadow: 0 1px 0.5px rgba(0,0,0,.13);
			font-size: 14px;
			line-height: 19px;
			color: #111;
			margin-top: 2px;
		}
		
		/* Rabo de la burbuja (Tail) */
		.whatsapp-bubble::after {
			content: "";
			position: absolute;
			top: 0;
			width: 12px;
			height: 13px;
		}

		.whatsapp-bubble.enviado {
			background-color: #dcf8c6;
			border-top-right-radius: 0;
		}
		
		.whatsapp-bubble.enviado::after {
			right: -12px;
			background: linear-gradient(135deg, #dcf8c6 0%, #dcf8c6 50%, transparent 50%, transparent 100%);
		}
		
		.whatsapp-bubble.recibido {
			background-color: #ffffff;
			border-top-left-radius: 0;
		}

		.whatsapp-bubble.recibido::after {
			left: -12px;
			background: linear-gradient(225deg, #ffffff 0%, #ffffff 50%, transparent 50%, transparent 100%);
		}

		.whatsapp-text {
			margin-bottom: 4px;
			white-space: pre-wrap;
			word-wrap: break-word;
			padding-right: 15px;
		}
		
		.whatsapp-meta {
			display: flex;
			align-items: center;
			justify-content: flex-end;
			float: right;
			margin-top: -10px;
			margin-left: 10px;
			height: 15px;
			position: relative;
			bottom: -4px;
		}

		.whatsapp-time {
			font-size: 11px;
			color: rgba(0,0,0,.45);
			margin-right: 3px;
		}

		.whatsapp-check {
			font-size: 11px;
			color: #4fc3f7;
			display: flex;
		}

		/* Agrupar mensajes: quitar cola si el anterior es del mismo lado */
		.whatsapp-message-row.no-tail .whatsapp-bubble::after {
			display: none;
		}
		.whatsapp-message-row.no-tail .whatsapp-bubble {
			border-top-left-radius: 7.5px;
			border-top-right-radius: 7.5px;
		}
	</style>
{% endblock %}