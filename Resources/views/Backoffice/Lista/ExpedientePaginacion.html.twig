			border: 2px solid darkmagenta;
			padding: 2px 5px;
			border-radius: 5px;
			color: darkmagenta;
			background: white;
			font-size: 18px;
		}

		a.registro,
		a.firmas {
			border: 2px solid tomato;
			padding: 2px 5px;
			border-radius: 5px;
			color: tomato;
			background: white;
			font-size: 18px;
		}

		a.duplicar {
			border: 2px solid teal;
			padding: 2px 5px;
			border-radius: 5px;
			color: teal;
			background: white;
			font-size: 18px;
		}

		a.chat-expediente {
			display: inline-block;
			min-width: 30px;
			text-align: center;
			border: 2px solid #17a2b8;
			padding: 2px 5px;
			border-radius: 5px;
			color: #17a2b8;
			background: white;
			font-size: 18px;
			line-height: 1.2;
		}
		tr a.chat-expediente {
			color: #17a2b8;
		}

		a.chat-expediente.sin-mensajes {
			border-color: #b8bfc6;
			color: #b8bfc6;
			background: #f5f6f7;
		}

		a.chat-expediente i {
			display: inline-block;
		}

		#modal-chat-expediente {
			max-height: 90vh;
		}

		#modal-chat-expediente .modal-content {
			max-height: 85vh;
		}

		#modal-chat-expediente .modal-body {
			background: #f7f9fc;
			max-height: 60vh;
			overflow-y: auto;
		}

		#modal-chat-expediente .modal-footer {
			max-height: 35vh;
		}

		.chat-expediente-contenedor {
			display: flex;
			flex-direction: column;
			gap: 10px;
		}

		.chat-expediente-item {
			max-width: 80%;
			padding: 10px 12px;
			border-radius: 14px;
			background: #fff;
			box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
		}

		.chat-expediente-item.entrante {
			align-self: flex-start;
			border-left: 4px solid #17a2b8;
		}

		.chat-expediente-item.saliente {
			align-self: flex-end;
			border-right: 4px solid #28a745;
			background: #eefcf1;
		}

		.chat-expediente-meta {
			font-size: 12px;
			color: #6c757d;
			margin-bottom: 4px;
		}

		.chat-expediente-vacio {
			text-align: center;
			color: #6c757d;
			padding: 20px;
		}

		a.editar span,
		a.documentos span,
		a.notificar span,
		a.email span,
		a.informe span,
		a.pendiente span,
		a.registro span,
		a.duplicar span,
		a.firmas span,
		a.seguimiento span,
		a.cancelar span,
		a.chat-expediente span {
			display: none;
		}

		@media(max-width: 576px) {
			#tabla-entidades thead th,
			#tabla-entidades tbody tr td {
				max-width: max-content !important;
				width: max-content !important;
			}

			#tabla-entidades td:nth-child(1) {
				padding-right: 20px !important;
			}
		}
		
		.pagination-info {
			text-align: center;
			margin-top: 10px;
			color: #666;
		}
		
		.estado-btn {
			min-height: 32px !important;
		}
	</style>
{% endblock %}
{% block devscripts %}
	{{ parent() }}
	<script src="{{ asset('assets/node_modules/select2/dist/js/select2.full.min.js') }}"></script>
	<script src="{{ asset('assets/node_modules/select2/dist/js/i18n/es.js') }}"></script>
{% endblock %}
{% block cloudscripts %}
	{{ parent() }}
	<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.1/js/select2.full.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.1/js/i18n/es.js"></script>
{% endblock %}
{% block customscripts %}
	{{ parent() }}
	<script>
		$(function () {
			'use strict';
			
			// DEBUG: Contar opciones antes de inicializar Select2
			var countClientes = $('#clientes option').length;
			//console.log('Opciones de clientes en HTML:', countClientes);
			$('#count-clientes').text(countClientes);
			
			// IMPORTANTE: Destruir TODAS las instancias de Select2 antes de inicializar
			$('select').each(function() {
				if ($(this).data('select2')) {
					$(this).select2('destroy');
				}
			});
			
			// Esperar un momento antes de reinicializar
			setTimeout(function() {
				// Inicializar todos los select2
				$('.select2').each(function() {
					var placeholderText = $(this).data('placeholder') || '';
					var isMultiple = $(this).attr('multiple') !== undefined;
					
					//console.log('Inicializando select:', $(this).attr('id'), 'con', $(this).find('option').length, 'opciones, multiple:', isMultiple);
					
					$(this).select2({
						language: 'es',
						placeholder: placeholderText,
						allowClear: true,
						width: '100%',
						closeOnSelect: !isMultiple
					});
				});
				
				//console.log('Select2 inicializado correctamente');
			}, 100);
			
			$('[data-toggle="popover"]').popover();
			
			// Manejar selección de todos los checkboxes
			$('#seleccionar-todas-entidades').on('change', function() {
				$('input[name="expediente[]"]').prop('checked', $(this).prop('checked'));
			});
			
			// Si se desmarca alguno individualmente, desmarcar el "seleccionar todos"
			$(document).on('change', 'input[name="expediente[]"]', function() {
				if (!$(this).prop('checked')) {
					$('#seleccionar-todas-entidades').prop('checked', false);
				} else {
					// Si todos están marcados, marcar el "seleccionar todos"
					if ($('input[name="expediente[]"]:checked').length === $('input[name="expediente[]"]').length) {
						$('#seleccionar-todas-entidades').prop('checked', true);
					}
				}
			});
			
			// Funcionalidad de búsqueda global con debounce
			var searchTimeout;
			$('#buscar-tabla').on('keyup', function() {
				clearTimeout(searchTimeout);
				var valor = $(this).val();
				
				// Si el campo está vacío, no hacer búsqueda
				if (valor.length === 0) {
					return;
				}
				
				// Esperar 500ms después de que el usuario deje de escribir
				searchTimeout = setTimeout(function() {
					// Obtener la URL actual y agregar el parámetro de búsqueda
					var url = new URL(window.location.href);
					url.searchParams.set('buscar', valor);
					url.searchParams.set('page', '1'); // Resetear a la página 1
					
					// Redirigir a la URL con el parámetro de búsqueda
					window.location.href = url.toString();
				}, 500);
			});
			
			// Limpiar búsqueda si se borra el campo
			$('#buscar-tabla').on('search', function() {
				if ($(this).val() === '') {
					var url = new URL(window.location.href);
					url.searchParams.delete('buscar');
					window.location.href = url.toString();
				}
			});
		});

		function rutaDuplicarExpediente() {
			return '{{ path('duplicar_expediente',{'id':' '}) }}';
		}

		function rutaNotificacionExpediente() {
			return '{{ path('notificacion_expediente',{'id':' '}) }}';
		}

		function rutaCancelarExpediente() {
			return '{{ path('cancelar_expediente',{'id':' '}) }}';
		}

		function rutaExpedienteChatMensajes() {
			return '{{ path('expediente_chat_mensajes',{'id':'__ID__'}) }}';
		}

		function rutaExpedienteChatResponder() {
			return '{{ path('expediente_chat_responder_kommo',{'id':'__ID__'}) }}';
		}

		function rutaExpedienteChatSugerir() {
			return '{{ path('expediente_chat_sugerir_kommo_ajax',{'id':'__ID__'}) }}';
		}
		
		function cambiarLimit(nuevoLimit) {
			// Obtener la URL actual con todos sus parámetros
			var url = new URL(window.location.href);
			
			// Actualizar el parámetro limit
			url.searchParams.set('limit', nuevoLimit);
			
			// Resetear a la página 1 al cambiar el límite
			url.searchParams.set('page', '1');
			
			// Redirigir a la nueva URL
			window.location.href = url.toString();
		}
		
		// Manejo de botones de estado (Cancelados, Activos, Firmados)
		$(function() {
			// Función para aplicar estilos al botón según el estado
			function aplicarEstiloBotón(estado) {
				//console.log('Aplicando estilo al estado:', estado);
				// Remover estilos de todos los botones
				$('.estado-btn').removeAttr('style').removeClass('active');
				
				// Buscar el botón con el estado y aplicar estilo
				var botón = $('.estado-btn[data-estado="' + estado + '"]');
				if (botón.length) {
					//console.log('Botón encontrado para estado:', estado);
					if (estado == '0') {
						botón.css({'background-color': '#dc3545', 'color': 'white'});
					} else if (estado == '1') {
						botón.css({'background-color': '#28a745', 'color': 'white'});
					} else if (estado == '2') {
						botón.css({'background-color': '#007bff', 'color': 'white'});
					} 
				}
			}
			
			// Al cargar la página, activar el botón correspondiente al valor del input oculto
			var estadoActual = $('#estado-filtro').val();
			//console.log('Estado actual del input oculto:', estadoActual);
			
			// Si no hay estado o está vacío, usar '1' (Activos) por defecto
			if (!estadoActual || estadoActual === '') {
				estadoActual = '1';
				$('#estado-filtro').val('1');
			}
			
			aplicarEstiloBotón(estadoActual);
			
			// Evento click en los botones
			$('.estado-btn').on('click', function() {
				var estado = $(this).data('estado');
				//console.log('Click en botón con estado:', estado);
				
				// Aplicar estilos al botón clickeado
				aplicarEstiloBotón(estado);
				
				// Actualizar el valor del input oculto
				$('#estado-filtro').val(estado);
			});
		});
		function cargarMensajesExpediente(idExpediente, vivienda) {
			var url = rutaExpedienteChatMensajes().replace('__ID__', idExpediente);
			var $contenedor = $('#chat-expediente-contenido');

			$('#chat-expediente-titulo').text('Mensajes del expediente #' + idExpediente);
			$('#chat-expediente-subtitulo').text(vivienda || '');
			$contenedor.html('<div class="chat-expediente-vacio">Cargando mensajes...</div>');

			$.get(url)
				.done(function (respuesta) {
					if (!respuesta || !respuesta.mensajes || respuesta.mensajes.length === 0) {
						$contenedor.html('<div class="chat-expediente-vacio">Todavía no hay mensajes guardados para este expediente.</div>');
						return;
					}

					var html = '<div class="chat-expediente-contenedor">';
					respuesta.mensajes.forEach(function (mensaje) {
						var direccion = (mensaje.direccion || 'entrante').toLowerCase() === 'saliente' ? 'saliente' : 'entrante';
						html += '<div class="chat-expediente-item ' + direccion + '">';
						html += '<div class="chat-expediente-meta">' + $('<div>').text(mensaje.autor || 'Usuario').html() + ' · ' + $('<div>').text(mensaje.fecha || '').html() + '</div>';
						html += '<div class="chat-expediente-texto">' + $('<div>').text(mensaje.texto || '').html().replace(/\n/g, '<br>') + '</div>';
						html += '</div>';
					});
					html += '</div>';
					$contenedor.html(html);
				})
				.fail(function () {
					$contenedor.html('<div class="chat-expediente-vacio">No se han podido cargar los mensajes del expediente.</div>');
				});
		}

		$(document).on('click', '[data-expediente-chat]', function (e) {
			e.preventDefault();

			var idExpediente = $(this).data('expediente-chat');
			var vivienda = $(this).data('vivienda') || '';
			$('#chat-expediente-id').val(idExpediente);
			$('#chat-expediente-respuesta').val('');
			$('#chat-expediente-alerta').addClass('d-none').removeClass('alert-success alert-danger').text('');
			$('#modal-chat-expediente').modal('show');
			cargarMensajesExpediente(idExpediente, vivienda);
		});

		$(document).on('click', '#chat-expediente-sugerir', function (e) {
			e.preventDefault();

			var idExpediente = $('#chat-expediente-id').val();
			var $boton = $(this);
			var $botonEnviar = $('#chat-expediente-enviar');
			var $cargando = $('#chat-expediente-cargando-ia');
			var $textarea = $('#chat-expediente-respuesta');
			var $alerta = $('#chat-expediente-alerta');
			var $infoTokens = $('#chat-expediente-info-tokens');
			var $divInfoTokens = $('#chat-expediente-info-tokens').parent();

			if (!idExpediente) {
				$alerta.removeClass('d-none alert-success').addClass('alert-danger').text('No se ha cargado un expediente válido.');
				return;
			}

			// Mostrar indicador de carga
			$cargando.removeClass('d-none');
			$divInfoTokens.addClass('d-none');
			$boton.prop('disabled', true);
			$botonEnviar.prop('disabled', true);
			$alerta.addClass('d-none').removeClass('alert-success alert-danger').text('');

			console.log('🚀 [SUGERIR] Iniciando petición para expediente:', idExpediente);
			console.log('🔗 [SUGERIR] URL:', rutaExpedienteChatSugerir().replace('__ID__', idExpediente));

			// Realizar petición a la API de sugerencia IA
			$.ajax({
				url: rutaExpedienteChatSugerir().replace('__ID__', idExpediente),
				method: 'POST',
				contentType: 'application/json; charset=utf-8',
				dataType: 'json',
				data: JSON.stringify({})
			})
				.done(function (respuesta) {
					console.log('📥 [SUGERIR] Respuesta recibida:', respuesta);
					
					if (respuesta.success && respuesta.sugerencia) {
						console.log('✅ [SUGERIR] Sugerencia válida. Longitud:', respuesta.sugerencia.length);
						
						// Insertar sugerencia en textarea
						$textarea.val(respuesta.sugerencia);
						
						// Mostrar información de tokens
						var tokensInfo = 'Entrada: ' + (respuesta.tokens.entrada || 0) + ' | Salida: ' + (respuesta.tokens.salida || 0) + ' | Total: ' + (respuesta.tokens.total || 0) + ' | Proveedor: ' + (respuesta.proveedor || 'Desconocido');
						$infoTokens.text(tokensInfo);
						$divInfoTokens.removeClass('d-none');
						
						$alerta.removeClass('d-none alert-danger').addClass('alert-success').text('Sugerencia obtenida correctamente. Puedes editarla antes de enviar.');
					} else {
						console.log('❌ [SUGERIR] Respuesta sin éxito:', respuesta);
						var msg = (respuesta && respuesta.message) ? respuesta.message : 'No se obtuvo una sugerencia válida.';
						$alerta.removeClass('d-none alert-success').addClass('alert-danger').text(msg);
					}
				})
				.fail(function (xhr) {
					console.log('❌ [SUGERIR] Error AJAX:', {
						status: xhr.status,
						statusText: xhr.statusText,
						responseJSON: xhr.responseJSON,
						responseText: xhr.responseText
					});
					
					var mensajeError = 'No se pudo obtener la sugerencia de IA.';
					
					if (xhr.responseJSON) {
						if (xhr.responseJSON.message) {
							mensajeError = xhr.responseJSON.message;
							if (xhr.responseJSON.debug_exception) {
								mensajeError += ' [' + xhr.responseJSON.debug_exception + ' en ' + xhr.responseJSON.debug_file + ':' + xhr.responseJSON.debug_line + ']';
							}
						}
					} else if (xhr.status === 400) {
						mensajeError = 'No hay conversación cargada para sugerir respuesta.';
					} else if (xhr.status === 500) {
						mensajeError = 'Error en la API de IA. Por favor, intenta más tarde.';
					}
					
					$alerta.removeClass('d-none alert-success').addClass('alert-danger').text(mensajeError);
				})
				.always(function () {
					console.log('✅ [SUGERIR] Petición completada');
					$cargando.addClass('d-none');
					$boton.prop('disabled', false);
					$botonEnviar.prop('disabled', false);
				});
		});

		$(document).on('click', '#chat-expediente-enviar', function (e) {
			e.preventDefault();

			var idExpediente = $('#chat-expediente-id').val();
			var mensaje = $.trim($('#chat-expediente-respuesta').val());
			var $boton = $(this);
			var $alerta = $('#chat-expediente-alerta');

			if (!mensaje) {
				$alerta.removeClass('d-none alert-success').addClass('alert-danger').text('Escribe un mensaje antes de enviarlo.');
				return;
			}

			$boton.prop('disabled', true).text('Enviando...');
			$alerta.addClass('d-none').removeClass('alert-success alert-danger').text('');

			$.ajax({
				url: rutaExpedienteChatResponder().replace('__ID__', idExpediente),
				method: 'POST',
				contentType: 'application/json; charset=utf-8',
				data: JSON.stringify({ mensaje: mensaje })
			})
				.done(function (respuesta) {
					$alerta.removeClass('d-none alert-danger').addClass('alert-success').text((respuesta && respuesta.mensaje) ? respuesta.mensaje : 'Mensaje enviado correctamente.');
					$('#chat-expediente-respuesta').val('');
					cargarMensajesExpediente(idExpediente, $('#chat-expediente-subtitulo').text());
				})
				.fail(function (xhr) {
					var mensajeError = 'No se pudo enviar el mensaje a Kommo.';
					if (xhr.responseJSON && xhr.responseJSON.mensaje) {
						mensajeError = xhr.responseJSON.mensaje;
					}
					$alerta.removeClass('d-none alert-success').addClass('alert-danger').text(mensajeError);
				})
				.always(function () {
					$boton.prop('disabled', false).text('Enviar a Kommo');
				});
		});
	</script>
	<script src="{{ asset('assets/js/custom/lista-expedientes.min.js') }}"></script>
	<script src="{{ asset('assets/js/custom/notificacion-expediente.js') }}"></script>
	<script src="{{ asset('assets/js/custom/cancelar-expediente.js') }}"></script>
{% endblock %}
{% block body %}
	<div class="card">
		<div class="card-body">
			{% include '@App/Backoffice/MensajeAlerta.html.twig' %}
			<h4 class="card-title">{{ titulo }}</h4>
			
			<!-- Filtros -->
			<div class="card mb-3">
				<!--<div class="card-header">
					<h5 class="mb-0">Filtros de búsqueda</h5>
				</div>-->
                <div class="card-body">					
                    <form method="get" action="{{ path('lista_expedientes_paginacion') }}" id="formFiltros">
                        {# Campo oculto para preservar el límite de registros al filtrar #}
                        <input type="hidden" name="limit" value="{{ limit }}">
                        
                        <div class="row">
                            {# Filtro por número de expediente 
                            {% if not is_granted('ROLE_CLIENTE') and not is_granted('ROLE_COLABORADOR') %}
                                <div class="col-md-2 mb-3">
                                    <label for="expediente">Nº Expediente</label>
                                    <input type="text" 
                                            class="form-control" 
                                            id="expediente" 
                                            name="expediente" 
                                            value="{{ app.request.get('expediente') }}"
                                            placeholder="Nº expediente">
                                </div>
                            {% endif %}#}

                            {# Filtro por clientes - Solo si no es ROLE_CLIENTE ni ROLE_COLABORADOR #}
                            {% if not is_granted('ROLE_CLIENTE') and not is_granted('ROLE_COLABORADOR') %}
                                <div class="col-md-2 mb-3">
                                    <label for="clientes">Buscar cliente </label>
                                    <select class="form-control select2" 
                                            id="clientes" 
                                            name="clientes[]" 
                                            multiple="multiple">
                                        {% for cliente in clientes %}
                                            {% set usuario = cliente %}
                                            {% if usuario.apellidos|length is same as(0) %}
                                                {% if usuario.username|length is same as(0) %}
                                                    {% set nombreCompleto = '' %}
                                                {% else %}
                                                    {% set nombreCompleto = usuario.username %}
                                                {% endif %}
                                            {% else %}
                                                {% if usuario.username|length is same as(0) %}
                                                    {% set nombreCompleto = usuario.apellidos %}
                                                {% else %}
                                                    {% set nombreCompleto = usuario.apellidos ~ ', ' ~ usuario.username %}
                                                {% endif %}
                                            {% endif %}
                                            {% if nombreCompleto|length is not same as(0) %}
                                                {% set nombreCompleto = nombreCompleto  %}
                                            {% endif %}
                                            <option value="{{ cliente.idUsuario }}" 
                                                    {% if app.request.get('clientes') and cliente.idUsuario in app.request.get('clientes') %}selected{% endif %}>
                                                {{ nombreCompleto }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                    
                                </div>
                            {% endif %}

                            {# Filtro por colaboradores #}
                            {% if not is_granted('ROLE_CLIENTE') and not is_granted('ROLE_COLABORADOR') %}
                                <div class="col-md-2 mb-3">
                                    <label for="colaboradores">Buscar usuario colaborador</label>
                                    <select class="form-control select2" 
                                            id="colaboradores" 
                                            name="colaboradores[]" 
                                            multiple="multiple"
                                            data-placeholder="">
                                        {% for colaborador in colaboradores %}
                                            {% set usuario = colaborador %}
                                            {% if usuario.apellidos|length is same as(0) %}
                                                {% if usuario.username|length is same as(0) %}
                                                    {% set nombreCompleto = '' %}
                                                {% else %}
                                                    {% set nombreCompleto = usuario.username %}
                                                {% endif %}
                                            {% else %}
                                                {% if usuario.username|length is same as(0) %}
                                                    {% set nombreCompleto = usuario.apellidos %}
                                                {% else %}
                                                    {% set nombreCompleto = usuario.apellidos ~ ', ' ~ usuario.username %}
                                                {% endif %}
                                            {% endif %}
                                            <option value="{{ colaborador.idUsuario }}"
                                                    {% if app.request.get('colaboradores') and colaborador.idUsuario in app.request.get('colaboradores') %}selected{% endif %}>
                                                {{ nombreCompleto }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                            {% endif %}

                            {# Filtro por comerciales - Solo para ADMIN y COMERCIAL y TECNICO #}
                            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_COMERCIAL') or is_granted('ROLE_TECNICO') %}
                                <div class="col-md-2 mb-3">
                                    <label for="comerciales">Buscar comercial</label>
                                    <select class="form-control select2" 
                                            id="comerciales" 
                                            name="comerciales[]" 
                                            multiple="multiple"
                                            data-placeholder="">
                                        {% for comercial in comerciales %}
                                            <option value="{{ comercial.idUsuario }}"
                                                    {% if app.request.get('comerciales') and comercial.idUsuario in app.request.get('comerciales') %}selected{% endif %}>
                                                {{ comercial.apellidos }}, {{ comercial.nombre }}{% if comercial.username %} ({{ comercial.username }}){% endif %}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>

                                {# Filtro por técnicos #}
                                <div class="col-md-2 mb-3">
                                    <label for="tecnicos">Buscar técnico</label>
                                    <select class="form-control select2" 
                                            id="tecnicos" 
                                            name="tecnicos[]" 
                                            multiple="multiple"
                                            data-placeholder="">
                                        {% for tecnico in tecnicos %}
                                            <option value="{{ tecnico.idUsuario }}"
                                                    {% if app.request.get('tecnicos') and tecnico.idUsuario in app.request.get('tecnicos') %}selected{% endif %}>
                                                {{ tecnico.apellidos }}, {{ tecnico.nombre }}{% if tecnico.username %} ({{ tecnico.username }}){% endif %}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                            {% endif %}

                            {# Filtro por inmobiliarias #}
                            {% if not is_granted('ROLE_CLIENTE') and not is_granted('ROLE_COLABORADOR') %}
                                <div class="col-md-2 mb-3">
                                    <label for="inmobiliarias">Buscar colaborador</label>
                                    <select class="form-control select2" 
                                            id="inmobiliarias" 
                                            name="inmobiliarias[]" 
                                            multiple="multiple">
                                            data-placeholder="Seleccionar inmobiliarias">
                                        {% for inmobiliaria in inmobiliarias %}
                                            <option value="{{ inmobiliaria.idInmobiliaria }}"
                                                    {% if app.request.get('inmobiliarias') and inmobiliaria.idInmobiliaria in app.request.get('inmobiliarias') %}selected{% endif %}>
                                                {{ inmobiliaria.nombre }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                            {% endif %}

                            {# Filtro por oficinas - Visible para ROLE_JEFE_OFICINA también #}
                            {% if not is_granted('ROLE_CLIENTE') and not is_granted('ROLE_COLABORADOR') or is_granted('ROLE_JEFE_OFICINA') %}
                                <div class="col-md-2 mb-3">
                                    <label for="oficinas">Buscar oficina</label>
                                    <select class="form-control select2" 
                                            id="oficinas" 
                                            name="oficinas[]" 
                                            multiple="multiple"
                                            data-placeholder="">
                                        {% for oficina in oficinas %}
                                            <option value="{{ oficina.idOficina }}"
                                                    {% if (app.request.get('oficinas') and oficina.idOficina in app.request.get('oficinas')) or (not app.request.get('oficinas') and oficinaPreseleccionada is defined and oficinaPreseleccionada == oficina.idOficina) %}selected{% endif %}>
                                                {{ oficina.nombre }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                            {% endif %}
							{# Filtro de estado con botones toggle #}
							{% if not is_granted('ROLE_CLIENTE') %}
                                <div class="col-md-4 mb-3">
									<label for="estado">Estado</label>
									<div style="width: 100% !important;">
										<input type="hidden" id="estado-filtro" name="estado" value="{{ app.request.get('estado') }}">
										<button type="button" class="btn btn-sm btn-outline-danger estado-btn" data-estado="0">
											Cancelados
										</button>
										<button type="button" class="btn btn-sm btn-outline-success estado-btn" data-estado="1">
											Activos
										</button>
										<button type="button" class="btn btn-sm btn-outline-primary estado-btn" data-estado="2">
											Firmados
										</button>
									</div>
                                </div>
                            {% endif %}
                        </div>
						
						{% if not is_granted('ROLE_CLIENTE') %}
							{# Botones de acción #}
							<div class="row mt-3">
								<div class="col-12" style="text-align: center;">
									<button type="submit" class="btn btn-primary">
										<i class="fas fa-filter"></i> Filtrar
									</button>
									<a href="{{ path('lista_expedientes_paginacion') }}" class="btn btn-secondary">
										<i class="fas fa-eraser"></i> Limpiar filtros
									</a>
								</div>
							</div>
						{% endif %}
                    </form>
                </div>
			</div>
			
			{% if expedientes is defined and expedientes is iterable and expedientes|length>0 %}
				<!-- Selector de cantidad de registros y búsqueda -->
				<div class="row mb-3 align-items-center">
					<div class="col-auto">
						<label for="limitSelect" class="col-form-label">Mostrar:</label>
					</div>
					<div class="col-auto">
						<select class="form-control" id="limitSelect" onchange="cambiarLimit(this.value)">
							<option value="10" {% if limit == 10 %}selected{% endif %}>10</option>
							<option value="20" {% if limit == 20 %}selected{% endif %}>20</option>
							<option value="50" {% if limit == 50 %}selected{% endif %}>50</option>
							<option value="100" {% if limit == 100 %}selected{% endif %}>100</option>
							<option value="200" {% if limit == 200 %}selected{% endif %}>200</option>
						</select>
					</div>
					<div class="col-auto">
						<span class="col-form-label">registros</span>
					</div>
				<div class="col text-right">
					<label for="buscar-tabla" class="col-form-label mr-2">Buscar:</label>
					<input type="search" class="form-control d-inline-block" id="buscar-tabla" placeholder="" style="width: 200px;" value="{{ app.request.get('buscar') }}">
				</div>
				<div class="col-auto">
					<form method="get" id="formOrden" action="{{ path('lista_expedientes_paginacion') }}">
						{# Preservar parámetros GET actuales excepto 'orden' y 'page' #}
						{% for key, val in app.request.query.all %}
							{% if key != 'orden' and key != 'page' %}
								{% if val is iterable %}
									{% for v in val %}
										<input type="hidden" name="{{ key }}[]" value="{{ v }}">
									{% endfor %}
								{% else %}
									<input type="hidden" name="{{ key }}" value="{{ val }}">
								{% endif %}
							{% endif %}
						{% endfor %}
						<label for="ordenSelect" class="sr-only">Ordenar</label>
						<select id="ordenSelect" name="orden" class="form-control" onchange="document.getElementById('formOrden').submit()">
							<option value="fecha_modificacion" {% if app.request.get('orden') == 'fecha_modificacion' or app.request.get('orden') is null %}selected{% endif %}>Fecha modificación (por defecto)</option>
							<option value="fecha_creacion" {% if app.request.get('orden') == 'fecha_creacion' %}selected{% endif %}>Fecha creación</option>
						</select>
					</form>
				</div>


				</div>
				
				<form class="text-truncate" id="formulario-borrar-entidades" method="post">
					<div style="overflow-x: auto;">
						<table class="table table-striped table-sm full-color-table full-success-table hover-table" id="tabla-entidades">
						<thead>
							<tr>
								{% if not is_granted('ROLE_CLIENTE') and not is_granted('ROLE_COLABORADOR')  %}
									<th scope="col">
										{% if not is_granted('ROLE_CLIENTE') and not is_granted('ROLE_COLABORADOR') and not is_granted('ROLE_JEFE_INMOBILIARIA') and not is_granted('ROLE_JEFE_OFICINA') and not is_granted('ROLE_RESPONSABLE_ZONA') %}
										<div class="custom-control custom-checkbox">
											<input class="custom-control-input" id="seleccionar-todas-entidades" type="checkbox">
											<label class="custom-control-label" for="seleccionar-todas-entidades"></label>
										</div>
										{% endif %}
									</th>
								{% endif %}
								<th scope="col">Fecha</th>
								{% if not is_granted('ROLE_CLIENTE')and not is_granted('ROLE_COLABORADOR') and not is_granted('ROLE_JEFE_INMOBILIARIA') and not is_granted('ROLE_JEFE_OFICINA') and not is_granted('ROLE_RESPONSABLE_ZONA') %}
									<th scope="col">Nº Exp.</th>
								{% endif %}
								{% if not is_granted('ROLE_CLIENTE')and not is_granted('ROLE_COLABORADOR') and not is_granted('ROLE_JEFE_INMOBILIARIA') and not is_granted('ROLE_JEFE_OFICINA') and not is_granted('ROLE_RESPONSABLE_ZONA') %}
									<th scope="col">Origen</th>
								{% endif %}
								{% if not is_granted('ROLE_CLIENTE') %}
									<th scope="col">Cliente</th>
								{% endif %}
								{% if not is_granted('ROLE_CLIENTE')and not is_granted('ROLE_COLABORADOR') and not is_granted('ROLE_JEFE_INMOBILIARIA') and not is_granted('ROLE_JEFE_OFICINA') and not is_granted('ROLE_RESPONSABLE_ZONA') %}
									<th scope="col">Email</th>
									<th scope="col">Teléfono</th>
								{% endif %}
								{% if not is_granted('ROLE_CLIENTE')and not is_granted('ROLE_COLABORADOR')  %}
									<th scope="col">Inmobiliaria</th>
									<th scope="col">Oficina</th>
								{% endif %}
								<th scope="col">Acciones</th>
								<th scope="col">Inmueble</th>
								<th scope="col">Fase actual</th>
								{% if not is_granted('ROLE_CLIENTE')and not is_granted('ROLE_COLABORADOR')  %}
									<th scope="col">Estado</th>
								{% endif %}
							</tr>
						</thead>
						<tbody>
							{% for expediente in expedientes %}
								<tr>
									{% if not is_granted('ROLE_CLIENTE') and not is_granted('ROLE_COLABORADOR')  %}
										<td>
											{% if not is_granted('ROLE_CLIENTE') and not is_granted('ROLE_COLABORADOR') and not is_granted('ROLE_JEFE_INMOBILIARIA') and not is_granted('ROLE_JEFE_OFICINA') and not is_granted('ROLE_RESPONSABLE_ZONA') %}
											<div class="custom-control custom-checkbox">
												<input class="custom-control-input" id="entidad[{{ expediente.idExpediente }}]" name="expediente[]" type="checkbox" value="{{ expediente.idExpediente }}">
												<label class="custom-control-label" for="entidad[{{ expediente.idExpediente }}]"></label>
											</div>
											{% endif %}
										</td>
									{% endif %}
									<td data-order="{{ expediente.fechaCreacion|date('U') }}">{{ expediente.fechaCreacion|date('d/m/Y') }}</td>
									{% if not is_granted('ROLE_CLIENTE')and not is_granted('ROLE_COLABORADOR') and not is_granted('ROLE_JEFE_INMOBILIARIA') and not is_granted('ROLE_JEFE_OFICINA') and not is_granted('ROLE_RESPONSABLE_ZONA') %}
										<td>
											{{ expediente.idExpediente }}
											{% if expedientesRelacionados[expediente.idExpediente] is defined %}
												{% set idsRelacionados = expedientesRelacionados[expediente.idExpediente] | split(',') %}
												<span style="color:red;font-weight:bold;">[
													{% for idRelacionado in idsRelacionados %}
														<a target="_blank" href="{{ path('modificar_expediente', {'id': idRelacionado|trim}) }}">{{ idRelacionado|trim }}</a>
														{% if not loop.last %},
														{% endif %}
													{% endfor %}
													]</span>
											{% endif %}

										</td>
									{% endif %}
									{% if not is_granted('ROLE_CLIENTE')and not is_granted('ROLE_COLABORADOR') and not is_granted('ROLE_JEFE_INMOBILIARIA') and not is_granted('ROLE_JEFE_OFICINA') and not is_granted('ROLE_RESPONSABLE_ZONA') %}
										<td>{{ camposPersonalizados[expediente.idExpediente]['origen'] is defined ? camposPersonalizados[expediente.idExpediente]['origen'] : '' }}</td>
									{% endif %}
									{% if not is_granted('ROLE_CLIENTE') %}
										{% if expediente.idCliente is null %}
											<td></td>
										{% else %}
											{% set usuario = expediente.idCliente %}
											{% if usuario.apellidos|length is same as(0) %}
												{% if usuario.username|length is same as(0) %}
													{% set nombreCompleto = '' %}
												{% else %}
													{% set nombreCompleto = usuario.username %}
												{% endif %}
											{% else %}
												{% if usuario.username|length is same as(0) %}
													{% set nombreCompleto = usuario.apellidos %}
												{% else %}
													{% set nombreCompleto = usuario.apellidos ~ ', ' ~ usuario.username %}
												{% endif %}
											{% endif %}
											{% if nombreCompleto|length is not same as(0) %}
												{% set nombreCompleto = nombreCompleto  %}
											{% endif %}
											<td>{{ nombreCompleto }}</td>
										{% endif %}
									{% endif %}
									{% if not is_granted('ROLE_CLIENTE')and not is_granted('ROLE_COLABORADOR') and not is_granted('ROLE_JEFE_INMOBILIARIA') and not is_granted('ROLE_JEFE_OFICINA') and not is_granted('ROLE_RESPONSABLE_ZONA') %}
										<td>{{ camposPersonalizados[expediente.idExpediente]['email'] is defined ? camposPersonalizados[expediente.idExpediente]['email'] : '' }}</td>
										<td>{{ camposPersonalizados[expediente.idExpediente]['telefono'] is defined ? camposPersonalizados[expediente.idExpediente]['telefono'] : '' }}</td>
									{% endif %}
									{% if not is_granted('ROLE_CLIENTE') and not is_granted('ROLE_COLABORADOR')  %}
										<td>
											{% set inmuebles_nombres = [] %}
											{% if expediente.idCliente is not null and expediente.idCliente.idInmobiliaria is not null %}
												{% set inmuebles_nombres = inmuebles_nombres|merge([expediente.idCliente.idInmobiliaria.nombre]) %}
											{% endif %}
											{% if expediente.idComercial is not null and expediente.idComercial.idInmobiliaria is not null %}
												{% set inmuebles_nombres = inmuebles_nombres|merge([expediente.idComercial.idInmobiliaria.nombre]) %}
											{% endif %}
											{% if expediente.idTecnico is not null and expediente.idTecnico.idInmobiliaria is not null %}
												{% set inmuebles_nombres = inmuebles_nombres|merge([expediente.idTecnico.idInmobiliaria.nombre]) %}
											{% endif %}
											{% if expediente.idColaborador is not null and expediente.idColaborador.idInmobiliaria is not null %}
												{% set inmuebles_nombres = inmuebles_nombres|merge([expediente.idColaborador.idInmobiliaria.nombre]) %}
											{% endif %}
											{% set inmobiliarias_unicas = [] %}
											{% for nombre in inmuebles_nombres %}
												{% if nombre not in inmobiliarias_unicas %}
													{% set inmobiliarias_unicas = inmobiliarias_unicas|merge([nombre]) %}
												{% endif %}
											{% endfor %}
											{% if inmobiliarias_unicas|length > 0 %}
												{{ inmobiliarias_unicas|join(', ') }}
											{% endif %}
										</td>
										<td>
											{% set oficinas_nombres = [] %}
											{% if expediente.idCliente is not null and expediente.idCliente.idOficina is not null %}
												{% set oficinas_nombres = oficinas_nombres|merge([expediente.idCliente.idOficina.nombre]) %}
											{% endif %}
											{% if expediente.idComercial is not null and expediente.idComercial.idOficina is not null %}
												{% set oficinas_nombres = oficinas_nombres|merge([expediente.idComercial.idOficina.nombre]) %}
											{% endif %}
											{% if expediente.idTecnico is not null and expediente.idTecnico.idOficina is not null %}
												{% set oficinas_nombres = oficinas_nombres|merge([expediente.idTecnico.idOficina.nombre]) %}
											{% endif %}
											{% if expediente.idColaborador is not null and expediente.idColaborador.idOficina is not null %}
												{% set oficinas_nombres = oficinas_nombres|merge([expediente.idColaborador.idOficina.nombre]) %}
											{% endif %}
											{% set oficinas_unicas = [] %}
											{% for nombre in oficinas_nombres %}
												{% if nombre not in oficinas_unicas %}
													{% set oficinas_unicas = oficinas_unicas|merge([nombre]) %}
												{% endif %}
											{% endfor %}
											{% if oficinas_unicas|length > 0 %}
												{{ oficinas_unicas|join(', ') }}
											{% endif %}
										</td>
									{% endif %}
									<td>
										{% set totalMensajesExpediente = expedientesConMensajes[expediente.idExpediente] is defined ? expedientesConMensajes[expediente.idExpediente] : 0 %}
										{% set chatDisponible = totalMensajesExpediente > 0 %}
										{% if is_granted('ROLE_CLIENTE') or is_granted('ROLE_COLABORADOR') or is_granted('ROLE_JEFE_INMOBILIARIA') or is_granted('ROLE_JEFE_OFICINA') or is_granted('ROLE_RESPONSABLE_ZONA') %}
											{% if expediente.estado is same as(1) %}
												<a class="mr-2 seguimiento" href="{{ path('seguimiento_expediente',{'id':expediente.idExpediente}) }}" data-toggle="popover" data-content="Seguimiento" data-trigger="hover">
													<i class="fas fa-eye"></i>
													<span>Seguimiento</span>
												</a>
												<a class="mr-2 chat-expediente{% if not chatDisponible %} sin-mensajes{% endif %}" href="javascript:void(0)" data-expediente-chat="{{ expediente.idExpediente }}" data-vivienda="{{ expediente.vivienda|e('html_attr') }}" data-toggle="popover" data-content="{{ chatDisponible ? 'Mensajes disponibles' : 'Sin mensajes' }}" data-trigger="hover">
													<i class="fas fa-comments"></i>
													<span>Mensajes</span>
												</a>
												<a class="mr-2 editar" href="{{ path('modificar_expediente',{'id':expediente.idExpediente}) }}" data-toggle="popover" data-content="Editar" data-trigger="hover">
													<i class="far fa-edit"></i>
													<span>Editar</span>
												</a>
												<a class="mr-2 documentos" href="{{ path('agregar_modificar_documentos',{'id':expediente.idExpediente}) }}" data-toggle="popover" data-content="Documentos" data-trigger="hover">
													<i class="far fa-file-alt"></i>
													<span>Documentos</span>
												</a>
												<a class="mr-2 firmas" href="{{ path('lista_documentos_expediente',{'id':expediente.idExpediente,'paraFirmar':'ParaFirmar'}) }}" data-toggle="popover" data-content="Firmas" data-trigger="hover">
													<i class="fas fa-edit"></i>
													<span>Firmas</span>
												</a>
											{% endif %}
										{% else %}
											<a class="mr-2 editar" target="_blank" href="{{ path('agregar_modificar_expediente',{'id':expediente.idExpediente}) }}" data-toggle="popover" data-content="Editar" data-trigger="hover">
												<i class="far fa-edit"></i>
												<span>Editar</span>
											</a>
											<a class="mr-2 documentos" href="{{ path('agregar_modificar_documentos',{'id':expediente.idExpediente}) }}" data-toggle="popover" data-content="Documentos" data-trigger="hover">
												<i class="far fa-file-alt"></i>
												<span>Documentos</span>
											</a>
											<a class="mr-2 notificar" data-notificacion-expediente="{{ expediente.idExpediente }}" {% if expediente.idCliente is null %} data-sin-cliente {% endif %} href="javascript:void(0)" data-toggle="popover" data-content="Notificar" data-trigger="hover">
												<i class="fab fa-telegram-plane"></i>
												<span>Notificar</span>
											</a>
											<a class="mr-2 email" href="{{ path('expediente_email',{'id':expediente.idExpediente}) }}" data-toggle="popover" data-content="Enviar Email" data-trigger="hover">
												<i class="far fa-envelope"></i>
												<span>E-Mail</span>
											</a>
											<a class="mr-2 chat-expediente{% if not chatDisponible %} sin-mensajes{% endif %}" href="javascript:void(0)" data-expediente-chat="{{ expediente.idExpediente }}" data-vivienda="{{ expediente.vivienda|e('html_attr') }}" data-toggle="popover" data-content="{{ chatDisponible ? 'Mensajes disponibles' : 'Sin mensajes' }}" data-trigger="hover">
												<i class="fas fa-comments"></i>
												<span>Mensajes</span>
											</a>
											<a class="mr-2 informe" href="{{ path('informe_expediente',{'id':expediente.idExpediente}) }}" target="_blank" data-toggle="popover" data-content="Informe" data-trigger="hover">
												<i class="fas fa-info"></i>
												<span>Informe</span>
											</a>
											<a class="mr-2 pendiente" href="{{ path('informe_pendiente_expediente',{'id':expediente.idExpediente}) }}" target="_blank" data-toggle="popover" data-content="Pendiente" data-trigger="hover">
												<i class="fas fa-tasks"></i>
												<span>Pendiente</span>
											</a>
											<a class="mr-2 registro" href="{{ path('obtener_registro_expediente',{'id':expediente.idExpediente}) }}" data-toggle="popover" data-content="Registro" data-trigger="hover">
												<i class="fas fa-book"></i>
												<span>Registro</span>
											</a>
											<a class="mr-2 duplicar" data-enlace-duplicar-expediente="{{ expediente.idExpediente }}" href="{{ path('duplicar_expediente',{'id':expediente.idExpediente}) }}" data-toggle="popover" data-content="Duplicar" data-trigger="hover">
												<i class="far fa-copy"></i>
												<span>Duplicar</span>
											</a>
											<a class="mr-2 cancelar" data-cancelar-expediente="{{ expediente.idExpediente }}" {% if expediente.idCliente is null %} data-sin-cliente {% endif %} href="javascript:void(0)" data-toggle="popover" data-content="Cancelar" data-trigger="hover">
												<i class="far fa-trash-alt"></i>
												<span>Cancelar</span>
											</a>
										{% endif %}
									</td>
									<td>{{ expediente.vivienda }}</td>
									<td>
										{% set id = expediente.idFaseActual.idFase %}
										{% set numeroFase =
											id in [1,3] ? 1 :
											(id in [2,4,8] ? 2 :
												(id == 5 ? 3 :
												(id in [6,9] ? 4 :
													(id in [7,10] ? 5 : 'N/A')
												)
												)
											)
										%}
										<div class="fase-popover" data-toggle="popover" data-trigger="hover" data-content="Fase {{ numeroFase }}: {{ expediente.idFaseActual.nombre }}">
											<span class="expediente-color" style="background:{{ expediente.idFaseActual.color }}"></span>
											<span>Fase {{ numeroFase }}</span>
										</div>
									</td>
									{% if not is_granted('ROLE_CLIENTE')and not is_granted('ROLE_COLABORADOR')  %}
										{% if expediente.estado is same as(0) %}
											<td>
												Cancelado
												{% if expediente.motivoCancelacion is same as(1) %}
													por: Honorarios
												{% elseif expediente.motivoCancelacion is same as(2) %}
													por: No le mejoramos la oferta
												{% elseif expediente.motivoCancelacion is same as(3) %}
													por: Operación no viable por perfil del cliente
												{% elseif expediente.motivoCancelacion is same as(4) %}
													por: Operación no viable por tasación
												{% elseif expediente.motivoCancelacion is same as(5) %}
													por: No tienen vivienda
												{% elseif expediente.motivoCancelacion is same as(6) %}
													por: Compran después de 3 meses
												{% elseif expediente.motivoCancelacion is same as(7) %}
													por: Importe hipoteca inferior a 100.000 €
												{% elseif expediente.motivoCancelacion is same as(8) %}
													por: Lo hacen con su banco
												{% elseif expediente.motivoCancelacion is same as(9) %}
													por: Lo hacen con otra empresa intermediaria
												{% elseif expediente.motivoCancelacion is same as(10) %}
													por: Duplicado
												{% elseif expediente.motivoCancelacion is same as(11) %}
													por:
												{% endif %}
												{{ expediente.texto }}
											</td>
										{% elseif expediente.estado is same as(1) %}
											<td>Activo</td>
										{% elseif expediente.estado is same as(2) %}
											<td>Firmado</td>
										{% else %}
											<td></td>
										{% endif %}
									{% endif %}
								</tr>
							{% endfor %}
						</tbody>
					</table>
					</div>
					
					<!-- Mensaje y botón en la misma línea -->
					<div class="row align-items-center mt-3 mb-3">
						<div class="col-md-6">
							<p class="text-muted mb-0">
								Mostrando registros del {{ ((currentPage - 1) * limit) + 1 }} al {{ min(currentPage * limit, totalExpedientes) }} de un total de {{ totalExpedientes }} registros (filtrado de un total de {{ totalExpedientes }} registros)
							</p>
						</div>
						<div class="col-md-6 text-right">
                            <!-- Paginación -->
                            {% if totalPages > 1 %}
                            <nav aria-label="Paginación de expedientes" class="mt-3">
                                <ul class="pagination justify-content-end">
                                    <li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
                                        <a class="page-link" href="{{ path('lista_expedientes_paginacion', app.request.query.all|merge({'page': 1})) }}">
                                            <i class="fas fa-angle-double-left"></i>
                                        </a>
                                    </li>
                                    <li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
                                        <a class="page-link" href="{{ path('lista_expedientes_paginacion', app.request.query.all|merge({'page': currentPage - 1})) }}">
                                            Anterior
                                        </a>
                                    </li>
                                    
                                    {% set startPage = max(1, currentPage - 2) %}
                                    {% set endPage = min(totalPages, currentPage + 2) %}
                                    
                                    {% if startPage > 1 %}
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    {% endif %}
                                    
                                    {% for page in startPage..endPage %}
                                        <li class="page-item {% if page == currentPage %}active{% endif %}">
                                            <a class="page-link" href="{{ path('lista_expedientes_paginacion', app.request.query.all|merge({'page': page})) }}">
                                                {{ page }}
                                            </a>
                                        </li>
                                    {% endfor %}
                                    
                                    {% if endPage < totalPages %}
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    {% endif %}
                                    
                                    <li class="page-item {% if currentPage == totalPages %}disabled{% endif %}">
                                        <a class="page-link" href="{{ path('lista_expedientes_paginacion', app.request.query.all|merge({'page': currentPage + 1})) }}">
                                            Siguiente
                                        </a>
                                    </li>
                                    <li class="page-item {% if currentPage == totalPages %}disabled{% endif %}">
                                        <a class="page-link" href="{{ path('lista_expedientes_paginacion', app.request.query.all|merge({'page': totalPages})) }}">
                                            <i class="fas fa-angle-double-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                            {% endif %}
							
						</div>
                        <div class="col-md-22">
                            {% if not is_granted('ROLE_CLIENTE') and not is_granted('ROLE_COLABORADOR') and not is_granted('ROLE_JEFE_INMOBILIARIA') and not is_granted('ROLE_JEFE_OFICINA') and not is_granted('ROLE_RESPONSABLE_ZONA') %}
								<button class="btn btn-success waves-effect" id="boton-borrar-entidades">Borrar marcados</button>
							{% endif %}
                        </div>
					</div>
				</form>
				
				
				
			{% else %}
				<div class="alert alert-info" role="alert">
					<span>No hay expedientes pendientes.</span>
				</div>
			{% endif %}
		</div>
	</div>
{% endblock %}
{% block modals %}
	{{ parent() }}
	{% include '@App/Backoffice/Modal/ConfirmarBorrar.html' %}
	{% include '@App/Backoffice/Modal/ConfirmarDuplicar.html' %}
	{% include '@App/Backoffice/Modal/NotificacionExpediente.html.twig' %}
	{% include '@App/Backoffice/Modal/CancelarExpediente.html.twig' %}

	<div class="modal fade" id="modal-chat-expediente" tabindex="-1" role="dialog" aria-labelledby="chat-expediente-titulo" aria-hidden="true">
		<div class="modal-dialog modal-lg" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="chat-expediente-titulo">Mensajes del expediente</h5>
					<button type="button" class="close" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>
				<div class="modal-body">
					<p class="text-muted mb-3" id="chat-expediente-subtitulo"></p>
					<div id="chat-expediente-contenido">
						<div class="chat-expediente-vacio">Todavía no hay mensajes para este expediente.</div>
					</div>
				</div>
				<div class="modal-footer d-block">
					<div id="chat-expediente-alerta" class="alert d-none mb-2"></div>
					<input type="hidden" id="chat-expediente-id" value="">
					<div class="form-group mb-2">
						<label for="chat-expediente-respuesta">Responder manualmente</label>
						<textarea class="form-control" id="chat-expediente-respuesta" rows="10" placeholder="Escribe aquí la respuesta para enviar al cliente desde Kommo"></textarea>
						<small class="form-text text-muted mt-1">
							<i class="fas fa-lightbulb"></i> Usa el botón "Solicitar Sugerencia IA" para obtener una respuesta automática basada en la conversación.
						</small>
						<!-- Indicador de carga de sugerencia IA -->
						<div id="chat-expediente-cargando-ia" class="alert alert-info d-none mt-2 mb-0" role="alert">
							<div class="spinner-border spinner-border-sm mr-2" role="status">
								<span class="sr-only">Cargando...</span>
							</div>
							<span>Obteniendo sugerencia de IA...</span>
						</div>
						<!-- Información de tokens utilizados -->
						<div id="chat-expediente-info-tokens" class="alert alert-light d-none mt-2 mb-0" role="alert">
							<small>
								<strong>Tokens utilizados:</strong> 
								<span id="chat-expediente-tokens-info"></span>
							</small>
						</div>
					</div>
					<div class="text-right">
						<button type="button" class="btn btn-outline-secondary mr-2" id="chat-expediente-sugerir">
							<i class="fas fa-magic"></i> Solicitar Sugerencia IA
						</button>
						<button type="button" class="btn btn-primary" id="chat-expediente-enviar">
							<i class="fas fa-paper-plane"></i> Enviar a Kommo
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}