			padding: 2px 5px;
			border-radius: 5px;
			color: red;
			background: white;
			font-size: 18px;
		}

		a.email {
			border: 2px solid gray;
			padding: 2px 5px;
			border-radius: 5px;
			color: gray;
			background: white;
			font-size: 18px;
		}
		a.informe {
			border: 2px solid orange;
			padding: 2px 10px;
			border-radius: 5px;
			color: orange;
			background: white;
			font-size: 18px;
		}

		a.contrato {
			border: 2px solid cornflowerblue;
			padding: 2px 10px;
			border-radius: 5px;
			color: cornflowerblue;
			background: white;
			font-size: 18px;
		}

		a.pendiente,
