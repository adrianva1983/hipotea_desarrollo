{% block customscripts %}
	{{ parent() }}
	<script>
		$(function () {
			'use strict';
			
			// DEBUG: Contar opciones antes de inicializar Select2
			var countClientes = $('#clientes option').length;
			//console.log('Opciones de clientes en HTML:', countClientes);
			$('#count-clientes').text(countClientes);
			
			// IMPORTANTE: Destruir TODAS las instancias de Select2 antes de inicializar
			$('select').each(function() {
				if ($(this).data('select2')) {
					$(this).select2('destroy');
				}
			});
			
			// Esperar un momento antes de reinicializar
			setTimeout(function() {
				// Inicializar todos los select2
				$('.select2').each(function() {
					var placeholderText = $(this).data('placeholder') || '';
					var isMultiple = $(this).attr('multiple') !== undefined;
					
					//console.log('Inicializando select:', $(this).attr('id'), 'con', $(this).find('option').length, 'opciones, multiple:', isMultiple);
					
					$(this).select2({
						language: 'es',
						placeholder: placeholderText,
						allowClear: true,
						width: '100%',
						closeOnSelect: !isMultiple
					});
				});
				
				//console.log('Select2 inicializado correctamente');
			}, 100);
			
			$('[data-toggle="popover"]').popover();
			
			// Manejar selección de todos los checkboxes
			$('#seleccionar-todas-entidades').on('change', function() {
				$('input[name="expediente[]"]').prop('checked', $(this).prop('checked'));
			});
			
			// Si se desmarca alguno individualmente, desmarcar el "seleccionar todos"
			$(document).on('change', 'input[name="expediente[]"]', function() {
				if (!$(this).prop('checked')) {
					$('#seleccionar-todas-entidades').prop('checked', false);
				} else {
					// Si todos están marcados, marcar el "seleccionar todos"
					if ($('input[name="expediente[]"]:checked').length === $('input[name="expediente[]"]').length) {
						$('#seleccionar-todas-entidades').prop('checked', true);
					}
				}
			});
			
			// Funcionalidad de búsqueda global con debounce
			var searchTimeout;
			$('#buscar-tabla').on('keyup', function() {
				clearTimeout(searchTimeout);
				var valor = $(this).val();
				
				// Si el campo está vacío, no hacer búsqueda
				if (valor.length === 0) {
					return;
				}
				
				// Esperar 500ms después de que el usuario deje de escribir
				searchTimeout = setTimeout(function() {
					// Obtener la URL actual y agregar el parámetro de búsqueda
					var url = new URL(window.location.href);
					url.searchParams.set('buscar', valor);
					url.searchParams.set('page', '1'); // Resetear a la página 1
					
					// Redirigir a la URL con el parámetro de búsqueda
					window.location.href = url.toString();
				}, 500);
			});
			
			// Limpiar búsqueda si se borra el campo
			$('#buscar-tabla').on('search', function() {
				if ($(this).val() === '') {
					var url = new URL(window.location.href);
					url.searchParams.delete('buscar');
					window.location.href = url.toString();
				}
			});
		});

		function rutaDuplicarExpediente() {
			return '{{ path('duplicar_expediente',{'id':' '}) }}';
		}

		function rutaNotificacionExpediente() {
			return '{{ path('notificacion_expediente',{'id':' '}) }}';
		}

		function rutaCancelarExpediente() {
			return '{{ path('cancelar_expediente',{'id':' '}) }}';
		}
		
		function cambiarLimit(nuevoLimit) {
			// Obtener la URL actual con todos sus parámetros
			var url = new URL(window.location.href);
			
			// Actualizar el parámetro limit
			url.searchParams.set('limit', nuevoLimit);
			
			// Resetear a la página 1 al cambiar el límite
			url.searchParams.set('page', '1');
			
			// Redirigir a la nueva URL
			window.location.href = url.toString();
		}
		
		// Manejo de botones de estado (Cancelados, Activos, Firmados)
		$(function() {
			// Función para aplicar estilos al botón según el estado
			function aplicarEstiloBotón(estado) {
				//console.log('Aplicando estilo al estado:', estado);
				// Remover estilos de todos los botones
				$('.estado-btn').removeAttr('style').removeClass('active');
				
				// Buscar el botón con el estado y aplicar estilo
				var botón = $('.estado-btn[data-estado="' + estado + '"]');
				if (botón.length) {
					//console.log('Botón encontrado para estado:', estado);
					if (estado == '0') {
						botón.css({'background-color': '#dc3545', 'color': 'white'});
					} else if (estado == '1') {
						botón.css({'background-color': '#28a745', 'color': 'white'});
					} else if (estado == '2') {
						botón.css({'background-color': '#007bff', 'color': 'white'});
					} 
				}
			}
			
			// Al cargar la página, activar el botón correspondiente al valor del input oculto
			var estadoActual = $('#estado-filtro').val();
			//console.log('Estado actual del input oculto:', estadoActual);
			
			// Si no hay estado o está vacío, usar '1' (Activos) por defecto
			if (!estadoActual || estadoActual === '') {
				estadoActual = '1';
				$('#estado-filtro').val('1');
			}
			
			aplicarEstiloBotón(estadoActual);
			
			// Evento click en los botones
			$('.estado-btn').on('click', function() {
				var estado = $(this).data('estado');
				//console.log('Click en botón con estado:', estado);
				
				// Aplicar estilos al botón clickeado
				aplicarEstiloBotón(estado);
				
				// Actualizar el valor del input oculto
				$('#estado-filtro').val(estado);
			});
		});
	</script>
	<script>
		// Función para abrir el modal de WhatsApp y cargar mensajes
		function abrirModalWhatsApp(expedienteId, clientName) {
			console.log('abriendo modal WhatsApp para expediente:', expedienteId);
			
			// Actualizar título con el nombre del cliente
			if (clientName) {
				$('#modal-whatsapp-titulo').text(clientName);
			} else {
				$('#modal-whatsapp-titulo').text('WhatsApp Hipotea');
			}

			var innerContainer = $('#whatsapp-messages-inner');
			var outerContainer = $('#whatsapp-messages-container');
			
			// Mostrar el modal
			$('#modal-whatsapp-messages').modal('show');
			
			// Guardar el expedienteId en el input oculto
			$('#whatsapp-expediente-id').val(expedienteId);
			
			// Limpiar input de mensaje
			$('#whatsapp-message-input').val('').focus();
			
			// Mostrar spinner
			innerContainer.html('<div class="text-center text-muted mt-5"><i class="fas fa-spinner fa-spin"></i> Cargando conversaciones...</div>');
			
			// Construir URL correctamente
			var baseUrl = '{{ path('api_get_whatsapp_messages', {'id': '0'}) }}';
			var url = baseUrl.replace('/0', '/' + expedienteId);
			
			// Cargar conversaciones vía AJAX
			$.ajax({
				url: url,
				type: 'GET',
				dataType: 'json',
				success: function(data) {
					innerContainer.empty();
					
					var messages = Array.isArray(data) ? data : (data.messages || []);
					
					if (!messages || messages.length === 0) {
						innerContainer.html('<div class="alert alert-info" style="background: #fff; border:none; border-radius: 7.5px; box-shadow: 0 1px 0.5px rgba(0,0,0,.13);">No hay mensajes WhatsApp para este expediente.</div>');
						return;
					}
					
					var messagesHtml = '';
					var lastDirection = null;

					messages.forEach(function(msg) {
						var direction = msg.direction === 'enviado' ? 'enviado' : 'recibido';
						var hasTail = (direction !== lastDirection);
						
						// Formatear timestamp
						var timeStr = '';
						if (msg.timestamp) {
							var date = new Date(msg.timestamp);
							var hh = String(date.getHours()).padStart(2, '0');
							var mm = String(date.getMinutes()).padStart(2, '0');
							timeStr = hh + ':' + mm;
						}
						
						var text = msg.message || '';
						
						// Escapar HTML básico
						var textEscaped = $('<div/>').text(text).html();

						messagesHtml += '<div class="whatsapp-message-row ' + direction + (hasTail ? '' : ' no-tail') + '">' +
							'<div class="whatsapp-bubble ' + direction + '">' +
								'<div class="whatsapp-text">' + textEscaped + '</div>' +
								'<div class="whatsapp-meta">' +
									'<span class="whatsapp-time">' + timeStr + '</span>';
						
						if (direction === 'enviado') {
							messagesHtml += '<span class="whatsapp-check"><i class="fas fa-check-double"></i></span>';
						}
						
						messagesHtml += '</div>' + // meta
							'</div>' + // bubble
						'</div>'; // row
						
						lastDirection = direction;
					});
					
					innerContainer.html(messagesHtml);
					
					// Scroll al final
					setTimeout(function() {
						outerContainer.scrollTop(outerContainer[0].scrollHeight);
					}, 100);
					
					// Iniciar polling para nuevos mensajes cada 10 segundos
					iniciarPollingMensajesWhatsApp(expedienteId);
				},
				error: function(xhr) {
					innerContainer.html('<div class="alert alert-danger">Error al cargar los mensajes.</div>');
				}
			});
		}
		
		// Función para enviar mensaje
		function enviarMensajeWhatsApp() {
			var expedienteId = $('#whatsapp-expediente-id').val();
			var texto = $('#whatsapp-message-input').val().trim();
			
			if (!texto) {
				console.log('Por favor escribe un mensaje');
				return;
			}
			
			if (!expedienteId) {
				console.log('Error: expediente no identificado');
				return;
			}
			
			var btn = $('#whatsapp-send-btn');
			btn.prop('disabled', true).css('opacity', '0.5');
			
			$.ajax({
				url: '{{ path('api_send_whatsapp_message') }}',
				type: 'POST',
				dataType: 'json',
				contentType: 'application/json',
				headers: {
					'X-API-KEY': '123456'
				},
				data: JSON.stringify({
					id_expediente: parseInt(expedienteId),
					text: texto
				}),
				success: function(data) {
					console.log('Mensaje enviado:', data);
					$('#whatsapp-message-input').val('');
					var clientName = $('#modal-whatsapp-titulo').text();
					abrirModalWhatsApp(expedienteId, clientName);
				},
				error: function(xhr) {
					console.error('Error al enviar:', xhr);
					var errorMsg = 'Error desconocido';
					if (xhr.responseJSON && xhr.responseJSON.error) {
						errorMsg = xhr.responseJSON.error;
					}
					console.log('Error al enviar el mensaje: ' + errorMsg);
				},
				complete: function() {
					btn.prop('disabled', false).css('opacity', '1');
				}
			});
		}
		
		$(document).on('click', '#whatsapp-send-btn', function() {
			enviarMensajeWhatsApp();
		});
		
		$(document).on('keypress', '#whatsapp-message-input', function(e) {
			if (e.which === 13) {
				enviarMensajeWhatsApp();
				return false;
			}
		});

		// Variable global para mantener el intervalo de polling
		var whatsappPollingInterval = null;
		var ultimosHashMensajes = null;
		
		// Función para iniciar polling cada 10 segundos
		function iniciarPollingMensajesWhatsApp(expedienteId) {
			// Detener polling anterior si existe
			if (whatsappPollingInterval) {
				clearInterval(whatsappPollingInterval);
			}
			
			// Iniciar nuevo polling
			whatsappPollingInterval = setInterval(function() {
				// Solo continuar si el modal está visible
				if (!$('#modal-whatsapp-messages').is(':visible')) {
					clearInterval(whatsappPollingInterval);
					whatsappPollingInterval = null;
					return;
				}
				
				var baseUrl = '{{ path('api_get_whatsapp_messages', {'id': '0'}) }}';
				var url = baseUrl.replace('/0', '/' + expedienteId);
				
				$.ajax({
					url: url,
					type: 'GET',
					dataType: 'json',
					success: function(data) {
						var innerContainer = $('#whatsapp-messages-inner');
						var outerContainer = $('#whatsapp-messages-container');
						
						var messages = Array.isArray(data) ? data : (data.messages || []);
						
						if (!messages || messages.length === 0) {
							return;
						}
						
						// Crear hash de mensajes para detectar cambios
						var hashActual = JSON.stringify(messages);
						
						// Si hay cambios, actualizar el listado
						if (hashActual !== ultimosHashMensajes) {
							ultimosHashMensajes = hashActual;
							
							var messagesHtml = '';
							var lastDirection = null;

							messages.forEach(function(msg) {
								var direction = msg.direction === 'enviado' ? 'enviado' : 'recibido';
								var hasTail = (direction !== lastDirection);
								
								// Formatear timestamp
								var timeStr = '';
								if (msg.timestamp) {
									var date = new Date(msg.timestamp);
									var hh = String(date.getHours()).padStart(2, '0');
									var mm = String(date.getMinutes()).padStart(2, '0');
									timeStr = hh + ':' + mm;
								}
								
								var text = msg.message || '';
								
								// Escapar HTML básico
								var textEscaped = $('<div/>').text(text).html();

								messagesHtml += '<div class="whatsapp-message-row ' + direction + (hasTail ? '' : ' no-tail') + '">' +
									'<div class="whatsapp-bubble ' + direction + '">' +
										'<div class="whatsapp-text">' + textEscaped + '</div>' +
										'<div class="whatsapp-meta">' +
											'<span class="whatsapp-time">' + timeStr + '</span>';
								
								if (direction === 'enviado') {
									messagesHtml += '<span class="whatsapp-check"><i class="fas fa-check-double"></i></span>';
								}
								
								messagesHtml += '</div>' + // meta
									'</div>' + // bubble
								'</div>'; // row
								
								lastDirection = direction;
							});
							
							innerContainer.html(messagesHtml);
							
							// Scroll al final
							setTimeout(function() {
								outerContainer.scrollTop(outerContainer[0].scrollHeight);
							}, 100);
						}
					},
					error: function(xhr) {
						// Silenciosamente ignorar errores de polling
					}
				});
			}, 10000); // Cada 10 segundos
		}
		
		// Detener polling al cerrar el modal
		$('#modal-whatsapp-messages').on('hidden.bs.modal', function() {
			if (whatsappPollingInterval) {
				clearInterval(whatsappPollingInterval);
				whatsappPollingInterval = null;
				ultimosHashMensajes = null;
			}
		});

		$(document).ready(function() {
			// Código que necesita DOM listo
		});
	</script>
	<script src="{{ asset('assets/js/custom/lista-expedientes.min.js') }}"></script>
	<script src="{{ asset('assets/js/custom/notificacion-expediente.js') }}"></script>
	<script src="{{ asset('assets/js/custom/cancelar-expediente.js') }}"></script>
