	<link href="{{ asset('assets/css/custom/select2.min.css') }}" rel="stylesheet">
	<link href="{{ asset('assets/css/custom/lista-expedientes.min.css') }}" rel="stylesheet">
	<style>
		#tabla-entidades {
			max-width: 100% !important;
		}

		#tabla-entidades thead th:nth-child(1),
		#tabla-entidades thead th:nth-child(2),
		#tabla-entidades thead th:nth-child(3),
		#tabla-entidades thead th:nth-child(4),
		#tabla-entidades thead th:nth-child(5),
		#tabla-entidades thead th:nth-child(6),
		#tabla-entidades thead th:nth-child(7),
		#tabla-entidades thead th:nth-child(8),
		#tabla-entidades thead th:nth-child(9),
		#tabla-entidades thead th:nth-child(10),
		#tabla-entidades thead th:nth-child(11),
		#tabla-entidades thead th:nth-child(12),
		#tabla-entidades thead th:nth-child(13),
		#tabla-entidades thead th:nth-child(14),
		#tabla-entidades thead th:nth-child(15),
