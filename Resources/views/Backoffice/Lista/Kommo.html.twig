{% extends '@App/Backoffice/base.html.twig' %}

{% block customstyles %}
    {{ parent() }}
    <style>
        .stat-card {
            border-left: 4px solid #007bff;
            padding: 20px;
            margin-bottom: 15px;
            background: #f8f9fa;
            border-radius: 4px;
        }
        
        .stat-card.success { border-left-color: #28a745; }
        .stat-card.danger { border-left-color: #dc3545; }
        .stat-card.info { border-left-color: #17a2b8; }
        
        .stat-card h5 {
            margin-bottom: 10px;
            color: #666;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .stat-card h3 {
            margin: 0;
            color: #333;
        }
        
        .filter-card {
            background: #f8f9fa;
            border: 1px solid #dee2e6;
        }
        
        .table-webhook {
            font-size: 13px;
        }
        
        .badge-event {
            background: #007bff;
            color: white;
            padding: 5px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 500;
        }
        
        .json-modal {
            max-height: 500px;
            overflow-y: auto;
            background: #f5f5f5;
            padding: 15px;
            border-radius: 4px;
            font-family: 'Courier New', monospace;
            font-size: 12px;
        }
        
        .pagination-info {
            text-align: center;
            margin-top: 10px;
            color: #666;
            font-size: 12px;
        }
    </style>
{% endblock %}

{% block customscripts %}
    {{ parent() }}
    <script>
        $(function() {
            $('[data-toggle="tooltip"]').tooltip();
            
            // Cargar JSON en modal
            $('#modalJSON').on('show.bs.modal', function(e) {
                const button = $(e.relatedTarget);
                const json = button.data('json');
                const id = button.data('id');
                const tipo = button.data('tipo');
                const fecha = button.data('fecha');
                
                $('#modalId').text(id);
                $('#modalTipo').text(tipo);
                $('#modalFecha').text(fecha);
                
                try {
                    const jsonFormatted = JSON.stringify(json, null, 2);
                    $('#modalJSONContent').text(jsonFormatted);
                } catch(e) {
                    $('#modalJSONContent').text(JSON.stringify(json));
                }
            });
            
            // Copiar JSON
            $('#btnCopiarJSON').on('click', function() {
                const content = $('#modalJSONContent').text();
                navigator.clipboard.writeText(content).then(function() {
                    alert('JSON copiado al portapapeles');
                });
            });
            
            // Limpiar webhooks
            $('#btnLimpiar').on('click', function() {
                const dias = $(this).data('dias');
                $('#diasLimpiar').text(dias + ' días');
                $('#modalLimpiar').modal('show');
            });
            
            // Confirmar limpiar
            $('#btnConfirmarLimpiar').on('click', function() {
                const dias = $('#btnLimpiar').data('dias');
                
                $.ajax({
                    url: '{{ path("admin_kommo_limpiar") }}',
                    type: 'POST',
                    data: { dias: dias },
                    dataType: 'json',
                    success: function(response) {
                        if(response.ok) {
                            alert('Se eliminaron ' + response.eliminados + ' registros');
                            location.reload();
                        } else {
                            alert('Error: ' + response.mensaje);
                        }
                    },
                    error: function() {
                        alert('Error al conectar con el servidor');
                    }
                });
                $('#modalLimpiar').modal('hide');
            });
        });
    </script>
{% endblock %}

{% block body %}
<div class="card">
    <div class="card-body">
        {% include '@App/Backoffice/MensajeAlerta.html.twig' %}
        
        <!-- ENCABEZADO -->
        <div class="row mb-4 align-items-center">
            <div class="col-md-8">
                <h4 class="card-title">
                    <i class="fas fa-webhook"></i> Webhooks de Kommo
                </h4>
            </div>
            <div class="col-md-4 text-right">
                <button class="btn btn-danger btn-sm" id="btnLimpiar" data-dias="90">
                    <i class="fas fa-trash"></i> Limpiar &gt;90 días
                </button>
            </div>
        </div>

        <!-- ESTADÍSTICAS -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="stat-card">
                    <h5>Total Recibidos</h5>
                    <h3>{{ estadisticas.total }}</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card success">
                    <h5>Procesados</h5>
                    <h3>{{ estadisticas.procesados }}</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card danger">
                    <h5>Errores</h5>
                    <h3>{{ estadisticas.errores }}</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card info">
                    <h5>Porcentaje Éxito</h5>
                    <h3>{{ estadisticas.porcentajeExito }}%</h3>
                </div>
            </div>
        </div>

        <!-- FILTROS -->
        <div class="card filter-card mb-3">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-filter"></i> Filtros de búsqueda
                </h5>
            </div>
            <div class="card-body">
                <form method="GET" id="formFiltros">
                    <div class="row">
                        <!-- Tipo de webhook -->
                        <div class="col-md-2 mb-3">
                            <label for="tipo">Tipo:</label>
                            <select name="tipo" id="tipo" class="form-control form-control-sm">
                                <option value="">Todos</option>
                                {% for tipo in tiposUnicos %}
                                    <option value="{{ tipo }}" {% if filtro.tipo == tipo %}selected{% endif %}>
                                        {{ tipo }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <!-- Estado -->
                        <div class="col-md-2 mb-3">
                            <label for="estado">Estado:</label>
                            <select name="estado" id="estado" class="form-control form-control-sm">
                                <option value="">Todos</option>
                                <option value="procesado" {% if filtro.estado == 'procesado' %}selected{% endif %}>Procesado</option>
                                <option value="error" {% if filtro.estado == 'error' %}selected{% endif %}>Error</option>
                            </select>
                        </div>

                        <!-- Fecha inicio -->
                        <div class="col-md-2 mb-3">
                            <label for="fechaInicio">Desde:</label>
                            <input type="date" name="fechaInicio" id="fechaInicio" class="form-control form-control-sm" 
                                   value="{{ filtro.fechaInicio }}">
                        </div>

                        <!-- Fecha fin -->
                        <div class="col-md-2 mb-3">
                            <label for="fechaFin">Hasta:</label>
                            <input type="date" name="fechaFin" id="fechaFin" class="form-control form-control-sm"
                                   value="{{ filtro.fechaFin }}">
                        </div>

                        <!-- Búsqueda -->
                        <div class="col-md-2 mb-3">
                            <label for="busqueda">Búsqueda:</label>
                            <input type="text" name="busqueda" id="busqueda" placeholder="ID Kommo..." 
                                   class="form-control form-control-sm" value="{{ filtro.busqueda }}">
                        </div>

                        <!-- Botones -->
                        <div class="col-md-2 mb-3">
                            <label>&nbsp;</label>
                            <button type="submit" class="btn btn-primary btn-sm btn-block">
                                <i class="fas fa-search"></i> Filtrar
                            </button>
                        </div>
                    </div>
                </form>
                <a href="{{ path('admin_kommo_webhooks') }}" class="btn btn-secondary btn-sm">
                    <i class="fas fa-redo"></i> Limpiar filtros
                </a>
            </div>
        </div>

        <!-- TABLA DE WEBHOOKS -->
        <div class="table-responsive">
            <table class="table table-hover table-sm table-webhook">
                <thead class="table-light">
                    <tr>
                        <th width="10%">ID</th>
                        <th width="20%">Fecha</th>
                        <th width="15%">Tipo</th>
                        <th width="20%">Kommo ID</th>
                        <th width="15%">Estado</th>
                        <th width="20%">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% if webhooks %}
                        {% for webhook in webhooks %}
                        <tr>
                            <td>
                                <code>#{{ webhook.id }}</code>
                            </td>
                            <td>
                                <small class="text-muted">
                                    {{ webhook.fecha|date('d/m/Y H:i:s') }}
                                </small>
                            </td>
                            <td>
                                <span class="badge-event">{{ webhook.webhookType }}</span>
                            </td>
                            <td>
                                <code class="text-muted">{{ webhook.kommoId }}</code>
                            </td>
                            <td>
                                {% if webhook.estado == 'procesado' %}
                                    <span class="badge badge-success">✓ OK</span>
                                {% elseif webhook.estado == 'error' %}
                                    <span class="badge badge-danger">✗ Error</span>
                                {% else %}
                                    <span class="badge badge-secondary">-</span>
                                {% endif %}
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-info" 
                                        data-toggle="modal" data-target="#modalJSON" 
                                        data-json="{{ webhook.jsonRecibido|json_encode }}"
                                        data-id="{{ webhook.id }}"
                                        data-tipo="{{ webhook.webhookType }}"
                                        data-fecha="{{ webhook.fecha|date('d/m/Y H:i:s') }}"
                                        title="Ver JSON">
                                    <i class="fas fa-eye"></i> Ver
                                </button>
                                {% if webhook.estado == 'error' and webhook.errorMensaje %}
                                    <button type="button" class="btn btn-sm btn-warning" 
                                            data-toggle="tooltip" 
                                            title="{{ webhook.errorMensaje }}"
                                            data-placement="left">
                                        <i class="fas fa-exclamation-triangle"></i>
                                    </button>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="fas fa-inbox"></i> No hay webhooks
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>

        <!-- PAGINACIÓN -->
        {% if pagination.totalPages > 1 %}
        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                {% if pagination.previousUrl %}
                    <li class="page-item">
                        <a class="page-link" href="{{ pagination.previousUrl }}">
                            <i class="fas fa-chevron-left"></i> Anterior
                        </a>
                    </li>
                {% else %}
                    <li class="page-item disabled">
                        <span class="page-link"><i class="fas fa-chevron-left"></i> Anterior</span>
                    </li>
                {% endif %}

                <li class="page-item active">
                    <span class="page-link">
                        Página {{ pagination.currentPage }} de {{ pagination.totalPages }}
                    </span>
                </li>

                {% if pagination.nextUrl %}
                    <li class="page-item">
                        <a class="page-link" href="{{ pagination.nextUrl }}">
                            Siguiente <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                {% else %}
                    <li class="page-item disabled">
                        <span class="page-link">Siguiente <i class="fas fa-chevron-right"></i></span>
                    </li>
                {% endif %}
            </ul>
        </nav>
        <div class="pagination-info">
            Mostrando {% if webhooks|length > 0 %}{{ (pagination.currentPage - 1) * 20 + 1 }}{% endif %} - {% if webhooks|length > 0 %}{{ (pagination.currentPage - 1) * 20 + webhooks|length }}{% endif %} de {{ pagination.totalPages * 20 }}
        </div>
        {% endif %}
    </div>
</div>

<!-- MODAL VER JSON -->
<div class="modal fade" id="modalJSON" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Webhook <span id="modalTipo" class="badge badge-info"></span> - ID: <code id="modalId"></code>
                </h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label><strong>Fecha:</strong></label>
                    <p class="text-muted mb-0" id="modalFecha"></p>
                </div>
                <hr>
                <div class="form-group">
                    <label><strong>JSON:</strong></label>
                    <pre id="modalJSONContent" class="json-modal"></pre>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnCopiarJSON">
                    <i class="fas fa-copy"></i> Copiar JSON
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL CONFIRMACIÓN LIMPIAR -->
<div class="modal fade" id="modalLimpiar" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title">
                    <i class="fas fa-trash"></i> Limpiar Webhooks
                </h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>¿Deseas eliminar todos los webhooks más antiguos de <strong id="diasLimpiar">90 días</strong>?</p>
                <p class="text-danger mb-0">
                    <i class="fas fa-exclamation-circle"></i> Esta acción no se puede deshacer.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="btnConfirmarLimpiar">
                    <i class="fas fa-trash"></i> Eliminar
                </button>
            </div>
        </div>
    </div>
</div>

{% endblock %}
