{% extends '@App/Frontoffice/base_pdf.html.twig' %}

{% block customscripts %}
	{{ parent() }}
{% endblock %}

{% block customstyles %}
	<style>
		* {
			box-sizing: border-box;
		}

		body {
			margin: 0;
			padding: 0;
			background: #f8fafc;
			font-family: Arial, Helvetica, sans-serif;
			color: #334155;
		}

		.page-wrap {
			padding: 12px;
		}

		.container {
			width: 100%;
			max-width: 1140px;
			margin: 0 auto;
		}

		.header {
			margin-bottom: 10px;
			width: 100%;
			border-collapse: collapse;
		}

		.header-title {
			font-size: 24px;
			line-height: 1.2;
			font-weight: 700;
			color: #334155;
		}

		.header-right {
			text-align: right;
			white-space: nowrap;
		}

		.btn-ghost {
			display: inline-block;
			border: 1px solid #e2e8f0;
			border-radius: 18px;
			padding: 6px 12px;
			font-size: 12px;
			font-weight: 600;
			color: #94a3b8;
			background: #ffffff;
			vertical-align: middle;
		}

		.btn-dots {
			display: inline-block;
			margin-left: 10px;
			color: #94a3b8;
			font-size: 18px;
			line-height: 1;
			font-weight: 700;
			vertical-align: middle;
		}

		.main-grid {
			width: 100%;
			border-collapse: separate;
			border-spacing: 10px 0;
			margin-bottom: 10px;
		}

		.main-grid td {
			vertical-align: top;
			width: 50%;
		}

		.card {
			background: #ffffff;
			border: 1px solid #e6edf5;
			border-radius: 12px;
			padding: 14px 16px;
			min-height: 252px;
		}

		.card-title {
			font-size: 18px;
			line-height: 1.2;
			font-weight: 700;
			color: #334155;
			margin-bottom: 14px;
		}

		.row-viability {
			width: 100%;
			border-collapse: collapse;
			margin-bottom: 12px;
		}

		.row-viability td {
			vertical-align: middle;
		}

		.row-viability td:first-child {
			width: 88px;
		}

		.badge {
			width: 72px;
			height: 72px;
			border-radius: 36px;
			background: #22c55e;
			text-align: center;
			line-height: 72px;
			font-size: 42px;
			font-weight: 800;
			color: #ffffff;
		}

		.viability-text {
			font-size: 30px;
			line-height: 1;
			font-weight: 800;
			color: #22c55e;
		}

		.description {
			font-size: 16px;
			line-height: 1.5;
			color: #64748b;
		}

		.criteria-table {
			width: 100%;
			border-collapse: collapse;
		}

		.criteria-table td {
			padding: 7px 0;
			font-size: 14px;
			line-height: 1.2;
			border-bottom: 1px solid #f1f5f9;
		}

		.criteria-table td:first-child {
			color: #64748b;
		}

		.criteria-table td:last-child {
			text-align: right;
			font-weight: 700;
			color: #334155;
		}

		.ok {
			color: #22c55e !important;
		}

		.group-title {
			font-size: 14px;
			line-height: 1.2;
			font-weight: 700;
			color: #1f2a37;
			margin: 8px 0 4px;
		}

		.group-title .person-icon {
			display: inline-block;
			width: 11px;
			height: 11px;
			border-radius: 50%;
			background: #6d28d9;
			margin-right: 5px;
			vertical-align: -1px;
		}

		.footer-row {
			margin-top: 7px;
			padding-top: 7px;
			border-top: 1px solid #e2e8f0;
		}

		.footer-row table {
			width: 100%;
			border-collapse: collapse;
		}

		.footer-row td {
			vertical-align: middle;
		}

		.footer-row td:first-child {
			font-size: 16px;
			font-weight: 700;
			color: #334155;
		}

		.footer-row td:last-child {
			text-align: right;
			font-size: 15px;
			font-weight: 800;
			color: #334155;
		}

		.footer-value-wrap {
			display: inline-block;
			vertical-align: middle;
		}

		.ring-wrap {
			display: inline-block;
			width: 42px;
			height: 42px;
			margin-left: 8px;
			vertical-align: middle;
			position: relative;
		}

		.ring-wrap svg {
			width: 42px;
			height: 42px;
		}

		.ring-text {
			position: absolute;
			left: 0;
			top: 0;
			width: 42px;
			height: 42px;
			line-height: 42px;
			text-align: center;
			font-size: 9px;
			font-weight: 700;
			color: #334155;
		}

		.metrics {
			width: 100%;
			border-collapse: separate;
			border-spacing: 8px 0;
		}

		.metric {
			width: 20%;
			background: #ffffff;
			border: 1px solid #e6edf5;
			border-radius: 12px;
			padding: 10px 8px 12px;
			text-align: center;
			vertical-align: top;
		}

		.metric-label {
			font-size: 12px;
			line-height: 1.2;
			font-weight: 700;
			color: #334155;
			min-height: 30px;
			margin-bottom: 8px;
		}

		.icon {
			width: 48px;
			height: 48px;
			margin: 0 auto 8px;
			background: transparent;
			text-align: center;
			line-height: 48px;
		}

		.icon svg {
			width: 44px;
			height: 44px;
			vertical-align: middle;
			fill: #22c55e;
		}

		.metric-value {
			font-size: 39px;
			line-height: 1;
			font-weight: 800;
			color: #1f2a37;
		}

		.metric-suffix {
			font-size: 12px;
			font-weight: 700;
			color: #334155;
		}

		.small-note {
			margin-top: 10px;
			font-size: 10px;
			text-align: center;
			color: #64748b;
		}
	</style>
{% endblock %}

{% block body %}
	{% if informe_html is defined and informe_html|trim != '' %} 
		{{ informe_html|raw }}
	{% else %}
		
	{% endif %}
{% endblock %}
