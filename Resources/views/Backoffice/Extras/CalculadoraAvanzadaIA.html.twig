{% extends '@App/Backoffice/base.html.twig' %}
{% form_theme calculadora_avanzada '@App/Backoffice/bootstrap_4_layout.html.twig' %}
{% block customscripts %}
	{{ parent() }}
	<script src="{{ asset('assets/js/custom/countDecimalPlaces.min.js') }}"></script>
	<script src="{{ asset('assets/js/custom/round.min.js') }}"></script>
	<script src="{{ asset('assets/js/custom/calculadora-avanzadav3.js') }}"></script>
	<script>
		window.addEventListener('load', function () {
			setTimeout(function() {
				// Selecciona el elemento con el atributo data-contenedor-resultado
				const resultadoElement = document.querySelector('[data-contenedor-resultado]');
				
				// Verifica si el elemento existe en el DOM
				if (resultadoElement) {
					// Obtiene la posición del elemento desde la parte superior de la página
					const position = resultadoElement.getBoundingClientRect().top + window.scrollY - 60;
					
					// Desplaza la página hasta esa posición calculada y lo deja en la parte superior
					window.scrollTo({
						top: position,
						behavior: 'smooth' // Desplazamiento suave
					});
				}
			}, 100); // Retraso de 100ms
		});
	</script>
{% endblock %}
{% block customstyles %}
	<link href="{{ asset('assets/css/custom/custom.min.css') }}" rel="stylesheet">
	<link href="{{ asset('assets/css/custom/calculadora-avanzada.css') }}" rel="stylesheet">
{% endblock %}
