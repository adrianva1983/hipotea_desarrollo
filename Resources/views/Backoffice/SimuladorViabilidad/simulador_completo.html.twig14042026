                                <div style="font-size: 11px; color: #666; text-transform: uppercase; margin-bottom: 6px;">Aportación Necesaria</div>
                                <div class="viab-number">${aportacion.toLocaleString('es-ES', {minimumFractionDigits: 0, maximumFractionDigits: 0})} €</div>
                            </div>
                            <div style="text-align: center; background: white; padding: 15px; border-radius: 8px; border: 1px solid #e0e0e0;">
                                <div style="font-size: 11px; color: #666; text-transform: uppercase; margin-bottom: 6px;">% Financiación</div>
                                <div class="viab-number" style="color: ${colorPct};">${porcentajeFinanciacion.toFixed(1)}%</div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Criterios Evaluados -->
                    <div style="padding: 15px; border-radius: 8px; border: 1px solid #e0e0e0; margin-bottom: 20px;">
                        <h4 style="color: #333; margin-top: 0; margin-bottom: 12px; font-size: 14px; font-weight: 600;">🔍 Criterios Evaluados</h4>
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #f0f0f0;">
                            <span style="color: #555; font-size: 14px;">Préstamos impagados</span>
                            <span style="font-weight: 600; color: ${tienePrestamosPagados ? '#dc3545' : '#28a745'};">${tienePrestamosPagados ? '❌ Sí' : '✓ No'}</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #f0f0f0;">
                            <span style="color: #555; font-size: 14px;">Porcentaje de financiación</span>
                            <span style="font-weight: 600; color: ${colorPct};">${porcentajeFinanciacion.toFixed(1)}% ${porcentajeFinanciacion <= financiacionVerde ? '✓' : (porcentajeFinanciacion <= financiacionMedia ? '⚠' : '❌')}</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #f0f0f0;">
                            <span style="color: #555; font-size: 14px;">Precio inmueble vs máximo</span>
                            <span style="font-weight: 600; color: ${valorInmueblePaso3 > 0 && precioMaxRec > 0 && valorInmueblePaso3 > precioMaxRec ? '#dc3545' : '#28a745'};">
                                ${valorInmueblePaso3 > 0 && precioMaxRec > 0 ? (valorInmueblePaso3 <= precioMaxRec ? '✓ Dentro límite' : '❌ Supera máximo') : '—'}
                            </span>
                        </div>
                        
                        <!-- MEJOR TITULAR (mejor situación laboral) -->
                        <div style="margin-top: 12px; padding-top: 12px; border-top: 1px dashed #ccc;">
                            <div style="font-size: 12px; font-weight: 600; color: #666; margin-bottom: 8px;">
                                👤 Mejor Titular ${numTitularesConfirmado === 2 ? `(Titular ${mejorTitular.num})` : ''}
                            </div>
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid #f0f0f0;">
                                <span style="color: #555; font-size: 14px;">→ Antigüedad laboral</span>
                                <span style="font-weight: 600; color: ${mejorTitular.ant === 'menos_1_anio' && mejorTitular.sit !== 'funcionario' ? '#dc3545' : '#28a745'};">
                                    ${mejorTitular.ant === 'menos_1_anio' ? (mejorTitular.sit === 'funcionario' ? 'Menos de 1 año ✓' : 'Menos de 1 año ❌') : (mejorTitular.ant === 'un_anio' ? '1 año ✓' : 'Más de 2 años ✓')}
                                </span>
                            </div>
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 0;">
                                <span style="color: #555; font-size: 14px;">→ Situación laboral</span>
                                <span style="font-weight: 600; color: #333;">${mejorTitular.sit === 'funcionario' ? 'Funcionario' : (mejorTitular.sit === 'contrato_indefinido' ? 'Contrato indefinido' : (mejorTitular.sit === 'contrato_temporal' ? 'Contrato temporal' : (mejorTitular.sit === 'autonomo' ? 'Autónomo' : (mejorTitular.sit === 'empresario' ? 'Empresario' : 'Otro'))))}</span>
                            </div>
                        </div>
                        
                        <!-- RATIO DE ENDEUDAMIENTO - CRITERIO CRÍTICO -->
                        <div style="margin-top: 12px;">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <span style="color: #555; font-size: 14px; font-weight: 600;">📊 Ratio de Endeudamiento (Cuota/Ingresos)</span>
                                <span style="font-weight: 700; font-size: 14px; color: ${ratioEndeudamiento > 45 ? '#dc3545' : (ratioEndeudamiento > 35 ? '#ff9800' : '#28a745')};">
                                    ${ratioEndeudamiento.toFixed(1)}%
                                    ${ratioEndeudamiento > 45 ? ' ❌ ROJO' : (ratioEndeudamiento > 35 ? ' ⚠ AMARILLO' : ' ✓ VERDE')}
                                </span>
                            </div>
                            <div style="font-size: 12px; color: #666; margin-top: 6px;">
                                ${ratioEndeudamiento > 45 ? 'Supera el 45%: viabilidad comprometida.' : (ratioEndeudamiento > 35 ? 'Entre 35-45%: viabilidad media, análisis requerido.' : 'Bajo 35%: cuota cómoda respecto a ingresos.')}
                            </div>
                        </div>
                    </div>
                    
                    <!-- Aviso Legal -->
                    <div style="background: linear-gradient(135deg, #fff9e6 0%, #fffbf0 100%); border: 2px solid #ffc107; border-radius: 10px; padding: 20px; font-size: 13px; color: #6c5c00; line-height: 1.9; margin: 20px 0; box-shadow: 0 3px 12px rgba(255,193,7,0.15);">
                        <div style="display: flex; align-items: flex-start; gap: 12px;">
                            <span style="font-size: 28px; line-height: 1; flex-shrink: 0;">⚖️</span>
                            <div>
                                <strong style="color: #856404; display: block; margin-bottom: 10px; font-size: 14px; font-weight: 700;">AVISO LEGAL</strong>
                                <p style="margin: 0 0 8px; color: #6c5c00; font-weight: 500;">Este resultado corresponde únicamente a un <strong>estudio previo orientativo</strong> basado en los datos introducidos.</p>
                                <p style="margin: 0 0 8px; color: #6c5c00; font-weight: 500;">No constituye una aprobación de financiación ni una oferta vinculante.</p>
                                <p style="margin: 0; color: #6c5c00; font-weight: 500;">La viabilidad definitiva de la operación y las condiciones hipotecarias solo pueden determinarse tras un estudio completo por parte de los analistas de Hipotea y de las entidades financieras.</p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Acción Recomendada según resultado -->
                    ${esVerde ? `
                    <div style="background: #d4edda; border: 2px solid #28a745; border-radius: 10px; padding: 20px; margin-bottom: 20px;">
                        <h4 style="color: #155724; margin: 0 0 12px; font-size: 15px; font-weight: 700;">✅ Próximos Pasos</h4>
                        <div style="color: #155724; font-size: 13px; line-height: 1.6; margin: 0;">
                            <p><strong>1. Solicita tu estudio personalizado</strong></p>
                            <p>Así podremos confirmar tu viabilidad definitiva y decirte qué oferta hipotecaria puedes obtener realmente.</p>
                            <p><strong>Opción 1. Completa nuestro cuestionario</strong><br>Rellénalo <a id="formExp1" href="https://hipotea.com/cuestionario/" target="_blank">aquí</a> para que estudiemos tu caso en profundidad.</p>
                            <p><strong>Opción 2. Contacta con un asesor.</strong><br><a href="#" onclick="abrirWhatsAppEstudio(); return false;">Agenda una reunión</a>.</p>
                            <hr style="border:none;border-top:1px solid rgba(0,0,0,0.06);margin:12px 0;" />
                            <p><strong>2. Documentación</strong></p>
                            <p style="margin:0 0 6px;">Si decides continuar con nosotros, te pediremos la documentación necesaria para tramitar tu hipoteca.</p>
                            <p style="margin:0;">Además, podrás descargar gran parte desde tu área de documentos, gracias a nuestra conexión con organismos oficiales.</p>
                        </div>
                    </div>` : ''}
                    ${!esVerde && !esRojo ? `
                    <div style="background: #fff3cd; border: 2px solid #e6a817; border-radius: 10px; padding: 20px; margin-bottom: 20px;">
                        <h4 style="color: #856404; margin: 0 0 12px; font-size: 15px; font-weight: 700;">⚠️ Próximos Pasos</h4>
                        <div style="color: #856404; font-size: 13px; line-height: 1.6; margin: 0;">
                            <p><strong>1. Solicita tu estudio personalizado</strong></p>
                            <p>Así podremos confirmar tu viabilidad definitiva y decirte qué oferta hipotecaria puedes obtener realmente.</p>
                            <p><strong>Opción 1. Completa nuestro cuestionario</strong><br>Rellénalo <a id="formExp2" href="https://hipotea.com/cuestionario/" target="_blank">aquí</a> para que estudiemos tu caso en profundidad.</p>
                            <p><strong>Opción 2. Contacta con un asesor.</strong><br><a href="#" onclick="abrirWhatsAppEstudio(); return false;">Agenda una reunión</a>.</p>
                            <hr style="border:none;border-top:1px solid rgba(0,0,0,0.06);margin:12px 0;" />
                            <p><strong>2. Documentación</strong></p>
                            <p style="margin:0 0 6px;">Si decides continuar con nosotros, te pediremos la documentación necesaria para tramitar tu hipoteca.</p>
                            <p style="margin:0;">Además, podrás descargar gran parte desde tu área de documentos, gracias a nuestra conexión con organismos oficiales.</p>
                        </div>
                    </div>` : ''}
                    ${esRojo ? `
                    <div style="background: #f8d7da; border: 2px solid #dc3545; border-radius: 10px; padding: 20px; margin-bottom: 20px;">
                        <h4 style="color: #721c24; margin: 0 0 12px; font-size: 15px; font-weight: 700;">🔧 Cómo Mejorar tu Viabilidad</h4>
                        <ul style="color: #721c24; font-size: 13px; line-height: 1.8; margin: 0 0 12px; padding-left: 20px;">
                            ${esRojoPorTemporal ? '<li><strong>⚠️ CRÍTICO - Contrato Temporal:</strong> Tu tipo de contrato actual no permite acceder a financiación hipotecaria. Recomendación: <ul style="margin-top: 6px;"><li><strong>Espera a tener un contrato indefinido</strong>, O</li><li><strong>Busca un co-solicitante</strong> con situación laboral más estable (funcionario, contrato indefinido, autónomo consolidado)</li></ul></li>' : ''}
                            ${tienePrestamosPagados ? '<li><strong>Acción prioritaria:</strong> Cancela o regulariza los préstamos con cuotas impagadas antes de solicitar hipoteca</li>' : ''}
                            ${porcentajeFinanciacion > financiacionMedia ? `<li><strong>Aumenta tu aportación inicial.</strong> Para alcanzar una viabilidad media necesitarías aportar ${(precioVivienda * (1 - (financiacionMedia / 100))).toLocaleString('es-ES', {maximumFractionDigits: 0})} € </li><li><strong>Aportar una vivienda como aval</strong> para garantizar la operación</li>` : ''}
                            ${ratioEndeudamiento > 45 ? `<li><strong>⚠️ CRÍTICO - Ratio de Endeudamiento (${ratioEndeudamiento.toFixed(1)}%):</strong> La cuota mensual es muy alta respecto a tus ingresos. Necesitas balancing:<ul style="margin-top: 6px;"><li>Reduce el precio del inmueble, O</li><li>Aumenta la aportación inicial, O</li><li>Busca mejorar tus ingresos mensuales</li></ul></li>` : ''}
                            ${valorInmueblePaso3 > 0 && precioMaxRec > 0 && valorInmueblePaso3 > precioMaxRec ? '<li><strong>⚠️ Precio del inmueble supera máximo:</strong> El precio (€' + valorInmueblePaso3.toLocaleString() + ') excede al máximo recomendado (€' + precioMaxRec.toLocaleString() + '). <strong>Considera un inmueble de menor precio, más acorde con tus ingresos actuales o aumenta la aportación a la compra</strong></li>' : ''}
                            ${mejorTitular.ant === 'menos_1_anio' && mejorTitular.sit !== 'contrato_temporal' && mejorTitular.sit !== 'funcionario' ? '<li><strong>Espera a tener mayor antigüedad laboral</strong></li>' : ''}
                            ${(prestamosCuotaT1 + prestamosCuotaT2) > 0 && !tienePrestamosPagados && !esRojoPorTemporal ? '<li><strong>Reduce deudas activas</strong> para disminuir tu ratio de endeudamiento total</li>' : ''}
                            <li><strong>Una vez mejorado tu perfil,</strong> solicita un nuevo análisis de viabilidad</li>
                        </ul>
                        <p style="color: #721c24; font-size: 12px; margin: 0; font-style: italic; border-top: 1px solid #dc3545; padding-top: 10px;">⚠️ Estos cambios te permitirán acceder a financiación hipotecaria en mejores condiciones.</p>
                    </div>` : ''}
                    
                    <!-- Botones de acción -->
                    <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
                        <button type="button" onclick="descargarPDF()" style="background: linear-gradient(135deg, #ff7722, #ff9944); color: white; border: none; padding: 12px 24px; border-radius: 25px; font-size: 14px; font-weight: 600; cursor: pointer; box-shadow: 0 4px 12px rgba(255,119,34,0.3);">
                            <i class="fa fa-file-pdf-o mr-2"></i> Ver informe completo
                        </button>
                    </div>
                </div>
            `;
            
            // Reemplazar todo el contenido del panel derecho con el semáforo (ocultar cuota/gastos)
            const resultadoContent = document.getElementById('resultadoContent');
            resultadoContent.innerHTML = '';
            const divSemaforo = document.createElement('div');
            divSemaforo.setAttribute('data-semaforo', 'true');
            divSemaforo.innerHTML = semaforoHTML;
            resultadoContent.appendChild(divSemaforo);
            
            // CREAR EXPEDIENTE AUTOMÁTICAMENTE (sin confirmación)
            enviarAHipoteaConInforme();
        }



        function pre_rellenarDatosPaso3() {
            // Copiar valores comunes de Paso 2 a Paso 3
            try {
                const paso2 = document.getElementById('paso2Section');
                const paso3 = document.getElementById('paso3Section');
                
                if (!paso2 || !paso3) {
                    console.error('No se encontraron los pasos 2 o 3');
                    return;
                }
                
                // ===== CAMPOS NUMÉRICOS =====
                
                // Copiar Aportación Inicial
                const aportacion2 = paso2.querySelector('input[name*="aportacionInicial"]');
                const aportacion3 = paso3.querySelector('input[name="simulador_p3[aportacionInicial]"]');
                if (aportacion2 && aportacion3 && aportacion2.value) {
                    aportacion3.value = aportacion2.value;
                }
                
                // Copiar Edad del Mayor de los Titulares
                const edadUno2 = parseInt(paso2.querySelector('input[name*="edadTitularUno"]')?.value || 0);
                const edadDos2 = parseInt(paso2.querySelector('input[name*="edadTitularDos"]')?.value || 0);
                const numTitulares2 = parseInt(paso2.querySelector('input[name*="numTitulares"]:checked')?.value) || 1;
                // Con 2 titulares: usar edad del menor; con 1: usar su edad
                const edadCopiar = numTitulares2 === 2 ? Math.min(edadUno2, edadDos2) : edadUno2;
                
                const edadUno3 = paso3.querySelector('input[name="simulador_p3[edadTitularUno]"]');
                if (edadUno3 && edadCopiar > 0) {
                    edadUno3.value = edadCopiar;
                }
                
                // ===== CAMPOS SELECT/DROPDOWN =====
                
                // Copiar Plazo Amortización
                const plazo2 = paso2.querySelector('input[name*="plazoAmortizacion"]');
                const plazo3 = paso3.querySelector('input[name*="plazoAmortizacion"]');
                if (plazo2 && plazo3 && plazo2.value) {
                    plazo3.value = plazo2.value;
                    $(plazo3).trigger('change');
                }
                
                // Copiar Comunidad Autónoma
                const comunidad2 = paso2.querySelector('select[name*="comunidadAutonoma"]');
                const comunidad3 = paso3.querySelector('select[name*="comunidadAutonoma"]');
                if (comunidad2 && comunidad3 && comunidad2.value) {
                    comunidad3.value = comunidad2.value;
                    $(comunidad3).trigger('change');
                }
                
                // Copiar Destino Compra
                const destino2 = paso2.querySelector('select[name*="destinoCompra"]');
                const destino3 = paso3.querySelector('select[name*="destinoCompra"]');
                if (destino2 && destino3 && destino2.value) {
                    destino3.value = destino2.value;
                    $(destino3).trigger('change');
                }
                
                // ===== CAMPOS RADIO BUTTONS (ChoiceType expandido) =====
                
                // Copiar Obra Nueva
                const obraNueva2 = paso2.querySelector('input[name*="obraNueva"]:checked');
                if (obraNueva2) {
                    const obraNueva3 = paso3.querySelector('input[name*="obraNueva"][value="' + obraNueva2.value + '"]');
                    if (obraNueva3) {
                        obraNueva3.checked = true;
                    }
                }
                
                // Copiar Minusvalía
                const minusvalia2 = paso2.querySelector('input[name*="minusvaliaFamiliaNumerosa"]:checked');
                if (minusvalia2) {
                    const minusvalia3 = paso3.querySelector('input[name*="minusvaliaFamiliaNumerosa"][value="' + minusvalia2.value + '"]');
                    if (minusvalia3) {
                        minusvalia3.checked = true;
                    }
                }
                
                // Copiar Familia Numerosa
                const familia2 = paso2.querySelector('input[name*="familiaNumerosa"]:checked');
                if (familia2) {
                    const familia3 = paso3.querySelector('input[name*="familiaNumerosa"][value="' + familia2.value + '"]');
                    if (familia3) {
                        familia3.checked = true;
                    }
                }
                
                // Copiar Monoparental
                const mono2 = paso2.querySelector('input[name*="monoparental"]:checked');
                if (mono2) {
                    const mono3 = paso3.querySelector('input[name*="monoparental"][value="' + mono2.value + '"]');
                    if (mono3) {
                        mono3.checked = true;
                    }
                }
                
                // Copiar VPO
                const vpo2 = paso2.querySelector('input[name*="vpo"]:checked');
                if (vpo2) {
                    const vpo3 = paso3.querySelector('input[name*="vpo"][value="' + vpo2.value + '"]');
                    if (vpo3) {
                        vpo3.checked = true;
                    }
                }
                
                // ===== CAMPOS ECONÓMICOS (copiar desde Paso 2 - no se modifican en Paso 3) =====
                
                // Nota: Los campos de ingresos, pagas extras y préstamos se leen desde Paso 2
                // durante el cálculo. No se heredan en Paso 3 pero se usan del Paso 2.
                // El usuario puede modificar estos campos en Paso 2 si lo desea.
                
                // Actualizar resumen del Paso 2
                actualizarResumenPaso2();
                
                //console.log('✓ Pre-rellenado: edad (mayor), aportación, plazo, comunidad, destino, obra nueva, familia, discapacidad, monoparental, vpo');
            } catch (e) {
                console.error('Error al pre-rellenar datos Paso 3:', e);
            }
        }

        function actualizarResultado() {
            // Copiar el resultado del Paso 3 al panel derecho
            const resultadoCuotaGastos = document.getElementById('resultadoCuotaGastos');
            const resultadoContent = document.getElementById('resultadoContent');
            
            if (resultadoCuotaGastos && resultadoCuotaGastos.style.display !== 'none') {
                // Copiar el contenido del resultado del Paso 3
                resultadoContent.innerHTML = resultadoCuotaGastos.innerHTML;
            } else {
                resultadoContent.innerHTML = `
                    <div class="text-center p-5">
                        <p style="color: #999; font-size: 14px;">Completa todos los pasos para ver el resultado</p>
                    </div>
                `;
            }
        }

        function enviarAHipoteaConInforme() {            
            //console.log('=== INICIANDO enviarAHipoteaConInforme ===');

            // Recoger datos del cliente del DOM (Paso 1)
            const nombre   = document.querySelector('#paso1Section input[name*="nombre"]')?.value || '';
            const dni      = document.querySelector('#paso1Section input[name*="dni"]')?.value    || '';
            const telefono = document.querySelector('#paso1Section input[name*="telefono"]')?.value || '';
            const email    = document.querySelector('#paso1Section input[name*="email"]')?.value    || '';
            
            //console.log('Datos cliente:', { nombre, dni, telefono, email });

            // Recoger datos económicos y laborales del simulador - TITULAR UNO
            const numTitulares = parseInt(document.querySelector('input[name*="numTitulares"]:checked')?.value || 1);
            const ingresos_mensuales  = parseFloat(document.querySelector('input[name*="ingresosMensuales"]:not([name*="Dos"])')?.value || 0);
            const numero_pagas        = parseInt(document.querySelector('input[name*="numPagasExtra"]:not([name*="Dos"])')?.value || 0);
            const importe_pagas       = parseFloat(document.querySelector('input[name*="importePagaExtra"]:not([name*="Dos"])')?.value || 0);
            const aportacion          = parseFloat(document.querySelector('input[name*="aportacionInicial"]:not([name*="Dos"])')?.value || 0);
            const situacion_laboral   = document.querySelector('select[name*="situacionLaboral"]:not([name*="TitularDos"])')?.value || '';
            const antiguedad_laboral  = document.querySelector('select[name*="antiguedadLaboral"]:not([name*="TitularDos"])')?.value || '';
            const tiene_impagados     = document.querySelector('input[name*="tienePrestamosImpagados"]:checked')?.value === 'true' || false;
            const prestamos_mensuales = parseFloat(document.querySelector('input[name*="prestamosMensuales"]:not([name*="Dos"])')?.value || 0);
            const precio_inmueble     = valorInmueblePaso3 || precioMaximoCalculado || 0;

            // Recoger datos económicos y laborales del simulador - TITULAR DOS (si existe)
            const ingresos_mensuales_dos  = parseFloat(document.querySelector('input[name*="ingresosMensualesDos"]')?.value || 0);
            const numero_pagas_dos        = parseInt(document.querySelector('input[name*="numPagasExtraDos"]')?.value || 0);
            const importe_pagas_dos       = parseFloat(document.querySelector('input[name*="importePagaExtraDos"]')?.value || 0);
            const situacion_laboral_dos   = document.querySelector('select[name*="situacionLaboralTitularDos"]')?.value || '';
            const antiguedad_laboral_dos  = document.querySelector('select[name*="antiguedadLaboralTitularDos"]')?.value || '';

            // PRIMERO: Renderizar el informe para obtener el HTML (todavía sin ID del expediente)
            descargarPDF(true);
            const informeHtml = document.getElementById('pdfPreviewContent')?.innerHTML || '';
            //console.log('Informe HTML obtenido, longitud:', informeHtml.length);

            const payloadEnvio = {
                cliente: { nombre, dni, telefono, email },
                simulador: {
                    num_titulares: numTitulares,
                    ingresos_mensuales,
                    numero_pagas,
                    importe_pagas,
                    aportacion,
                    prestamos_mensuales,
                    situacion_laboral,
                    antiguedad_laboral,
                    tiene_impagados,
                    precio_inmueble,
                    gastos_totales_aproximados: gastosTotalesAproximados,
                    // Datos Titular 2
                    ingresos_mensuales_dos,
                    numero_pagas_dos,
                    importe_pagas_dos,
                    situacion_laboral_dos,
                    antiguedad_laboral_dos
                },
                informe_html: informeHtml
            };

            fetch('{{ path("simulador_enviar_hipotea") }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                credentials: 'include',
                body: JSON.stringify(payloadEnvio)
            })
            .then(res => {
                //console.log('Respuesta del servidor recibida:', res.status);
                return res.json();
            })
            .then(data => {
                //console.log('JSON parseado:', data);
                if (data.success) {
                    // Capturar ID del expediente si viene en la respuesta
                    if (data.expediente_id) {
                        expedienteId = data.expediente_id;

                        $('#formExp1').attr('href', '/ColaboradorComercialTecnico/Formulario/Expediente/' + expedienteId);
                        $('#formExp2').attr('href', '/ColaboradorComercialTecnico/Formulario/Expediente/' + expedienteId);
                        
                        //console.log('✓ expedienteId capturado:', expedienteId);
                        // SEGUNDO: Ahora que ya tenemos el expedienteId, re-renderizar el informe con el ID incluido
                        descargarPDF(true);
                    }
                    //mostrarModal(data.mensaje, 'Solicitud enviada');
                } else {
                    console.error('Error en respuesta:', data.mensaje);
                    //mostrarModal(data.mensaje || 'No se pudo crear el expediente', 'Error');
                }
            })
            .catch(err => {
                console.error('❌ Error en fetch:', err);
                //mostrarModal('Error de conexión: ' + err.message, 'Error');
            }); // fin confirmarAccion
        }

        function enviarAHipotea() {
            enviarAHipoteaConInforme();
        }

        function descargarPDF(silent = false) {
            //console.log('=== descargarPDF iniciado (silent=' + silent + ', expedienteId=' + expedienteId + ') ===');
            try {
            // Renderizar informe en pdfPreviewContent
            // silent=true: solo renderiza sin abrir el modal (usado al enviar a Hipotea)
            // silent=false: abre el modal para previsualizar/imprimir
            if (!silent) {
                $('#modalPDFPreview').modal('show');
                console.log('Modal de previsualización abierto', expedienteId);
                setTimeout(() => {
                    $('#formExp3').attr('href', '/ColaboradorComercialTecnico/Formulario/Expediente/' + expedienteId);
                    $('#formExp4').attr('href', '/ColaboradorComercialTecnico/Formulario/Expediente/' + expedienteId);
                }, 30);
            }
            const previewDiv = document.getElementById('pdfPreviewContent');
            
            // Recoger datos del cliente (Paso 1)
            const nombre = document.querySelector('#paso1Section input[name*="nombre"]')?.value || '—';
            const dni = document.querySelector('#paso1Section input[name*="dni"]')?.value || '—';
            const telefono = document.querySelector('#paso1Section input[name*="telefono"]')?.value || '—';
            const email = document.querySelector('#paso1Section input[name*="email"]')?.value || '—';
            
            // Recoger datos calculados del Paso 3 (desde variables globales guardadas)
            const precioViviendaStr = datosCalculadosPaso3.precioVivienda > 0
                ? parseFloat(datosCalculadosPaso3.precioVivienda).toLocaleString('es-ES', {minimumFractionDigits: 0, maximumFractionDigits: 0}) + ' €'
                : '—';
            const gastosTotalesStr = datosCalculadosPaso3.gastosTotales > 0
                ? parseFloat(datosCalculadosPaso3.gastosTotales).toLocaleString('es-ES', {minimumFractionDigits: 0, maximumFractionDigits: 0}) + ' €'
                : '—';
            
            // Gastos individuales
            const obraNueva = datosCalculadosPaso3.obraNueva || false;
            const ivaStr = datosCalculadosPaso3.iva > 0
                ? parseFloat(datosCalculadosPaso3.iva).toLocaleString('es-ES', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + ' €'
                : null;
            const escrituraStr = datosCalculadosPaso3.escritura > 0
                ? parseFloat(datosCalculadosPaso3.escritura).toLocaleString('es-ES', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + ' €'
                : null;
            // Calcular porcentaje de ITP/AJD
            const porcentajeEscritura = datosCalculadosPaso3.precioVivienda > 0 && datosCalculadosPaso3.escritura > 0
                ? ((datosCalculadosPaso3.escritura / datosCalculadosPaso3.precioVivienda) * 100).toFixed(2)
                : null;
            const porcentajeIVA = datosCalculadosPaso3.precioVivienda > 0 && datosCalculadosPaso3.iva > 0
                ? ((datosCalculadosPaso3.iva / datosCalculadosPaso3.precioVivienda) * 100).toFixed(2)
                : null;
            
            const notarioStr = datosCalculadosPaso3.notario > 0
                ? parseFloat(datosCalculadosPaso3.notario).toLocaleString('es-ES', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + ' €'
                : '—';
            const registroStr = datosCalculadosPaso3.registro > 0
                ? parseFloat(datosCalculadosPaso3.registro).toLocaleString('es-ES', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + ' €'
                : '—';
            const gestoriaStr = datosCalculadosPaso3.gestoria > 0
                ? parseFloat(datosCalculadosPaso3.gestoria).toLocaleString('es-ES', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + ' €'
                : '—';
            const tasacionStr = datosCalculadosPaso3.tasacion > 0
                ? parseFloat(datosCalculadosPaso3.tasacion).toLocaleString('es-ES', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + ' €'
                : '—';
            const otrosStr = datosCalculadosPaso3.otros > 0
                ? parseFloat(datosCalculadosPaso3.otros).toLocaleString('es-ES', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + ' €'
                : null;
            const aportacionStr = datosCalculadosPaso3.aportacion > 0
                ? parseFloat(datosCalculadosPaso3.aportacion).toLocaleString('es-ES', {minimumFractionDigits: 0, maximumFractionDigits: 0}) + ' €'
                : '—';
            const importePrestamoStr = datosCalculadosPaso3.importePrestamo > 0
                ? parseFloat(datosCalculadosPaso3.importePrestamo).toLocaleString('es-ES', {minimumFractionDigits: 0, maximumFractionDigits: 0}) + ' €'
                : '—';
            
            const sumaTotalPrestamo = (datosCalculadosPaso3.importePrestamo + datosCalculadosPaso3.gastosTotales) > 0
                ? parseFloat(datosCalculadosPaso3.importePrestamo + datosCalculadosPaso3.gastosTotales).toLocaleString('es-ES', {minimumFractionDigits: 0, maximumFractionDigits: 0}) + ' €'
                : '—';
            const plazoStr = datosCalculadosPaso3.plazo > 0
                ? datosCalculadosPaso3.plazo + ' años'
                : '—';
            // Si es cambio de casa, usar la cuota "Cuando Venda" (cuotaFijaFinal), sino la cuota normal
            const cuotaParaMostrar = (datosCalculadosPaso3.esCambioCasa && datosCalculadosPaso3.cuotaFijaFinal > 0) 
                ? datosCalculadosPaso3.cuotaFijaFinal 
                : datosCalculadosPaso3.cuotaMensual;
            const cuotaMensualStr = cuotaParaMostrar > 0
                ? parseFloat(cuotaParaMostrar).toLocaleString('es-ES', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + ' €'
                : '—';
            const tipoInteresStr = datosCalculadosPaso3.tipoInteres > 0
                ? datosCalculadosPaso3.tipoInteres.toFixed(2) + '%'
                : '—';
            
            const precioMaxStr = precioMaximoCalculado
                ? parseFloat(precioMaximoCalculado).toLocaleString('es-ES', {minimumFractionDigits: 0, maximumFractionDigits: 0}) + ' €'
                : '—';
            const precioInmuebleStr = datosCalculadosPaso3.precioVivienda > 0
                ? parseFloat(datosCalculadosPaso3.precioVivienda).toLocaleString('es-ES', {minimumFractionDigits: 0, maximumFractionDigits: 0}) + ' €'
                : null;
            
            // Datos del resultado del semáforo
            const sd = semaforoResultadoData;
            const semColor = sd ? sd.color : '#666';
            const semResultado = sd ? sd.resultado : '—';
            const semIcono = sd ? sd.icono : '—';
            const semMensaje = sd ? sd.mensaje : '—';
            const semPct = sd ? sd.porcentajeFinanciacion.toFixed(1) + '%' : '—';
            const semColorPct = sd ? sd.colorPct : '#333';
            
            const fechaHoy = new Date().toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
            
            previewDiv.innerHTML = `
                <div style="font-family: 'Segoe UI', Arial, sans-serif; max-width: 800px; margin: 0 auto; padding: 40px 30px; color: #2c3e50; background: white;">
                    <style>
                        .viab-number { color: #000 !important; font-size: 18px !important; font-weight: 700 !important; }
                        .viab-small { color: #000 !important; font-size: 14px !important; }
                    </style>
                    
                    <!-- Cabecera del informe con logo -->
                    <div style="text-align: center; border-bottom: 4px solid #ff7722; padding-bottom: 25px; margin-bottom: 35px; background: linear-gradient(135deg, #fff5f0 0%, #ffffff 100%); padding: 30px; border-radius: 12px 12px 0 0;">
                        <h1 style="color: #ff7722; font-size: 26px; margin: 0 0 8px; font-weight: 800; letter-spacing: -0.5px; text-transform: uppercase;">Informe de Viabilidad Hipotecaria</h1>
                        <p style="color: #7f8c8d; font-size: 14px; margin: 0; font-weight: 500;">Estudio Previo Orientativo</p>
                        <p style="color: #95a5a6; font-size: 12px; margin: 8px 0 0;">Generado el ${fechaHoy}</p>
                    </div>
                    
                    <!-- Datos del Cliente -->
                    <div style="background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%); padding: 24px; border-radius: 10px; margin-bottom: 24px; border: 1px solid #e9ecef; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
                        <h3 style="font-size: 15px; font-weight: 700; color: #ff7722; margin: 0 0 16px; text-transform: uppercase; border-bottom: 3px solid #ff7722; padding-bottom: 8px; display: inline-block;">👤 Datos del Cliente</h3>
                        <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                            <tr><td style="padding: 8px 0; color: #7f8c8d; width: 35%; font-weight: 500;">Nombre completo:</td><td style="font-weight: 600; padding: 8px 0; text-align: right;"><span class="viab-number">${nombre}</span></td></tr>
                            <tr><td style="padding: 8px 0; color: #7f8c8d; font-weight: 500;">DNI / NIE:</td><td style="font-weight: 600; padding: 8px 0; text-align: right;"><span class="viab-number">${dni}</span></td></tr>
                            <tr><td style="padding: 8px 0; color: #7f8c8d; font-weight: 500;">Teléfono:</td><td style="font-weight: 600; padding: 8px 0; text-align: right;"><span class="viab-number">${telefono}</span></td></tr>
                            <tr><td style="padding: 8px 0; color: #7f8c8d; font-weight: 500;">Email:</td><td style="font-weight: 600; padding: 8px 0; text-align: right;"><span class="viab-number">${email}</span></td></tr>
                        </table>
                    </div>

                    <!-- Gastos Aproximados de Compra -->
                    <div style="background: linear-gradient(135deg, #f0f8ff 0%, #ffffff 100%); padding: 24px; border-radius: 10px; margin-bottom: 60px; border: 1px solid #d6e9f8; box-shadow: 0 2px 8px rgba(52,152,219,0.06);">
                        <h3 style="font-size: 15px; font-weight: 700; color: #ff7722; margin: 0 0 16px; text-transform: uppercase; border-bottom: 3px solid #ff7722; padding-bottom: 8px; display: inline-block; color: #e53935;">📋 Gastos Asociados a la Compraventa</h3>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 18px;">
                            ${escrituraStr ? `
                            <div style="display: flex; align-items: center; padding: 10px; background: white; border-radius: 6px; border-left: 4px solid #ff9800;">
                                <img src="/assets/images/coins.png" style="width: 40px; height: 40px; object-fit: contain; margin-right: 12px; flex-shrink: 0;">
                                <div style="flex: 1;">
                                    <div style="font-size: 12px; color: #666; font-weight: 500;">${obraNueva ? 'AJD' : 'ITP'} ${porcentajeEscritura ? porcentajeEscritura + '%' : ''}</div>
                                    <div class="viab-number">${escrituraStr}</div>
                                </div>
                            </div>
                            ` : ''}
                            <div style="display: flex; align-items: center; padding: 10px; background: white; border-radius: 6px; border-left: 4px solid #ff7043;">
                                <img src="/assets/images/notario.png" style="width: 40px; height: 40px; object-fit: contain; margin-right: 12px; flex-shrink: 0;">
                                <div style="flex: 1;">
                                    <div style="font-size: 12px; color: #666; font-weight: 500;">Notaría*</div>
                                    <div class="viab-number">${notarioStr}</div>
                                </div>
                            </div>
                            ${ivaStr ? `
                            <div style="display: flex; align-items: center; padding: 10px; background: white; border-radius: 6px; border-left: 4px solid #42a5f5;">
                                <img src="/assets/images/iva.jpg" style="width: 40px; height: 40px; object-fit: contain; margin-right: 12px; flex-shrink: 0;">
                                <div style="flex: 1;">
                                    <div style="font-size: 12px; color: #666; font-weight: 500;">IVA* ${porcentajeIVA ? porcentajeIVA + '%' : ''}</div>
                                    <div class="viab-number">${ivaStr}</div>
                                </div>
                            </div>
                            ` : ''}
                            <div style="display: flex; align-items: center; padding: 10px; background: white; border-radius: 6px; border-left: 4px solid #66bb6a;">
                                <img src="/assets/images/gestoria.png" style="width: 40px; height: 40px; object-fit: contain; margin-right: 12px; flex-shrink: 0;">
                                <div style="flex: 1;">
                                    <div style="font-size: 12px; color: #666; font-weight: 500;">Gestoría*</div>
                                    <div class="viab-number">${gestoriaStr}</div>
                                </div>
                            </div>
                            <div style="display: flex; align-items: center; padding: 10px; background: white; border-radius: 6px; border-left: 4px solid #5c6bc0;">
                                <img src="/assets/images/landmark.png" style="width: 40px; height: 40px; object-fit: contain; margin-right: 12px; flex-shrink: 0;">
                                <div style="flex: 1;">
                                    <div style="font-size: 12px; color: #666; font-weight: 500;">Registro*</div>
                                    <div class="viab-number">${registroStr}</div>
                                </div>
                            </div>
                            <div style="display: flex; align-items: center; padding: 10px; background: white; border-radius: 6px; border-left: 4px solid #ffa726;">
                                <img src="/assets/images/tasacion.png" style="width: 40px; height: 40px; object-fit: contain; margin-right: 12px; flex-shrink: 0;">
                                <div style="flex: 1;">
                                    <div style="font-size: 12px; color: #666; font-weight: 500;">Tasación*</div>
                                    <div class="viab-number">${tasacionStr}</div>
                                </div>
                            </div>
                            ${otrosStr ? `
                            <div style="display: flex; align-items: center; padding: 10px; background: white; border-radius: 6px; border-left: 4px solid #ec407a;">
                                <img src="/assets/images/inmobiliaria.png" style="width: 40px; height: 40px; object-fit: contain; margin-right: 12px; flex-shrink: 0;">
                                <div style="flex: 1;">
                                    <div style="font-size: 12px; color: #666; font-weight: 500;">Inmobiliaria</div>
                                    <div class="viab-number">${otrosStr}</div>
                                </div>
                            </div>
                            ` : ''}
                        </div>
                        <!-- Total de Gastos -->
                        <div style="background: linear-gradient(135deg, #fff3e6 0%, #ffe8cc 100%); padding: 16px 20px; border-radius: 8px; margin-top: 18px; border: 2px solid #ff7722; display: flex; justify-content: space-between; align-items: center;">
                            <div style="font-weight: 800; color: #2c3e50; font-size: 16px; text-transform: uppercase;">💼 Total Gastos:</div>
                            <div class="viab-number">${gastosTotalesStr}</div>
                        </div>
                        <p style="margin: 16px 0 0; font-size: 12px; color: #95a5a6; font-style: italic; line-height: 1.6;">* Los gastos son estimaciones orientativas basadas en valores medios de mercado. Los importes definitivos pueden variar según la comunidad autónoma y las circunstancias específicas de la operación.</p>
                    </div>
                    
                    <!-- Resumen de la Operación -->
                    <div style="background: linear-gradient(135deg, #fff9e6 0%, #ffffff 100%); padding: 24px; border-radius: 10px; margin-bottom: 60px; border: 2px solid #ffedcc; box-shadow: 0 3px 12px rgba(255,119,34,0.08);">
                        <h3 style="font-size: 15px; font-weight: 700; color: #ff7722; margin: 0 0 16px; text-transform: uppercase; border-bottom: 3px solid #ff7722; padding-bottom: 8px; display: inline-block;">🏠 Resumen de la Operación</h3>
                        <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                            <tr style="border-bottom: 1px solid #f0f0f0;"><td style="padding: 10px 0; color: #7f8c8d; font-weight: 500;">Precio máximo recomendado:</td><td style="font-weight: 600; text-align: right; padding: 10px 0;"><span class="viab-number">${precioMaxStr}</span></td></tr>
                            ${precioInmuebleStr ? `<tr style="border-bottom: 1px solid #f0f0f0;"><td style="padding: 10px 0; color: #7f8c8d; width: 55%; font-weight: 500;">Precio de la vivienda:</td><td style="font-weight: 700; text-align: right; padding: 10px 0; color: #2c3e50; font-size: 15px;"><span class="viab-number">${precioInmuebleStr}</span></td></tr>` : ''}                            
                            <tr style="border-bottom: 1px solid #f0f0f0;"><td style="padding: 10px 0; color: #7f8c8d; font-weight: 500;">Aportación necesaria:</td><td style="font-weight: 700; text-align: right; padding: 10px 0; color: #3498db; font-size: 15px;"><span class="viab-number">${aportacionStr}</span></td></tr>
                            <tr style="border-bottom: 1px solid #f0f0f0;"><td style="padding: 10px 0; color: #7f8c8d; font-weight: 500;">Importe del préstamo solicitado:</td><td style="font-weight: 800; text-align: right; padding: 10px 0; color: #ff7722; font-size: 16px;"><span class="viab-number">${importePrestamoStr}</span></td></tr>
                            <tr style="border-bottom: 1px solid #f0f0f0;"><td style="padding: 10px 0; color: #7f8c8d; font-weight: 500;">Plazo de amortización:</td><td style="font-weight: 600; text-align: right; padding: 10px 0; color: #2c3e50;"><span class="viab-number">${plazoStr}</span></td></tr>
                            <tr style="border-bottom: 1px solid #f0f0f0;"><td style="padding: 10px 0; color: #7f8c8d; font-weight: 500;">Cuota mensual estimada (tipo fijo):</td><td style="font-weight: 800; text-align: right; padding: 10px 0; font-size: 18px;"><span class="viab-number">${cuotaMensualStr}</span></td></tr>
                            <tr style="border-bottom: 1px solid #f0f0f0;"><td style="padding: 10px 0; color: #7f8c8d; font-weight: 500;">Tipo de interés estimado:</td><td style="font-weight: 600; text-align: right; padding: 10px 0; color: #2c3e50;"><span class="viab-number">${tipoInteresStr}</span></td></tr>
                            <tr style="border-bottom: 1px solid #f0f0f0;"><td style="padding: 10px 0; color: #7f8c8d; font-weight: 500;">Porcentaje de financiación:</td><td style="font-weight: 600; text-align: right; padding: 10px 0; color: #2c3e50;"><span class="viab-number">${semPct}</span></td></tr>
                        </table>
                    </div>
                    
                    <!-- Criterios Evaluados -->
                    ${sd ? `
                    <div style="padding: 20px; border-radius: 10px; border: 1px solid #e0e0e0; margin-bottom: 60px; background: white;">
                        <h3 style="font-size: 15px; font-weight: 700; color: #ff7722; margin: 0 0 16px; text-transform: uppercase; border-bottom: 3px solid #ff7722; padding-bottom: 8px; display: inline-block;">🔍 Criterios Evaluados</h3>
                        
                        <table style="width: 100%; border-collapse: collapse; font-size: 14px; margin-top: 12px;">
                            <!-- Préstamos impagados -->
                            <tr style="border-bottom: 1px dotted #ddd;">
                                <td style="padding: 10px 0; color: #7f8c8d; font-weight: 500;">Préstamos impagados</td>
                                <td style="text-align: right; padding: 10px 0; font-weight: 700; color: ${sd.tienePrestamosPagados ? '#dc3545' : '#28a745'};">${sd.tienePrestamosPagados ? '❌ Sí' : '✓ No'}</td>
                            </tr>
                            <!-- Porcentaje de financiación -->
                            <tr style="border-bottom: 1px dotted #ddd;">
                                <td style="padding: 10px 0; color: #7f8c8d; font-weight: 500;">Porcentaje de financiación</td>
                                <td style="text-align: right; padding: 10px 0; font-weight: 700; color: ${sd.colorPct || '#333'};">${sd.porcentajeFinanciacion.toFixed(1)}% ${sd.porcentajeFinanciacion <= sd.financiacionVerde ? '✓' : (sd.porcentajeFinanciacion <= sd.financiacionMedia ? '⚠' : '❌')}</td>
                            </tr>
                            <!-- Precio vs máximo -->
                            <tr style="border-bottom: 1px dotted #ddd;">
                                <td style="padding: 10px 0; color: #7f8c8d; font-weight: 500;">Precio inmueble vs máximo</td>
                                <td style="text-align: right; padding: 10px 0; font-weight: 600; color: ${sd.valorInmueblePaso3 > 0 && sd.precioMaxRec > 0 && sd.valorInmueblePaso3 > sd.precioMaxRec ? '#dc3545' : '#28a745'};">${sd.valorInmueblePaso3 > 0 && sd.precioMaxRec > 0 ? (sd.valorInmueblePaso3 <= sd.precioMaxRec ? '✓ Dentro límite' : '❌ Supera máximo') : '—'}</td>
                            </tr>
                            <!-- Mejor Titular (Antigüedad y Situación) -->
                            <tr style="border-bottom: 1px solid #e0e0e0;">
                                <td colspan="2" style="padding: 14px 0 10px; color: #2c3e50; font-weight: 700; border-top: 1px dotted #ddd; padding-top: 14px;">👤 Mejor Titular</td>
                            </tr>
                            <tr style="border-bottom: 1px dotted #ddd;">
                                <td style="padding: 10px 0; color: #7f8c8d; font-weight: 500; padding-left: 16px;">Antigüedad laboral</td>
                                <td style="text-align: right; padding: 10px 0; font-weight: 600; color: ${sd.mejorTitular && sd.mejorTitular.ant === 'menos_1_anio' && sd.mejorTitular.sit !== 'funcionario' ? '#dc3545' : '#28a745'};">
                                    ${sd.mejorTitular ? (sd.mejorTitular.ant === 'menos_1_anio' && sd.mejorTitular.sit !== 'funcionario' ? '❌ Menos de 1 año' : (sd.mejorTitular.ant === 'menos_1_anio' && sd.mejorTitular.sit === 'funcionario' ? '✓ Menos de 1 año' : (sd.mejorTitular.ant === 'un_anio' ? '✓ 1 año' : (sd.mejorTitular.ant === 'mas_2_anios' ? '✓ Más de 2 años' : '—')))) : '—'}
                                </td>
                            </tr>
                            <tr style="border-bottom: 1px dotted #ddd;">
                                <td style="padding: 10px 0; color: #7f8c8d; font-weight: 500; padding-left: 16px;">Situación laboral</td>
                                <td style="text-align: right; padding: 10px 0; font-weight: 600; color: #333;">${sd.mejorTitular ? (sd.mejorTitular.sit === 'funcionario' ? 'Funcionario' : (sd.mejorTitular.sit === 'contrato_indefinido' ? 'Contrato indefinido' : (sd.mejorTitular.sit === 'contrato_temporal' ? 'Contrato temporal' : (sd.mejorTitular.sit === 'autonomo' ? 'Autónomo' : (sd.mejorTitular.sit === 'empresario' ? 'Empresario' : 'Otro'))))) : '—'}</td>
                            </tr>
                            <!-- Ratio de Endeudamiento -->
                            <tr>
                                <td style="padding: 10px 0; color: #2c3e50; font-weight: 700; border-top: 1px dotted #ddd; padding-top: 14px;">📊 Ratio de Endeudamiento (Cuota/Ingresos)</td>
                                <td style="padding: 10px 0;">
                                    <div style="text-align: right; font-weight: 700; font-size: 15px; color: ${sd.ratioEndeudamiento > 45 ? '#dc3545' : (sd.ratioEndeudamiento > 35 ? '#ff9800' : '#28a745')};">${sd.ratioEndeudamiento.toFixed(1)}% ${sd.ratioEndeudamiento > 45 ? '❌ ROJO' : (sd.ratioEndeudamiento > 35 ? '⚠ AMARILLO' : '✓ VERDE')}</div>
                                    <div style="text-align: right; font-size: 11px; color: #666; margin-top: 4px; font-style: italic;">${sd.ratioEndeudamiento > 45 ? 'Supera el 45%: viabilidad comprometida.' : (sd.ratioEndeudamiento > 35 ? 'Entre 35-45%: viabilidad media.' : 'Bajo 35%: cuota cómoda.')}</div>
                                </td>
                            </tr>
                        </table>
                    </div>
                    ` : ''}
                    
                    <!-- Resultado del Estudio Previo -->
                    ${sd ? `
                    <div style="border: 4px solid ${semColor}; border-radius: 12px; padding: 30px; margin-bottom: 30px; text-align: center; background: linear-gradient(135deg, ${semColor}08 0%, #ffffff 100%); box-shadow: 0 4px 16px ${semColor}30;">
                        <h3 style="font-size: 16px; font-weight: 700; color: #2c3e50; margin: 0 0 20px; text-transform: uppercase; letter-spacing: 0.5px;">🔍 RESULTADO DEL ESTUDIO PREVIO</h3>
                        <div style="background: ${semColor}; width: 50px; height: 50px; border-radius: 50%; margin: 0 auto 18px; display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 20px ${semColor}60;">
                            <span style="font-size: 30px; color: white; font-weight: bold; line-height: 1;">${semIcono}</span>
                        </div>
                        <h2 style="color: ${semColor}; margin: 0 0 16px; font-size: 24px; font-weight: 800; letter-spacing: -0.5px;">${semResultado}</h2>
                        <p style="color: #555; font-size: 15px; margin: 0; line-height: 1.7; max-width: 600px; margin: 0 auto;">${semMensaje}</p>
                    </div>
                    
                    <!-- Próximos Pasos / Acciones Recomendadas -->
                    ${sd.esVerde ? `
                    <div style="background: #d4edda; border: 2px solid #28a745; border-radius: 10px; padding: 20px; margin-bottom: 20px;">
                        <h4 style="color: #155724; margin: 0 0 12px; font-size: 15px; font-weight: 700;">✅ Próximos Pasos</h4>
                        <div style="color: #155724; font-size: 13px; line-height: 1.6; margin: 0 0 16px;">
                            <p><strong>1. Solicita tu estudio personalizado</strong></p>
                            <p>Así podremos confirmar tu viabilidad definitiva y decirte qué oferta hipotecaria puedes obtener realmente.</p>
                            <p><strong>Opción 1. Completa nuestro cuestionario</strong><br>Rellénalo <a id="formExp3" href="https://hipotea.com/cuestionario/" target="_blank">aquí</a> para que estudiemos tu caso en profundidad.</p>
                            <p><strong>Opción 2. Contacta con un asesor.</strong><br><a href="#" onclick="abrirWhatsAppEstudio(); return false;">Agenda una reunión</a>.</p>
                            <hr style="border:none;border-top:1px solid rgba(0,0,0,0.06);margin:12px 0;" />
                            <p><strong>2. Documentación</strong></p>
                            <p style="margin:0 0 6px;">Si decides continuar con nosotros, te pediremos la documentación necesaria para tramitar tu hipoteca.</p>
                            <p style="margin:0;">Además, podrás descargar gran parte desde tu área de documentos, gracias a nuestra conexión con organismos oficiales.</p>
                        </div>
                        
                    </div>` : ''}
                    ${!sd.esVerde && !sd.esRojo ? `
                    <div style="background: #fff3cd; border: 2px solid #e6a817; border-radius: 10px; padding: 20px; margin-bottom: 20px;">
                        <h4 style="color: #856404; margin: 0 0 12px; font-size: 15px; font-weight: 700;">⚠️ Próximos Pasos</h4>
                        <div style="color: #856404; font-size: 13px; line-height: 1.6; margin: 0 0 16px;">
                            <p><strong>1. Solicita tu estudio personalizado</strong></p>
                            <p>Así podremos confirmar tu viabilidad definitiva y decirte qué oferta hipotecaria puedes obtener realmente.</p>
                            <p><strong>Opción 1. Completa nuestro cuestionario</strong><br>Rellénalo <a id="formExp4" href="https://hipotea.com/cuestionario/" target="_blank">aquí</a> para que estudiemos tu caso en profundidad.</p>
                            <p><strong>Opción 2. Contacta con un asesor.</strong><br><a href="#" onclick="abrirWhatsAppEstudio(); return false;">Agenda una reunión</a>.</p>
                            <hr style="border:none;border-top:1px solid rgba(0,0,0,0.06);margin:12px 0;" />
                            <p><strong>2. Documentación</strong></p>
                            <p style="margin:0 0 6px;">Si decides continuar con nosotros, te pediremos la documentación necesaria para tramitar tu hipoteca.</p>
                            <p style="margin:0;">Además, podrás descargar gran parte desde tu área de documentos, gracias a nuestra conexión con organismos oficiales.</p>
                        </div>
                        
                    </div>` : ''}
                    ${sd.esRojo ? `
                    <div style="background: #f8d7da; border: 2px solid #dc3545; border-radius: 10px; padding: 20px; margin-bottom: 20px;">
                        <h4 style="color: #721c24; margin: 0 0 12px; font-size: 15px; font-weight: 700;">🔧 Cómo Mejorar tu Viabilidad</h4>
                        <ul style="color: #721c24; font-size: 13px; line-height: 1.8; margin: 0 0 12px; padding-left: 20px;">
                            ${sd.esRojoPorTemporal ? '<li><strong>⚠️ CRÍTICO - Contrato Temporal:</strong> Tu tipo de contrato actual no permite acceder a financiación hipotecaria. Recomendación: <ul style="margin-top: 6px;"><li><strong>Espera a tener un contrato indefinido</strong>, O</li><li><strong>Busca un co-solicitante</strong> con situación laboral más estable (funcionario, contrato indefinido, autónomo consolidado)</li></ul></li>' : ''}
                            ${sd.tienePrestamosPagados ? '<li><strong>Acción prioritaria:</strong> Cancela o regulariza los préstamos con cuotas impagadas antes de solicitar hipoteca</li>' : ''}
                            ${sd.porcentajeFinanciacion > sd.financiacionMedia ? '<li><strong>Aumenta tu aportación inicial.</strong> Para alcanzar una viabilidad media necesitarías aportar ' + (sd.valorInmueblePaso3 * (1 - (sd.financiacionMedia / 100))).toLocaleString('es-ES', {maximumFractionDigits: 0}) + ' € </li><li><strong>Aportar una vivienda como aval</strong> para garantizar la operación</li>' : ''}
                            ${sd.ratioEndeudamiento > 45 ? '<li><strong>⚠️ CRÍTICO - Ratio de Endeudamiento (' + sd.ratioEndeudamiento.toFixed(1) + '%):</strong> La cuota mensual es muy alta respecto a tus ingresos. Necesitas balancing:<ul style="margin-top: 6px;"><li>Reduce el precio del inmueble, O</li><li>Aumenta la aportación inicial, O</li><li>Busca mejorar tus ingresos mensuales</li></ul></li>' : ''}                            
                            ${sd.valorInmueblePaso3 > 0 && sd.precioMaxRec > 0 && sd.valorInmueblePaso3 > sd.precioMaxRec ? '<li><strong>⚠️ Precio del inmueble supera máximo:</strong> El precio (€' + sd.valorInmueblePaso3.toLocaleString() + ') excede al máximo recomendado (€' + sd.precioMaxRec.toLocaleString() + '). <strong>Considera un inmueble de menor precio, más acorde con tus ingresos actuales o aumenta la aportación a la compra</strong></li>' : ''}
                            ${sd.mejorTitular.ant === 'menos_1_anio' && sd.mejorTitular.sit !== 'contrato_temporal' && sd.mejorTitular.sit !== 'funcionario' ? '<li><strong>Espera a tener mayor antigüedad laboral</strong></li>' : ''}
                            ${(sd.prestamosCuotaT1 + sd.prestamosCuotaT2) > 0 && !sd.tienePrestamosPagados && !sd.esRojoPorTemporal ? '<li><strong>Reduce deudas activas</strong> para disminuir tu ratio de endeudamiento total</li>' : ''}
                            <li><strong>Una vez mejorado tu perfil,</strong> solicita un nuevo análisis de viabilidad</li>
                        </ul>
                        <p style="color: #721c24; font-size: 12px; margin: 12px 0 0; font-style: italic; border-top: 1px solid #dc3545; padding-top: 10px;">⚠️ Estos cambios te permitirán acceder a financiación hipotecaria en mejores condiciones.</p>
                        
                    </div>` : ''}
                    ` : ''}
                    
                    <!-- Aviso Legal -->
                    <div style="background: linear-gradient(135deg, #fff9e6 0%, #fffbf0 100%); border: 2px solid #ffc107; border-radius: 10px; padding: 20px; font-size: 13px; color: #6c5c00; line-height: 1.9; margin-top: 30px; box-shadow: 0 3px 12px rgba(255,193,7,0.15);">
                        <div style="display: flex; align-items: flex-start; gap: 12px;">
                            <span style="font-size: 28px; line-height: 1; flex-shrink: 0;">⚖️</span>
                            <div>
                                <strong style="color: #856404; display: block; margin-bottom: 10px; font-size: 14px; font-weight: 700;">AVISO LEGAL</strong>
                                <p style="margin: 0 0 8px; color: #6c5c00; font-weight: 500;">Este resultado corresponde únicamente a un <strong>estudio previo orientativo</strong> basado en los datos introducidos.</p>
                                <p style="margin: 0 0 8px; color: #6c5c00; font-weight: 500;">No constituye una aprobación de financiación ni una oferta vinculante.</p>
                                <p style="margin: 0; color: #6c5c00; font-weight: 500;">La viabilidad definitiva de la operación y las condiciones hipotecarias solo pueden determinarse tras un estudio completo por parte de los analistas de Hipotea y de las entidades financieras.</p>
                            </div>
                        </div>
                    </div>
                    
                </div>
            `;
            //console.log('✓ descargarPDF completado exitosamente');
            } catch(err) {
                console.error('❌ Error en descargarPDF:', err);
            }
        }
        
        function generarYDescargarPDF() {
            const contenido = document.getElementById('pdfPreviewContent')?.innerHTML;
            if (!contenido) return;

            const ventana = window.open('', '_blank');
            ventana.document.write(`<!DOCTYPE html>
            <html lang="es">
            <head>
                <meta charset="UTF-8">
                <title>Estudio Previo de Viabilidad Hipotecaria</title>
                <style>
                    * { box-sizing: border-box; margin: 0; padding: 0; }
                    body { font-family: Arial, sans-serif; color: #333; background: white; }
                    @page { margin: 12mm; size: A4 portrait; }
                    @media print {
                        body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
                    }
                </style>
            </head>
            <body>${contenido}</body>
            </html>`);
            ventana.document.close();
            ventana.focus();
            setTimeout(() => {
                ventana.print();
                ventana.close();
            }, 400);
        }

        function reiniciar() {
            confirmarAccion('¿Desea reiniciar el simulador?', function() {
                // Limpiar formulario
                document.getElementById('simuladorForm').reset();
                
                // Volver al paso inicial: 0 si no está logueado, 1 si está logueado
                const pasoInicial = APP_USER_LOGGED ? 1 : 0;
                pasoActual = pasoInicial;
                mostrarPaso(pasoInicial);
                
                // Limpiar resultado
                document.getElementById('resultadoContent').innerHTML = `
                    <div class="text-center p-5">
                        <p style="color: #999; font-size: 14px;">Completa el formulario para ver el resultado</p>
                    </div>
                `;
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            if (pasoActual === 'resultado') {
                pasoActual = pasos.length - 1;
            } else {
                pasoActual = parseInt(pasoActual) || 0;
            }
            mostrarPaso(pasoActual);
            
            // ===== MOSTRAR/OCULTAR CAMPOS DEL SEGUNDO TITULAR =====
            function toggleTitularDos() {
                const titularDosSection = document.getElementById('titularDosSection');
                const titularDosEconomicoSection = document.getElementById('titularDosEconomicoSection');
                if (!titularDosSection) return;

                // Prefer checked radio, fallback to select
                let numTitulares = 1;
                const checkedRadio = $('input[name*="numTitulares"]:checked');
                if (checkedRadio.length) {
                    numTitulares = parseInt(checkedRadio.val()) || 1;
                } else {
                    const sel = $('select[name*="numTitulares"]').first();
                    if (sel.length) numTitulares = parseInt(sel.val()) || 1;
                }

                if (numTitulares === 2) {
                    titularDosSection.style.display = 'block';
                    if (titularDosEconomicoSection) titularDosEconomicoSection.style.display = 'block';
                    // make second age required
                    $('input[name*="edadTitularDos"]').attr('required', 'required');
                } else {
                    titularDosSection.style.display = 'none';
                    if (titularDosEconomicoSection) titularDosEconomicoSection.style.display = 'none';
                    // remove requirement and clear value
                    $('input[name*="edadTitularDos"]').removeAttr('required').val('');
                    $('input[name*="ingresosMensualesDos"], input[name*="numPagasExtraDos"], input[name*="importePagaExtraDos"], input[name*="prestamosMensualesDos"]').val('');
                }
            }
            
            // Ejecutar al cargar la página
            toggleTitularDos();
            
            // Agregar listener para cambios en numTitulares
            $('select[name*="numTitulares"], input[name*="numTitulares"]').on('change', function() {
                toggleTitularDos();
            });

            // ===== SINCRONIZACIÓN DE CAMPOS COMUNES ENTRE PASO 2 Y PASO 3 =====
            // Función genérica para sincronizar un campo entre Paso 2 y Paso 3
            const camposSincronizables = [
                { base: 'aportacionInicial', paso3: 'simulador_p3[aportacionInicial]', tipo: 'input' },
                { base: 'destinoCompra', paso3: 'simulador_p3[destinoCompra]', tipo: 'select' },
                { base: 'obraNueva', paso3: 'simulador_p3[obraNueva]', tipo: 'checkbox' },
                { base: 'comunidadAutonoma', paso3: 'simulador_p3[comunidadAutonoma]', tipo: 'select' },
                { base: 'minusvaliaFamiliaNumerosa', paso3: 'simulador_p3[minusvaliaFamiliaNumerosa]', tipo: 'checkbox' },
                { base: 'familiaNumerosa', paso3: 'simulador_p3[familiaNumerosa]', tipo: 'checkbox' },
                { base: 'monoparental', paso3: 'simulador_p3[monoparental]', tipo: 'checkbox' },
                { base: 'vpo', paso3: 'simulador_p3[vpo]', tipo: 'checkbox' }
            ];

            function sincronizarCampo(nombreBase, nombrePaso3, tipo, origen) {
                let selectorPaso2, selectorPaso3;
                
                if (tipo === 'input') {
                    selectorPaso2 = document.querySelector(`input[name*="${nombreBase}"]:not([name*="Dos"])`);
                    selectorPaso3 = document.querySelector(`input[name="${nombrePaso3}"]`);
                } else if (tipo === 'select') {
                    selectorPaso2 = document.querySelector(`select[name*="${nombreBase}"]`);
                    selectorPaso3 = document.querySelector(`select[name="${nombrePaso3}"]`);
                } else if (tipo === 'checkbox') {
                    selectorPaso2 = document.querySelector(`input[name*="${nombreBase}"]:not([name*="Dos"])[type="checkbox"]`);
                    selectorPaso3 = document.querySelector(`input[name="${nombrePaso3}"][type="checkbox"]`);
                }

                if (origen === 'paso2' && selectorPaso2 && selectorPaso3) {
                    const valor = tipo === 'checkbox' ? selectorPaso2.checked : selectorPaso2.value;
                    if (tipo === 'checkbox') {
                        selectorPaso3.checked = valor;
                    } else {
                        selectorPaso3.value = valor;
                    }
                    $(selectorPaso3).trigger('change');
                } else if (origen === 'paso3' && selectorPaso2 && selectorPaso3) {
                    const valor = tipo === 'checkbox' ? selectorPaso3.checked : selectorPaso3.value;
                    if (tipo === 'checkbox') {
                        selectorPaso2.checked = valor;
                    } else {
                        selectorPaso2.value = valor;
                    }
                    $(selectorPaso2).trigger('change');
                }
            }

            // Agregar event listeners para cada campo sincronizable
            camposSincronizables.forEach(campo => {
                let selectores = [];
                
                if (campo.tipo === 'input') {
                    selectores = [
                        document.querySelector(`input[name*="${campo.base}"]:not([name*="Dos"])`),
                        document.querySelector(`input[name="${campo.paso3}"]`)
                    ];
                    const selPaso2 = selectores[0];
                    const selPaso3 = selectores[1];
                    
                    if (selPaso2) {
                        selPaso2.addEventListener('change', () => sincronizarCampo(campo.base, campo.paso3, campo.tipo, 'paso2'));
                        selPaso2.addEventListener('input', () => sincronizarCampo(campo.base, campo.paso3, campo.tipo, 'paso2'));
                    }
                    if (selPaso3) {
                        selPaso3.addEventListener('change', () => sincronizarCampo(campo.base, campo.paso3, campo.tipo, 'paso3'));
                        selPaso3.addEventListener('input', () => sincronizarCampo(campo.base, campo.paso3, campo.tipo, 'paso3'));
                    }
                } else if (campo.tipo === 'select') {
                    selectores = [
                        document.querySelector(`select[name*="${campo.base}"]`),
                        document.querySelector(`select[name="${campo.paso3}"]`)
                    ];
                    const selPaso2 = selectores[0];
                    const selPaso3 = selectores[1];
                    
                    if (selPaso2) {
                        selPaso2.addEventListener('change', () => sincronizarCampo(campo.base, campo.paso3, campo.tipo, 'paso2'));
                    }
                    if (selPaso3) {
                        selPaso3.addEventListener('change', () => sincronizarCampo(campo.base, campo.paso3, campo.tipo, 'paso3'));
                    }
                } else if (campo.tipo === 'checkbox') {
                    selectores = [
                        document.querySelector(`input[name*="${campo.base}"]:not([name*="Dos"])[type="checkbox"]`),
                        document.querySelector(`input[name="${campo.paso3}"][type="checkbox"]`)
                    ];
                    const selPaso2 = selectores[0];
                    const selPaso3 = selectores[1];
                    
                    if (selPaso2) {
                        selPaso2.addEventListener('change', () => sincronizarCampo(campo.base, campo.paso3, campo.tipo, 'paso2'));
                    }
                    if (selPaso3) {
                        selPaso3.addEventListener('change', () => sincronizarCampo(campo.base, campo.paso3, campo.tipo, 'paso3'));
                    }
                }
            });

            // Validación cliente: plazo + edad <= 75
            // Con 2 titulares: usar edad del MENOR (más permisivo)
            // Con 1 titular: usar edad del titular único
            window.validarPlazoEdad = function() {
                const plazoInput = document.querySelector('input[name*="plazoAmortizacion"]');
                if (!plazoInput) return true;
                const v1 = parseInt($('input[name*="edadTitularUno"]').val()) || 0;
                const v2 = parseInt($('input[name*="edadTitularDos"]').val()) || 0;
                const numTitulares = parseInt($('input[name*="numTitulares"]:checked').val()) || 1;
                
                // Seleccionar edad: si hay 2 titulares, usar la menor (más permisivo); si hay 1, usar su edad
                const edadCalcular = numTitulares === 2 ? Math.min(v1, v2) : v1;
                let permitido = 75 - edadCalcular;
                if (isNaN(permitido)) permitido = 40;
                permitido = Math.min(40, Math.max(0, Math.floor(permitido)));

                // Ajustar atributos del input range
                plazoInput.max = permitido;
                // mantener min en 10 salvo que el permitido sea menor
                if (permitido < 10) {
                    plazoInput.min = 1;
                } else {
                    plazoInput.min = 10;
                }

                // Si el valor actual excede el permitido, ajustarlo
                let val = parseInt(plazoInput.value) || parseInt(plazoInput.getAttribute('value')) || 0;
                if (val > permitido) {
                    // si permitido es 0, fijar a 0
                    plazoInput.value = permitido;
                    val = permitido;
                }

                // Actualizar displays:
                // - El número a la derecha (#plazoSelected) muestra el máximo permitido (total) y
                //   solo se recalcula cuando cambian las edades.
                // - El texto debajo (#plazoSelectedText) muestra el valor seleccionado del slider.
                const display = document.getElementById('plazoSelected');
                const displayText = document.getElementById('plazoSelectedText');
                if (display) display.textContent = permitido;
                const seleccionado = parseInt(plazoInput.value) || val;
                if (displayText) displayText.textContent = seleccionado + ' años';

                // No mostramos mensaje rojo según tu indicación; sólo reconfiguramos el slider
                const errorDiv = document.getElementById('plazoError');
                if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }

                return true;
            }

            // Actualizar visual de plazo seleccionado
            window.updatePlazoDisplay = function() {
                const plazoInput = document.querySelector('input[name*="plazoAmortizacion"]');
                const display = document.getElementById('plazoSelected');
                const displayText = document.getElementById('plazoSelectedText');
                if (!plazoInput || !display) return;
                // El número a la derecha muestra el máximo (total)
                const maxVal = parseInt(plazoInput.max) || parseInt(plazoInput.getAttribute('data-default-max')) || 40;
                display.textContent = maxVal;
                // El texto inferior muestra lo seleccionado
                const v = parseInt(plazoInput.value) || parseInt(plazoInput.getAttribute('value')) || 25;
                if (displayText) displayText.textContent = v + ' años';
            }

            // Función llamada por el atributo oninput desde el range
            window.actualizarPlazoMaximo = function(el) {
                try {
                    // Al mover la barra sólo actualizamos el texto inferior (valor seleccionado).
                    const v = el && el.value ? el.value : (document.querySelector('input[name*="plazoAmortizacion"]')?.value || '25');
                    const displayText = document.getElementById('plazoSelectedText');
                    if (displayText) displayText.textContent = v + ' años';
                    // NO recalculamos el máximo aquí; eso solo debe ocurrir cuando cambian las edades.
                } catch (e) {
                    console.error('actualizarPlazoMaximo error', e);
                }
            }

            // Escuchar cambios en edades → recalcular máximo y actualizar displays
            // IMPORTANTE: Validar que edad <= 65
            $(document).on('input change', 'input[name*="edadTitularUno"], input[name*="edadTitularDos"]', function() {
                const valor = parseInt($(this).val()) || 0;
                if (valor > 65) {
                    $(this).val(65);  // Forzar a 65 si intenta poner más
                }
                validarPlazoEdad();
                updatePlazoDisplay();
            });

            // Escuchar movimientos del slider → sólo actualizar el texto del valor seleccionado
            $(document).on('input change', 'input[name*="plazoAmortizacion"]', function() {
                updatePlazoDisplay();
            });

            // Validar edad en Paso 3 (no permitir > 65)
            $(document).on('input change', 'input[name="simulador_p3[edadTitularUno]"]', function() {
                const valor = parseInt($(this).val()) || 0;
                if (valor > 65) {
                    $(this).val(65);  // Forzar a 65 si intenta poner más
                    mostrarModal('La edad máxima permitida es 65 años', 'Aviso');
                }
            });

            // Inicializar visual (calcular máximo por defecto y mostrar valores)
            validarPlazoEdad();
            updatePlazoDisplay();
        });

        // ─── Helpers de modales ─────────────────────────────────────────────────
        function mostrarModal(mensaje, titulo) {
            document.getElementById('modal-simulador-aviso-titulo').textContent = titulo || 'Atención';
            document.getElementById('modal-simulador-aviso-msg').textContent = mensaje;
            $('#modal-simulador-aviso').modal('show');
        }

        function confirmarAccion(mensaje, callbackSi, titulo) {
            document.getElementById('modal-simulador-confirm-titulo').textContent = titulo || 'Confirmar';
            document.getElementById('modal-simulador-confirm-msg').textContent = mensaje;
            var btnOk = document.getElementById('modal-simulador-confirm-ok');
            var btnNuevo = btnOk.cloneNode(true);
            btnOk.parentNode.replaceChild(btnNuevo, btnOk);
            btnNuevo.addEventListener('click', function() {
                $('#modal-simulador-confirm').modal('hide');
                callbackSi();
            });
            $('#modal-simulador-confirm').modal('show');
        }
    </script>
{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="simulador-container">
            <!-- PANEL IZQUIERDO: FORMULARIO -->
            <div class="formulario-panel caja-calculadora">
                <form id="simuladorForm" method="post" class="needs-validation">
                    <input type="hidden" name="_accion" id="accion" value="paso0">

                    <!-- PASO 0: Aviso Previo Obligatorio -->
                    <div id="paso0Section" class="paso-section">
                        <div class="paso-title">Paso 0: Aviso Previo Obligatorio</div>
                        
                        <div style="background: #fff3cd; border: 1px solid #ffc107; border-radius: 8px; padding: 20px; margin-bottom: 20px;">
                            <div style="font-size: 13px; color: #333; line-height: 1.6;">
                                <p><strong>Estimado usuario,</strong></p>
                                
                                <p>Este simulador realiza únicamente un <strong>estudio previo orientativo de viabilidad hipotecaria</strong> basado en los datos introducidos.</p>
                                
                                <p>El resultado obtenido <strong>no constituye una aprobación de financiación</strong> ni una oferta vinculante.</p>
                                
                                <p>La viabilidad real de una operación hipotecaria depende de múltiples variables adicionales y solo puede determinarse tras un análisis completo por parte de los analistas de Hipotea y de las entidades financieras.</p>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="form-check">
                                <input type="checkbox" 
                                       id="avisoPrevioAccepted" 
                                       name="avisoPrevioAccepted" 
                                       required="required" 
                                       class="form-check-input" 
                                       value="1">
                                <label class="form-check-label" for="avisoPrevioAccepted" style="cursor: pointer;">
                                    <span style="color: #333; font-size: 14px;">He leído y acepto este aviso previo obligatorio *</span>
                                </label>
                            </div>
                            <div class="invalid-feedback d-block" id="avisoError" style="display: none; color: #dc3545; font-size: 13px; margin-top: 5px;">
                                Debes aceptar el aviso para continuar
                            </div>
                        </div>
                    </div>

                    <!-- PASO 1: Datos del Cliente -->
                    <div id="paso1Section" class="paso-section d-none">
                        <div class="paso-title">Paso 1: Datos del Cliente</div>
                        <h6 style="font-size: 13px; color: #666; margin-bottom: 20px;">Cuéntanos tus datos personales</h6>
                        <p style="font-size: 12px; color: #999; margin-bottom: 20px; font-style: italic;">Estos datos servirán para generar el informe resumen de tu solicitud.</p>
                        
                        {% for child in formulario_cliente %}
                            {% if child.vars.name not in ['_token'] %}
                                <div class="form-row">
                                    <div class="form-group col">
                                        {{ form_label(child) }}
                                        {{ form_widget(child) }}
                                        {{ form_errors(child) }}
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>

                    <!-- PASO 2: Precio Maximo (simplificado) -->
                    <div id="paso2Section" class="paso-section d-none">
                        <div class="paso-title">Paso 2: Cálculo de Precio Máximo</div>
                        <h6 style="font-size: 13px; color: #666; margin-bottom: 20px;">Indica cuántos titulares sois</h6>

                        <div class="form-row">
                            <div class="form-group col">
                                <div id="simulador_precio_maximo_numTitulares" class="horizontal">
                                    <div style="display:flex; gap:18px; align-items:center;">
                                    {% for child in formulario_precio.numTitulares %}
                                        <div class="form-check" style="display:inline-flex; align-items:center;">
                                            {{ form_widget(child, {'attr': {'class': 'form-check-input'}}) }}
                                            {{ form_label(child, null, {'label_attr': {'class': 'form-check-label', 'style': 'margin-left:6px;'}}) }}
                                        </div>
                                    {% endfor %}
                                    </div>
                                    {{ form_errors(formulario_precio.numTitulares) }}
                                </div>
                            </div>
                        </div>
                            <div class="form-row" style="margin-top:12px;">
                                <div class="form-group col">
                                    {{ form_row(formulario_precio.edadTitularUno, {'attr': {'max': 65}}) }}
                                </div>
                            </div>

                            <div id="titularDosSection" style="display:none; margin-top:10px; border-top: 0; padding-top: 12px;">
                                <div class="form-row">
                                    <div class="form-group col">
                                        {{ form_row(formulario_precio.edadTitularDos, {'attr': {'max': 65}}) }}
                                    </div>
                                </div>
                            </div>
                            <div class="form-row" style="margin-top:12px;">
                                <div class="form-group col">
                                    <label class="required">Plazo amortizacion <span class="text-warning">*</span></label>
                                    <div style="display:flex; align-items:center; gap:12px;">
                                        {{ form_widget(formulario_precio.plazoAmortizacion, {'attr': {'class':'form-control plazo-range', 'oninput':'actualizarPlazoMaximo(this)'}}) }}
                                        <div style="min-width:40px; text-align:right; font-weight:600;"> <span id="plazoSelected">{{ formulario_precio.plazoAmortizacion.vars.value|default(25) }}</span></div>
                                    </div>
                                    <div id="plazoError" class="invalid-feedback d-block" style="display:none; color:#dc3545; margin-top:6px;"></div>
                                </div>
                            </div>
                            <div style="margin-top:8px;">
                                <p style="font-size:14px; color:#666; margin:6px 0 0;">Plazo seleccionado: <span id="plazoSelectedText">{{ formulario_precio.plazoAmortizacion.vars.value|default(25) }} años</span></p>
                            </div>
                            <div class="form-row" style="margin-top:12px;">
                                <div class="form-group col">
                                    {{ form_row(formulario_precio.aportacionInicial) }}
                                </div>
                            </div>
                            <div class="form-row" style="margin-top:12px;">
                                <div class="form-group col">
                                    {{ form_row(formulario_precio.destinoCompra) }}
                                </div>
                            </div>
                            <div class="form-row" style="margin-top:12px;">
                                <div class="form-group col">
                                    {{ form_row(formulario_precio.obraNueva) }}
                                </div>
                            </div>
                            <div class="form-row" style="margin-top:12px;">
                                <div class="form-group col">
                                    {{ form_row(formulario_precio.comunidadAutonoma) }}
                                </div>
                            </div>
                            <div class="form-row" style="margin-top:12px;">
                                <div class="form-group col">
                                    {{ form_row(formulario_precio.minusvaliaFamiliaNumerosa) }}
                                </div>
                            </div>
                            <div class="form-row" style="margin-top:12px;">
                                <div class="form-group col">
                                    {{ form_row(formulario_precio.familiaNumerosa) }}
                                </div>
                            </div>
                            <div class="form-row" style="margin-top:12px;">
                                <div class="form-group col">
                                    {{ form_row(formulario_precio.monoparental) }}
                                </div>
                            </div>
                            <div class="form-row" style="margin-top:12px;">
                                <div class="form-group col">
                                    {{ form_row(formulario_precio.vpo) }}
                                </div>
                            </div>
                            <div class="form-row" style="margin-top:12px;">
                                <div class="form-group col">
                                    {{ form_row(formulario_precio.ingresosMensuales) }}
                                </div>
                            </div>
                            <div class="form-row" style="margin-top:12px;">
                                <div class="form-group col">
                                    {{ form_row(formulario_precio.numPagasExtra) }}
                                </div>
                            </div>
                            <div class="form-row" style="margin-top:12px;">
                                <div class="form-group col">
                                    {{ form_row(formulario_precio.importePagaExtra) }}
                                </div>
                            </div>
                            <div class="form-row" style="margin-top:12px;">
                                <div class="form-group col">
                                    {{ form_row(formulario_precio.prestamosMensuales) }}
                                </div>
                            </div>
                            <div id="titularDosEconomicoSection" style="display:none; margin-top:10px; border-top: 0; padding-top: 12px;">
                                <div class="form-row" style="margin-top:12px;">
                                    <div class="form-group col">
                                        {{ form_row(formulario_precio.ingresosMensualesDos) }}
                                    </div>
                                </div>
                                <div class="form-row" style="margin-top:12px;">
                                    <div class="form-group col">
                                        {{ form_row(formulario_precio.numPagasExtraDos) }}
                                    </div>
                                </div>
                                <div class="form-row" style="margin-top:12px;">
                                    <div class="form-group col">
                                        {{ form_row(formulario_precio.importePagaExtraDos) }}
                                    </div>
                                </div>
                                <div class="form-row" style="margin-top:12px;">
                                    <div class="form-group col">
                                        {{ form_row(formulario_precio.prestamosMensualesDos) }}
                                    </div>
                                </div>
                            </div>

                            <!-- Botón de cálculo -->
                            <button type="button" class="btn btn-warning btn-sm w-100 mb-3" id="btnCalcularPrecioMaximo" onclick="calcularPrecioMaximo()" style="background: linear-gradient(135deg, #ff7722, #ff9944); border: none; color: white; font-weight: 600;">
                                <i class="fa fa-calculator mr-2"></i> Calcular Precio Máximo
                            </button>

                            <!-- Resultado del cálculo -->
                            <div id="resultadoPrecioMaximo" style="background: #e8f4f8; border: 2px solid #0088cc; border-radius: 8px; padding: 15px; margin-bottom: 20px; display: none;">
                                <div style="font-size: 12px; color: #666; text-transform: uppercase; margin-bottom: 8px;">Precio máximo recomendado</div>
                                <div style="font-size: 28px; font-weight: 700; color: #0088cc;" id="precioMaximoValor">0 €</div>
                                <p style="font-size: 12px; color: #666; margin-top: 10px; margin-bottom: 0;">
                                    Este es el precio máximo de vivienda que puedes adquirir según los datos introducidos.
                                </p>
                            </div>

                            <!-- Pregunta de coherencia -->
                            <div id="seccionCoherencia" style="display: none; background: #fff9e6; border: 1px solid #ffc107; border-radius: 8px; padding: 15px; margin-bottom: 20px;">
                                <h6 style="font-size: 13px; font-weight: 600; color: #333; margin-bottom: 15px;">Validación de coherencia</h6>

                                <label style="font-size: 13px; color: #333; margin-bottom: 15px; display: block;">
                                    ¿La vivienda que desea comprar está dentro del precio máximo calculado? *
                                </label>

                                <div style="display: flex; gap: 10px; margin-bottom: 15px;">
                                    <button type="button" class="btn btn-success btn-sm" onclick="validarCoherenciaSi()" id="btnCoherenciaSi">
                                        <i class="fa fa-check mr-2"></i> Sí
                                    </button>
                                    <button type="button" class="btn btn-danger btn-sm" onclick="validarCoherenciaNo()" id="btnCoherenciaNo">
                                        <i class="fa fa-times mr-2"></i> No
                                    </button>
                                </div>

                                <div id="mensajeCoherencia" style="display: none; padding: 12px; border-radius: 6px; font-size: 13px; margin-bottom: 15px;"></div>
                            </div>
                    </div>

                    <!-- PASO 3: Cuota y Gastos -->
                    <div id="paso3Section" class="paso-section d-none">
                        <div class="paso-title">Paso 3: Calcula la Cuota de tu Hipoteca</div>
                        <h6 style="font-size: 13px; color: #666; margin-bottom: 20px;">Rellena la siguiente información</h6>
                        
                        <!-- PANEL 1: RESUMEN DATOS PASO 2 (readonly) -->
                        <div style="background: #f8f9fa; border-left: 4px solid #0088cc; border-radius: 8px; padding: 15px; margin-bottom: 25px;">
                            <h6 style="font-size: 12px; font-weight: 600; color: #333; margin-bottom: 12px; text-transform: uppercase;">📊 Resumen: Paso 2 Precio Máximo</h6>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                                <div>
                                    <div style="font-size: 11px; color: #666; text-transform: uppercase; margin-bottom: 5px;">Precio Máximo Recomendado</div>
                                    <div style="font-size: 18px; font-weight: 700; color: #0088cc;" id="resumenPrecioMaximo">0 €</div>
                                </div>
                                <div>
                                    <div style="font-size: 11px; color: #666; text-transform: uppercase; margin-bottom: 5px;">Aportación Inicial</div>
                                    <div style="font-size: 18px; font-weight: 700; color: #333;" id="resumenAportacion">0 €</div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- EDAD -->
                        <div class="form-row" style="margin-top:12px;">
                            <div class="form-group col">
                                <label style="font-size: 12px; color: #666; text-transform: uppercase; font-weight: 600;">Edad del menor de los titulares</label>
                                <input type="number" name="simulador_p3[edadTitularUno]" class="form-control" min="18" max="65" placeholder="Ej: 35" required>
                            </div>
                        </div>
                        
                        <!-- VALOR DEL INMUEBLE -->
                        <div class="form-row" style="margin-top:12px;">
                            <div class="form-group col">
                                {{ form_row(formulario_cuota.valorInmueble) }}
                            </div>
                        </div>
                        
                        <!-- APORTACIÓN INICIAL -->
                        <div class="form-row" style="margin-top:12px;">
                            <div class="form-group col">
                                <label style="font-size: 12px; color: #666; text-transform: uppercase; font-weight: 600;">¿Qué cantidad de dinero aportas?</label>
                                <input type="number" name="simulador_p3[aportacionInicial]" class="form-control" step="1000" min="0" placeholder="Importe en €">
                            </div>
                        </div>
                        
                        <!-- DESTINO DE LA COMPRA -->
                        <div class="form-row" style="margin-top:12px;">
                            <div class="form-group col">
                                {{ form_row(formulario_cuota.destinoCompra) }}
                            </div>
                        </div>
                        
                        <!-- OBRA NUEVA -->
                        <div class="form-row" style="margin-top:12px;">
                            <div class="form-group col">
                                {{ form_row(formulario_cuota.obraNueva) }}
                            </div>
                        </div>
                        
                        <!-- COMUNIDAD AUTÓNOMA -->
                        <div class="form-row" style="margin-top:12px;">
                            <div class="form-group col">
                                {{ form_row(formulario_cuota.comunidadAutonoma) }}
                            </div>
                        </div>
                        
                        <!-- MINUSVALÍA -->
                        <div class="form-row" style="margin-top:12px;">
                            <div class="form-group col">
                                {{ form_row(formulario_cuota.minusvaliaFamiliaNumerosa) }}
                            </div>
                        </div>
                        
                        <!-- FAMILIA NUMEROSA -->
                        <div class="form-row" style="margin-top:12px;">
                            <div class="form-group col">
                                {{ form_row(formulario_cuota.familiaNumerosa) }}
                            </div>
                        </div>
                        
                        <!-- MONOPARENTAL -->
                        <div class="form-row" style="margin-top:12px;">
                            <div class="form-group col">
                                {{ form_row(formulario_cuota.monoparental) }}
                            </div>
                        </div>
                        
                        <!-- VPO -->
                        <div class="form-row" style="margin-top:12px;">
                            <div class="form-group col">
                                {{ form_row(formulario_cuota.vpo) }}
                            </div>
                        </div>
                        
                        <!-- PLAZO AMORTIZACIÓN 
                        <div class="form-row" style="margin-top:12px;">
                            <div class="form-group col">
                                {{ form_row(formulario_cuota.plazoAmortizacion) }}
                            </div>
                        </div>-->
                        
                        <!-- HONORARIOS INMOBILIARIA -->
                        <div class="form-row" style="margin-top:12px;">
                            <div class="form-group col">
                                {{ form_row(formulario_cuota.honorariosInmobiliaria) }}
                            </div>
                        </div>
                        
                        <!-- PRODUCTO -->
                        <div class="form-row" style="margin-top:12px;">
                            <div class="form-group col">
                                {{ form_row(formulario_cuota.producto) }}
                            </div>
                        </div>
                        
                        <!-- CAMPOS ADICIONALES PARA "CAMBIO DE CASA" -->
                        <div id="camposCambioCasa" style="display: none;">
                            <div class="form-row" style="margin-top:12px;">
                                <div class="form-group col">
                                    <label style="font-size: 12px; color: #666; text-transform: uppercase; font-weight: 600;">Valor de tu vivienda actual <span class="text-danger">*</span></label>
                                    <input type="number" name="simulador_p3[valorViviendaActual]" class="form-control" step="1000" min="0" placeholder="Importe en €">
                                </div>
                            </div>
                            
                            <div class="form-row" style="margin-top:12px;">
                                <div class="form-group col">
                                    <label style="font-size: 12px; color: #666; text-transform: uppercase; font-weight: 600;">Hipoteca pendiente actual <span class="text-danger">*</span></label>
                                    <input type="number" name="simulador_p3[hipotecaActual]" class="form-control" step="1000" min="0" placeholder="Importe en €">
                                </div>
                            </div>
                            
                            <div class="form-row" style="margin-top:12px;">
                                <div class="form-group col">
                                    <label style="font-size: 12px; color: #666; text-transform: uppercase; font-weight: 600;">Aportación tras la venta <span class="text-danger">*</span></label>
                                    <input type="number" name="simulador_p3[aportacionTrasVenta]" class="form-control" step="1000" min="0" placeholder="Importe en €">
                                </div>
                            </div>
                        </div>
                        
                        <!-- BOTÓN DE CÁLCULO -->
                        <button type="button" class="btn btn-warning btn-sm w-100 mb-3" id="btnCalcularCuotaGastos" onclick="calcularCuotaYGastos()" style="border: none;color: white;font-weight: 600;margin-top: 25px;display: block;padding: 18px;font-size: 20px;border-radius: 40px;box-shadow: rgb(188, 188, 188) 2px 1px 7px 2px; background-color: #ff7722;">
                            <i class="fa fa-calculator mr-2"></i> Calcular
                        </button>
                        
                        <!-- PANEL 6: RESULTADO DEL CÁLCULO - NUEVO FORMATO -->
                        <div id="resultadoCuotaGastos" style="display: none; background: white; border-radius: 8px; padding: 20px; margin-top: 20px;">
                            <style>
                                .result { margin-top: 20px; }
                                .result h2 { font-size: 1.1em; margin-bottom: 40px; }
                                .result h1 { font-size: 2.5em; margin: 20px 0; color: #ff7722; }
                                .costs { margin-top: 40px; }
                                .costs h2 { font-size: 1.3em; color: #ff7722; margin-bottom: 20px; }
                                .costs .row { display: flex; justify-content: flex-start; margin: 10px 0; border-bottom: 1px dashed #ccc; padding-bottom: 10px; }
                                .costs .column { display: flex; align-items: center; width: 50%; }
                                .costs .icon { margin-right: 10px; }
                                .costs .label { font-weight: bold; font-size: 14px; color: #666; }
                                .costs .value { margin-left: auto; font-weight: 600; font-size: 14px; }
                                .costs .column-right { display: flex; align-items: center; width: 50%; flex-direction: row-reverse; }
                                .icono-imagen { height: 30px; width: 30px; object-fit: cover; margin-right: 8px; }
                                .total { color: #333; font-weight: 800; }
                                .costs2 { padding: 15px; margin-top: 20px; }
                                .cost3 { margin-top: 20px; }
                                .fondo_casa {background-image: url(/assets/images/fondo-casa.png);background-repeat: no-repeat;background-size: 250px;background-position-x: center;height: 225px;line-height: 250px;font-size: 25px;margin-bottom: 0px !important;}
                            </style>

                            <div class="result">
                                <div class="mb-4">
                                    <p id="resultTextoPrecio" style="color:grey;font-size:13px;">Con la información que nos has proporcionado, hemos aplicado un algoritmo que estima tu capacidad de pago considerando los gastos y tu aportación inicial. El precio máximo de vivienda que te recomendamos buscar sería:</p>
                                </div>
                                <h1 class="text-center mb-4 fondo_casa"><span id="resultPrecioMaximo" style="font-size: 25px;color: black;font-weight: 500;">0 €</span></h1>
                            </div>

                            <div class="costs">
                                <h2 style="text-align: center;">Gastos asociados a la compraventa</h2>
                                <p style="color:grey;font-size:13px;">Los datos estimados que hemos considerado para el cálculo son los siguientes:</p>
                                
                                <div class="row">
                                    <div class="column">
                                        <span class="label">Impuestos (ITP/IVA/AJD):</span>
                                        <span class="value" id="resultImpuestos">0 €</span>
                                    </div>
                                    <div class="column">
                                        <span class="label">Notaría:</span>
                                        <span class="value" id="resultNotario">0 €</span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="column">
                                        <span class="label">Registro:</span>
                                        <span class="value" id="resultRegistro">0 €</span>
                                    </div>
                                    <div class="column">
                                        <span class="label">Gestoría:</span>
                                        <span class="value" id="resultGestoria">0 €</span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="column">
                                        <span class="label">Tasación:</span>
                                        <span class="value" id="resultTasacion">0 €</span>
                                    </div>
                                    <div class="column">
                                        <span class="label">Otros:</span>
                                        <span class="value" id="resultOtros">0 €</span>
                                    </div>
                                </div>
                            </div>

                            <div class="costs costs2">
                                <h2 style="text-align: center;">Importe total de tu Hipoteca</h2>
                            </div>

                            <div class="costs cost3">
                                <div class="row">
                                    <div class="column">
                                        <span class="label">Precio vivienda:</span>
                                    </div>
                                    <div class="column" style="justify-content: flex-end;">
                                        <span class="value" id="resultPrecioVivienda2">0 €</span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="column">
                                        <span class="label">Gastos totales:</span>
                                    </div>
                                    <div class="column" style="justify-content: flex-end;">
                                        <span class="value">+ <span id="resultGastosTotales2">0 €</span></span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="column">
                                        <span class="label">Aportación:</span>
                                    </div>
                                    <div class="column" style="justify-content: flex-end;">
                                        <span class="value">- <span id="resultAportacion2">0 €</span></span>
                                    </div>
                                </div>

                                <div class="row" style="border-bottom: 2px solid #ff7722; padding-bottom: 15px; margin-bottom: 15px;">
                                    <div class="column">
                                        <span class="label total">Importe hipoteca:</span>
                                    </div>
                                    <div class="column" style="justify-content: flex-end;">
                                        <span class="value total" id="resultImportePrestamo2">0 €</span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="column">
                                        <span class="label">Plazo:</span>
                                    </div>
                                    <div class="column" style="justify-content: flex-end;">
                                        <span class="value" id="resultPlazo">0 años</span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="column">
                                        <span class="label">Cuota mensual (tipo fijo):</span>
                                    </div>
                                    <div class="column" style="justify-content: flex-end;">
                                        <span class="value" id="resultCuotaMensual2">0 €</span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="column">
                                        <span class="label">Tipo de interés:</span>
                                    </div>
                                    <div class="column" style="justify-content: flex-end;">
                                        <span class="value" id="resultTipoInteres2">0%</span>
                                    </div>
                                </div>
                            </div>

                            <p style="color:grey;font-size:12px; margin-top:20px;">Este cálculo es orientativo y se basa en valores estandarizados; no garantiza la viabilidad económica del préstamo ni las condiciones definitivas.</p>
                        </div>
                    </div>

                    <!-- PASO 4: Riesgo -->
                    <div id="paso4Section" class="paso-section d-none">
                        <div class="paso-title">Paso 4: Análisis de Riesgo</div>
                        <h6 style="font-size: 13px; color: #666; margin-bottom: 20px;">Evaluación de tu perfil</h6>
                        
                        {% for child in formulario_riesgo %}
                            {% if child.vars.name != '_token' %}
                                {% if child.vars.name == 'tienePrestamosImpagados' %}
                                    <!-- RADIO BUTTONS: Sí/No -->
                                    <div class="form-row" style="margin-bottom: 20px;">
                                        <div class="form-group col">
                                            {{ form_label(child) }}
                                            <div style="display: flex; gap: 30px; margin-top: 10px;">
                                                {{ form_widget(child) }}
                                            </div>
                                            {{ form_errors(child) }}
                                        </div>
                                    </div>
                                {% elseif child.vars.name == 'situacionLaboralTitularDos' or child.vars.name == 'antiguedadLaboralTitularDos' %}
                                    <!-- CAMPOS TITULAR 2 (Mostrar solo si hay 2 titulares) -->
                                    <div class="form-row titularDosField" style="display: none;">
                                        <div class="form-group col">
                                            {{ form_label(child) }}
                                            {{ form_widget(child) }}
                                            {{ form_errors(child) }}
                                        </div>
                                    </div>
                                {% else %}
                                    <!-- CAMPOS TITULAR 1 (Siempre visible) -->
                                    <div class="form-row">
                                        <div class="form-group col">
                                            {{ form_label(child) }}
                                            {{ form_widget(child) }}
                                            {{ form_errors(child) }}
                                        </div>
                                    </div>
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                    </div>
                    
                    <script>
                    // Mostrar/Ocultar campos del Titular 2 según numTitulares
                    function actualizarPaso4SegunTitulares() {
                        const radioChecked = document.querySelector('input[name*="numTitulares"]:checked');
                        const numTitulares = radioChecked ? parseInt(radioChecked.value) : 1;
                        const titularDosFields = document.querySelectorAll('.titularDosField');
                        
                        titularDosFields.forEach(field => {
                            if (numTitulares === 2) {
                                field.style.display = 'block';
                            } else {
                                field.style.display = 'none';
                            }
                        });
                    }
                    
                    // Ejecutar cuando carga la página
                    document.addEventListener('DOMContentLoaded', function() {
                        actualizarPaso4SegunTitulares();
                        // Listener para cambios en numTitulares
                        const numTitularesInputs = document.querySelectorAll('input[name*="numTitulares"]');
                        numTitularesInputs.forEach(input => {
                            input.addEventListener('change', actualizarPaso4SegunTitulares);
                        });
                        
                        // Listener para cambios en el select de producto (Cambio de Casa)
                        const selectProducto = document.querySelector('select[name*="producto"]');
                        if (selectProducto) {
                            selectProducto.addEventListener('change', function() {
                                const camposCambioCasa = document.getElementById('camposCambioCasa');
                                if (this.value === '4') { // 4 = Cambio de Casa
                                    camposCambioCasa.style.display = 'block';
                                } else {
                                    camposCambioCasa.style.display = 'none';
                                }
                            });
                            
                            // Ejecutar al cargar para establecer estado inicial
                            if (selectProducto.value === '4') {
                                document.getElementById('camposCambioCasa').style.display = 'block';
                            }
                        }
                    });
                    </script>

                    <!-- Botones de navegación -->
                    <div class="d-flex gap-2 mt-4">
                        <button type="button" class="btn btn-success1 mr-auto waves-effect btn-volver flex-grow-12" id="btnAnterior" onclick="anterior()" style="display:none;">
                            ← Anterior
                        </button>
                        
                        <button type="button" class="btn btn-warning waves-effect" id="btnResultado" onclick="mostrarSemaforoViabilidad()" style="display:none;">
                            <i class="fa fa-check-circle mr-2"></i> Resultado
                        </button>
                        
                        <button type="button" class="btn btn-success waves-effect flex-grow-12" id="btnSiguiente" onclick="siguiente()">
                            Siguiente →
                        </button>
                    </div>

                    <!-- Botones finales -->
                    <div class="mt-3 d-none" id="botonesFinales">
                        <!--<button type="button" class="btn btn-success btn-sm w-100 mb-2" onclick="enviarAHipotea()">
                            <i class="fa fa-paper-plane"></i> Enviar a Hipotea
                        </button>
                        <button type="button" class="btn btn-info btn-sm w-100 mb-2" onclick="descargarPDF()">
                            <i class="fa fa-file-pdf"></i> Descargar PDF
                        </button>-->
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100" onclick="reiniciar()" id="btnReiniciar">
                            <i class="fa fa-redo"></i> Reiniciar
                        </button>
                    </div>
                </form>
            </div>

            <!-- PANEL DERECHO: RESULTADO -->
            <div class="resultado-panel" id="resultadoPanelDesk">
                <div id="resultadoContent">
                    <div class="text-center p-5">
                        <p style="color: #999; font-size: 14px;">Completa el formulario para ver el resultado</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal para descarga de PDF (mantener para mobile) -->
    <div class="modal fade" id="modalPDFPreview" tabindex="-1" role="dialog" aria-labelledby="modalPDFLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #ff7722, #ff9944); color: white;">
                    <h5 class="modal-title" id="modalPDFLabel" style="font-weight: 700; font-size: 18px;">
                        <i class="fas fa-file-pdf mr-2"></i>Informe de Viabilidad Hipotecaria
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body" id="pdfPreviewContent" style="max-height: 70vh; overflow-y: auto; background: #f5f5f5;">
                    <div class="text-center p-5">
                        <div class="spinner-border text-info" role="status">
                            <span class="sr-only">Cargando preview...</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="flex-wrap: wrap; gap: 8px; background: #f8f9fa;">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                        <i class="fas fa-times mr-2"></i>Cerrar
                    </button>
                    <button type="button" class="btn btn-primary" onclick="generarYDescargarPDF()" style="background: linear-gradient(135deg, #ff7722, #ff9944); border: none; font-weight: 600;">
                        <i class="fas fa-print mr-2"></i>Imprimir / Guardar PDF
                    </button>
                    <!--<button type="button" class="btn btn-success" onclick="enviarAHipoteaConInforme()">
                        <i class="fas fa-paper-plane mr-2"></i>Enviar a Hipotea para estudio completo
                    </button>-->
                </div>
            </div>
        </div>
    </div>

    {# ── Modal de avisos del simulador ── #}
    <div class="modal fade" id="modal-simulador-aviso" tabindex="-1" role="dialog" aria-labelledby="modal-simulador-aviso-titulo" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-simulador-aviso-titulo">Atención</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <p id="modal-simulador-aviso-msg"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success waves-effect" data-dismiss="modal">Continuar</button>
                </div>
            </div>
        </div>
    </div>

    {# ── Modal de confirmación del simulador ── #}
    <div class="modal fade" id="modal-simulador-confirm" tabindex="-1" role="dialog" aria-labelledby="modal-simulador-confirm-titulo" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-simulador-confirm-titulo">Confirmar</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <p id="modal-simulador-confirm-msg"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-success waves-effect" id="modal-simulador-confirm-ok">Confirmar</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
